include('scenario_helpers.lk')

class ScenarioCombos extends ScenarioHelpers {

    constructor(arsenal, player, target, fieldMap, strategy) {
        super(arsenal, player, target, fieldMap, strategy)
    }

    createAggressiveScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        // Reserve TP for follow-up attacks: never let buffs starve the kill
        // phase. Use the cheapest equipped weapon/chip cost as the floor so a
        // 4 TP minimum doesn't approve buffs when the real weapon costs 6+.
        var cheapestAtkCost = 4
        for (var wIdMin in mapKeys(this._arsenal.playerEquippedWeapons)) {
            var wObjMin = this._arsenal.playerEquippedWeapons[wIdMin]
            if (wObjMin != null && wObjMin._cost < cheapestAtkCost) cheapestAtkCost = wObjMin._cost
        }
        if (cheapestAtkCost < 3) cheapestAtkCost = 3
        var minAttackTP = max(cheapestAtkCost + 1, floor(availableTP * 0.5))

        var antidoteAction = this.getAntidoteAction(tpBudget)
        if (antidoteAction != null) {
            push(actions, antidoteAction)
            tpBudget -= getCachedChipCost(CHIP_ANTIDOTE)
        }

        var manumissionAction = this.getManumissionAction(tpBudget)
        if (manumissionAction != null) {
            push(actions, manumissionAction)
            tpBudget -= getCachedChipCost(CHIP_MANUMISSION)
            tpBudget += 2  // +2 TP buff effect
        }

        var buffAction = this.getOffensiveBuff()
        if (buffAction != null) {
            var buffCostA = getCachedChipCost(buffAction.chip)
            if (tpBudget - buffCostA >= minAttackTP) {
                push(actions, buffAction)
                tpBudget -= buffCostA
            }
        }

        var damageReturnAction = this.getDamageReturnBuff()
        if (damageReturnAction != null) {
            var drCost = getCachedChipCost(damageReturnAction.chip)
            if (tpBudget - drCost >= minAttackTP) {
                push(actions, damageReturnAction)
                tpBudget -= drCost
            }
        }

        var debuffAction = this.getDebuffAction()
        if (debuffAction != null && debuffAction.chip != -1) {
            var debuffCost = getCachedChipCost(debuffAction.chip)
            if (tpBudget - debuffCost >= minAttackTP) {
                push(actions, debuffAction)
                tpBudget -= debuffCost
            }
        }

        var moveAction = this.getMoveToOptimalCell(mpBudget)
        if (moveAction != null) {
            push(actions, moveAction)
            var moveCost = getGraphMPCost(moveAction.targetCell)
            if (moveCost < 999) {
                mpBudget -= moveCost
                simPos = moveAction.targetCell
            }
        }

        var denialActions = this.getDenialActions(tpBudget, simPos)
        for (var da in denialActions) {
            push(actions, da)
            tpBudget -= getCachedChipCost(da.chip)
        }

        var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        var hideAction = this.getHideAndSeekAction(mpBudget)
        if (hideAction != null) {
            push(actions, hideAction)
        }

        return actions
    }

    createConservativeScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        // Reserve TP for follow-up attacks (matches aggressive scenario pattern).
        var cheapestAtkCostC = 4
        for (var wIdMinC in mapKeys(this._arsenal.playerEquippedWeapons)) {
            var wObjMinC = this._arsenal.playerEquippedWeapons[wIdMinC]
            if (wObjMinC != null && wObjMinC._cost < cheapestAtkCostC) cheapestAtkCostC = wObjMinC._cost
        }
        if (cheapestAtkCostC < 3) cheapestAtkCostC = 3
        var minAttackTP = max(cheapestAtkCostC + 1, floor(availableTP * 0.5))

        var conservativeAntidote = this.getAntidoteAction(tpBudget)
        if (conservativeAntidote != null) {
            push(actions, conservativeAntidote)
            tpBudget -= getCachedChipCost(CHIP_ANTIDOTE)
        }

        var conservativeManumission = this.getManumissionAction(tpBudget)
        if (conservativeManumission != null) {
            push(actions, conservativeManumission)
            tpBudget -= getCachedChipCost(CHIP_MANUMISSION)
            tpBudget += 2
        }

        var buffAction = this.getOffensiveBuff()
        if (buffAction != null) {
            var buffCostC = getCachedChipCost(buffAction.chip)
            if (tpBudget - buffCostC >= minAttackTP) {
                push(actions, buffAction)
                tpBudget -= buffCostC
            }
        }

        var damageReturnAction = this.getDamageReturnBuff()
        if (damageReturnAction != null) {
            var drCostC = getCachedChipCost(damageReturnAction.chip)
            if (tpBudget - drCostC >= minAttackTP) {
                push(actions, damageReturnAction)
                tpBudget -= drCostC
            }
        }

        var defensiveBuff = this.getDefensiveBuff()
        if (defensiveBuff != null) {
            var defCostC = getCachedChipCost(defensiveBuff.chip)
            if (tpBudget - defCostC >= minAttackTP) {
                push(actions, defensiveBuff)
                tpBudget -= defCostC
            }
        }

        var healAction = this.getHealingAction(tpBudget, 0.7)
        if (healAction != null) {
            push(actions, healAction)
            tpBudget -= getCachedChipCost(healAction.chip)
        }

        var moveAction = this.getMoveToOptimalCell(floor(mpBudget * 0.7))
        if (moveAction != null) {
            push(actions, moveAction)
            var moveCost = getGraphMPCost(moveAction.targetCell)
            if (moveCost < 999) {
                mpBudget -= moveCost
                simPos = moveAction.targetCell
            }
        }

        var denialActionsC = this.getDenialActions(tpBudget, simPos)
        for (var da in denialActionsC) {
            push(actions, da)
            tpBudget -= getCachedChipCost(da.chip)
        }

        var attackActions = this.getAttackActions(tpBudget, 0.7, simPos)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        var hideAction = this.getHideAndSeekAction(mpBudget)
        if (hideAction != null) {
            push(actions, hideAction)
        }

        return actions
    }

    createDefensiveScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        var defensiveAntidote = this.getAntidoteAction(tpBudget)
        if (defensiveAntidote != null) {
            push(actions, defensiveAntidote)
            tpBudget -= getCachedChipCost(CHIP_ANTIDOTE)
        }

        var defensiveManumission = this.getManumissionAction(tpBudget)
        if (defensiveManumission != null) {
            push(actions, defensiveManumission)
            tpBudget -= getCachedChipCost(CHIP_MANUMISSION)
            tpBudget += 2
        }

        var healAction = this.getHealingAction(tpBudget, 0.7)
        if (healAction != null) {
            push(actions, healAction)
            tpBudget -= getCachedChipCost(healAction.chip)
        }

        var defensiveBuff = this.getDefensiveBuff()
        if (defensiveBuff != null && tpBudget >= getCachedChipCost(defensiveBuff.chip)) {
            push(actions, defensiveBuff)
            tpBudget -= getCachedChipCost(defensiveBuff.chip)
        }

        var moveAction = this.getMoveToOptimalCell(floor(mpBudget * 0.5))
        if (moveAction != null) {
            push(actions, moveAction)
            var moveCost = getGraphMPCost(moveAction.targetCell)
            if (moveCost < 999) {
                mpBudget -= moveCost
                simPos = moveAction.targetCell
            }
        }

        var attackActions = this.getAttackActions(tpBudget, 0.5, simPos)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        var hideAction = this.getHideAndSeekAction(mpBudget)
        if (hideAction != null) {
            push(actions, hideAction)
        }

        return actions
    }

    createAllInDamageScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        if (this.checkOTKOOpportunity()) {

            var distToTarget = getCellDistance(this._player._cellPos, this._target._cellPos)
            var maxWeaponRange = 12
            var soTeleChip = getAvailableTeleportChip(this._arsenal, this._player._id)

            if (distToTarget > maxWeaponRange && soTeleChip != null) {
                var tpTeleportOTKO = getCachedChipCost(soTeleChip)
                if (tpBudget >= tpTeleportOTKO) {
                    var bestCell = this._fieldMap.getBestWeaponOrChipCell()
                    if (bestCell != null && bestCell != -1) {
                        var teleportDist = getCellDistance(this._player._cellPos, bestCell._id)
                        var maxTeleRange = getTeleportMaxRange(soTeleChip)
                        if (teleportDist >= 1 && teleportDist <= maxTeleRange) {
                            push(actions, new Action(Action.ACTION_TELEPORT, -1, soTeleChip, bestCell._id, this._target))
                            tpBudget -= tpTeleportOTKO
                            simPos = bestCell._id
                        }
                    }
                }
            }

            var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
            for (var atk in attackActions) {
                push(actions, atk)
            }

            return actions
        }

        var moveAction = this.getMoveToOptimalCell(mpBudget)
        if (moveAction != null) {
            push(actions, moveAction)
            var moveCost = getGraphMPCost(moveAction.targetCell)
            if (moveCost < 999) {
                mpBudget -= moveCost
                simPos = moveAction.targetCell
            }
        }

        var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        return actions
    }

    createKitingScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        var attackActions = this.getAttackActions(tpBudget, 0.6, simPos)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        var kiteAction = this.getKiteAwayAction(mpBudget)
        if (kiteAction != null) {
            push(actions, kiteAction)
        }

        return actions
    }

    createEfficientScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        if (tpBudget >= 30) {
            var buffAction = this.getOffensiveBuff()
            if (buffAction != null && getCachedChipCost(buffAction.chip) <= 6) {
                push(actions, buffAction)
                tpBudget -= getCachedChipCost(buffAction.chip)
            }
        }

        var moveAction = this.getMoveToOptimalCell(mpBudget)
        if (moveAction != null) {
            push(actions, moveAction)
            var moveCost = getGraphMPCost(moveAction.targetCell)
            if (moveCost < 999) {
                mpBudget -= moveCost
                simPos = moveAction.targetCell
            }
        }

        var attackActions = this.getAttackActions(tpBudget, 0.8, simPos)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        var hideAction = this.getHideAndSeekAction(mpBudget)
        if (hideAction != null) {
            push(actions, hideAction)
        }

        return actions
    }

    createOTKOTeleportScenario(otkoCell, availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var otkoTeleChip = getAvailableTeleportChip(this._arsenal, this._player._id)
        if (otkoTeleChip == null) otkoTeleChip = CHIP_TELEPORTATION
        var tpTeleportOTKO = getCachedChipCost(otkoTeleChip)

        if (tpBudget >= tpTeleportOTKO) {
            push(actions, new Action(Action.ACTION_TELEPORT, -1, otkoTeleChip, otkoCell, this._target))
            tpBudget -= tpTeleportOTKO
        }

        var attackActions = this.getAttackActions(tpBudget, 1.0, otkoCell)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        return actions
    }

    createTeleportEscapeScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var escapeTeleChip = getAvailableTeleportChip(this._arsenal, this._player._id)
        if (escapeTeleChip == null) return null
        var tpTeleportEscape = getCachedChipCost(escapeTeleChip)
        var escapeMaxRange = getTeleportMaxRange(escapeTeleChip)

        if (tpBudget < tpTeleportEscape) {
            return null
        }

        var safestCell = -1
        var bestScore = -99999
        var playerPos = this._player._cellPos
        var enemyPos = this._target._cellPos
        var currentDistFromEnemy = getCellDistance(playerPos, enemyPos)

        var reachableCells = getReachableCells()
        for (var cellId in reachableCells) {
            var dist = getCellDistance(playerPos, cellId)
            if (dist >= 1 && dist <= escapeMaxRange) {
                var threat = this._fieldMap.getThreatAtCell(cellId)
                var distFromEnemy = getCellDistance(cellId, enemyPos)

                if (distFromEnemy <= currentDistFromEnemy) {
                    continue
                }

                var score = distFromEnemy * 100 - threat

                if (score > bestScore) {
                    bestScore = score
                    safestCell = cellId
                }
            }
        }

        if (safestCell == -1) {
            return null
        }

        push(actions, new Action(Action.ACTION_TELEPORT, -1, escapeTeleChip, safestCell, this._target))
        tpBudget -= tpTeleportEscape

        var escapeAntidote = this.getAntidoteAction(tpBudget)
        if (escapeAntidote != null) {
            push(actions, escapeAntidote)
            tpBudget -= getCachedChipCost(CHIP_ANTIDOTE)
        }

        var tpRemissionEscape = getCachedChipCost(CHIP_REMISSION)
        if (tpBudget >= tpRemissionEscape && mapContainsKey(this._arsenal.playerEquippedChips, CHIP_REMISSION) &&
            getCooldown(CHIP_REMISSION, this._player._id) == 0) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_REMISSION, -1, this._player))
            tpBudget -= tpRemissionEscape
        }

        var shieldAction = this.getDefensiveBuff()
        if (shieldAction != null) {
            var shieldCost = getCachedChipCost(shieldAction.chip)
            if (tpBudget >= shieldCost) {
                push(actions, shieldAction)
                tpBudget -= shieldCost
            }
        }

        if (tpBudget >= 3) {
            var distAfterTeleport = getCellDistance(safestCell, this._target._cellPos)
            var poisonChips = [CHIP_VENOM, CHIP_TOXIN, CHIP_PLAGUE, CHIP_ARSENIC, CHIP_COVID]
            for (var pChip in poisonChips) {
                if (tpBudget < 3) break
                if (!mapContainsKey(this._arsenal.playerEquippedChips, pChip)) continue
                if (getCooldown(pChip, this._player._id) > 0) continue
                var chip = this._arsenal.playerEquippedChips[pChip]
                var chipCost = getCachedChipCost(pChip)
                if (tpBudget < chipCost) continue
                if (distAfterTeleport < chip._minRange || distAfterTeleport > chip._maxRange) continue
                push(actions, new Action(Action.ACTION_DIRECT, -1, pChip, this._target._cellPos, this._target))
                tpBudget -= chipCost
            }

            var attackActions = this.getAttackActions(tpBudget, 1.0, safestCell)
            for (var atk in attackActions) {
                push(actions, atk)
            }
        }

        return actions
    }

    createEmergencyApproachScenario(availableTP, availableMP) {
        // Teleport-to-attack when enemy is out of MP range and we'd otherwise
        // do zero damage this turn. Previously scoped to turn <= 5 and to
        // damageMap cells only (which were all MP-reachable — so teleport
        // never actually reached beyond walking distance). Rewritten to scan
        // all cells within teleport range, filter by weapon-range-to-target +
        // LoS, and pick the cell with highest expected damage.

        // Suppress vs magic-poison kiters ONLY during the early commitment
        // window (turns 1-5). Original gate also blocked HP >= 60% for the
        // entire fight to keep BAIT_ANCHOR primary, but the cost was: when
        // BAIT_ANCHOR returned NO_SHOT (no viable anchor cell can fire),
        // no offensive template emitted at all and the scorer fell back to
        // pure-buff scenarios. koe2 fight 52574192 T4-T7 reproduced this:
        // 4 turns of buff-only while poison drained 100+ HP/turn.
        //
        // Past T5, let Emergency Approach emit and let the natural
        // `bestDamage <= 0` cutoff at line 551 below filter out cells with
        // no viable shot. The scorer compares both templates and picks the
        // better one — BAIT_ANCHOR still wins when its anchor is a real
        // shooter, but Emergency Approach is at least *there* as a damage
        // option when BAIT_ANCHOR cannot fire.
        // Original gate was turn <= 5 to "let BAIT_ANCHOR play primary" vs
        // poison kiters. But when BAIT_ANCHOR returns NO_SHOT and Emergency
        // Approach is suppressed too, NO offensive template fires and the
        // bot wastes its TP on buffs (LeekRain T3 d15: 14 TP burned with
        // FLR_CD_SAT). Tighten to turn <= 2 only — past T2 we're committed
        // to closing distance regardless of profile.
        if (this._target != null && getTurn() <= 2) {
            var emaProfile = getEnemyProfile(this._target._id)
            if (emaProfile != null
                && emaProfile['kiterFlavor'] == 'magic_poison'
                && this._player._maxHealth > 0
                && this._player._currHealth * 100 / this._player._maxHealth >= 60) {
                return null
            }
        }

        var approachTeleChip = getAvailableTeleportChip(this._arsenal, this._player._id)
        if (approachTeleChip == null) return null
        var tpTeleportApproach = getCachedChipCost(approachTeleChip)
        var approachMaxRange = getTeleportMaxRange(approachTeleChip)

        if (availableTP < tpTeleportApproach + 4) {
            return null
        }

        var playerPos = this._player._cellPos
        var targetPos = this._target._cellPos

        var distNow = getCellDistance(playerPos, targetPos)
        if (distNow == null) return null

        // Find widest weapon range to know whether current position can shoot
        var maxWeaponRange = 0
        for (var wIdRng in mapKeys(this._arsenal.playerEquippedWeapons)) {
            var wObjRng = this._arsenal.playerEquippedWeapons[wIdRng]
            if (wObjRng != null && wObjRng._maxRange > maxWeaponRange) maxWeaponRange = wObjRng._maxRange
        }
        if (maxWeaponRange == 0) return null

        // Only run when current position can't FIRE any weapon at the enemy.
        // Previously this gated on `distNow <= maxWeaponRange && LoS`, but
        // "in range" doesn't mean "can fire" — LINE/DIAGONAL/STAR weapons
        // still need launch-type axis alignment. Observed at koe2 fight
        // 52574382 T5-T7: LeekRain stuck at c=291 with d=9 vs target c=450
        // (within Magnum range 10) but no LINE weapon's launch geometry
        // matched, ROCKFALL was out of range (max 7), so no offensive
        // scenario emitted and the bot sat buffing for 3 turns while MP-burn
        // kept it pinned. New gate: only return null if at least one weapon
        // would actually fire from playerPos (range + LoS + launch geometry).
        var canFireFromHere = false
        for (var wIdFire in mapKeys(this._arsenal.playerEquippedWeapons)) {
            var wObjFire = this._arsenal.playerEquippedWeapons[wIdFire]
            if (wObjFire == null) continue
            if (distNow < wObjFire._minRange || distNow > wObjFire._maxRange) continue
            if (!getCachedLineOfSight(playerPos, targetPos)) continue
            if (wObjFire._launchType != null && wObjFire._launchType > 0 &&
                !isSimLaunchValid(wObjFire._launchType, playerPos, targetPos)) continue
            canFireFromHere = true
            break
        }
        if (canFireFromHere) return null

        var tpBudgetAfterTele = availableTP - tpTeleportApproach
        var bestCell = -1
        var bestDamage = 0

        for (var candidate = 0; candidate < 613; candidate++) {
            if (getOperations() > _ops86) break
            if (isObstacle(candidate)) continue
            if (isEntity(candidate)) continue

            var teleDist = getCellDistance(playerPos, candidate)
            if (teleDist == null || teleDist < 1 || teleDist > approachMaxRange) continue

            var distToTarget = getCellDistance(candidate, targetPos)
            if (distToTarget == null || distToTarget > maxWeaponRange) continue
            if (!getCachedLineOfSight(candidate, targetPos)) continue

            var cellDamage = 0
            for (var wid in mapKeys(this._arsenal.playerEquippedWeapons)) {
                var wObj = this._arsenal.playerEquippedWeapons[wid]
                if (wObj == null) continue
                if (distToTarget < wObj._minRange || distToTarget > wObj._maxRange) continue
                // Launch-type validation — mirror the gate fix above. Without
                // this, Emergency Approach could pick a tele cell where the
                // best weapon is "in range" but off-axis, and useWeapon would
                // return -4 at runtime (same class of failure as T10 w40).
                if (wObj._launchType != null && wObj._launchType > 0 &&
                    !isSimLaunchValid(wObj._launchType, candidate, targetPos)) continue
                var dmg = this._arsenal.getNetDamageAgainstTarget(
                    this._player._strength, this._player._magic,
                    this._player._wisdom, this._player._science,
                    wid, this._target)
                var swapCost = (getWeapon() != wid) ? 1 : 0
                var uses = min(wObj._maxUse, floor((tpBudgetAfterTele - swapCost) / wObj._cost))
                if (uses > 0) cellDamage += dmg * uses
            }

            if (cellDamage > bestDamage) {
                bestDamage = cellDamage
                bestCell = candidate
            }
        }

        if (bestCell == -1 || bestDamage <= 0) return null

        var actions = []
        push(actions, new Action(Action.ACTION_TELEPORT, -1, approachTeleChip, bestCell, this._target))

        var attackActions = this.getAttackActions(tpBudgetAfterTele, 1.0, bestCell)
        for (var aa in attackActions) {
            push(actions, aa)
        }

        return actions
    }

    // Part C: BAIT_ANCHOR — used vs kiters we cannot attack reach this turn.
    // Instead of walking blindly into their poison range (where they keep
    // backing off and the game loops 50+ turns), we move to a cell that:
    //   • breaks LoS to the enemy (cover) so their next-turn shots whiff, AND
    //   • forces them to step into OUR weapon arc if they want to fire back.
    // We then prebuff (shield or heal) to make sure the scenario clears the
    // override gate and ends with a CHECKPOINT(BAIT_ANCHOR) so the scorer
    // gives it enough weight to beat the no-op-fallback path.
    createBaitAnchorScenario(availableTP, availableMP) {
        // Entry marker so we can confirm dispatch reached this function at T3.
        if (getTurn() <= 20) debugW("BANCHOR_ENTRY_T" + getTurn())

        if (this._target == null) {
            if (getTurn() <= 20) debugW("BANCHOR_EXIT_T" + getTurn() + "_NO_TARGET")
            return null
        }
        if (_isBossFight && _bossPhase == "PUZZLE") {
            if (getTurn() <= 20) debugW("BANCHOR_EXIT_T" + getTurn() + "_BOSS_PUZZLE")
            return null
        }

        var enemyProfile = getEnemyProfile(this._target._id)
        if (enemyProfile == null) {
            if (getTurn() <= 20) debugW("BANCHOR_EXIT_T" + getTurn() + "_NO_PROFILE")
            return null
        }
        if (!enemyProfile['isKiter']) {
            if (getTurn() <= 20) debugW("BANCHOR_EXIT_T" + getTurn() + "_NOT_KITER_flavor" + enemyProfile['kiterFlavor'])
            return null
        }

        var playerPos = this._player._cellPos
        var targetPos = this._target._cellPos
        var distNow = getCellDistance(playerPos, targetPos)
        if (distNow == null) {
            if (getTurn() <= 20) debugW("BANCHOR_EXIT_T" + getTurn() + "_NULL_DIST")
            return null
        }

        // Bail in FLEE — at low HP, retreat scenarios already handle this.
        if (this._player._maxHealth > 0
            && this._player._currHealth * 100 / this._player._maxHealth < 35) {
            if (getTurn() <= 20) debugW("BANCHOR_EXIT_T" + getTurn() + "_LOW_HP")
            return null
        }

        // Find our weapon envelope (min/max range) for the "advance trap" term.
        var minWR = 99
        var maxWR = 0
        for (var wid in mapKeys(this._arsenal.playerEquippedWeapons)) {
            var w = this._arsenal.playerEquippedWeapons[wid]
            if (w == null) continue
            if (w._minRange < minWR) minWR = w._minRange
            if (w._maxRange > maxWR) maxWR = w._maxRange
        }
        if (maxWR == 0) {
            if (getTurn() <= 20) debugW("BANCHOR_EXIT_T" + getTurn() + "_NO_WEAPON_RANGE")
            return null
        }

        // Note: we do NOT gate on "in weapon range from current cell" anymore.
        // The previous gate `distNow <= maxWR && LoS` was excluding T3 cases
        // where Magnum (max range 10) technically reached the enemy but our
        // primary weapon (range 7) didn't and no template produced a viable
        // shot. Let BAIT_ANCHOR always run; the scorer will favor a real
        // attack over the +6000 checkpoint bonus when one exists.

        // Enemy mobility — how far they can step toward us in one turn.
        var enemyMP = enemyProfile['mobilityMP']
        if (enemyMP == null || enemyMP <= 0) enemyMP = 3

        var bestCell = -1
        var bestScore = -999999
        var anchorScanned = 0
        var reach = getReachableCells()
        var reachCount = count(reach)

        // Engagement-band targets: we want anchor cells where
        //   distToEnemy in [maxWR, maxWR + enemyMP + 2]
        // i.e. enemy's 1-turn advance puts them inside our weapon envelope.
        // Cells closer let them shoot us; cells farther let them poison from
        // a distance we cannot reach. Compute the envelope upper bound.
        var bandLo = maxWR
        var bandHi = maxWR + enemyMP + 2
        // Don't allow retreat: anchor distance must not exceed current distance
        // by more than 1 (some sidestep into cover is fine; full backpedalling
        // is what the previous fight degenerated into).
        var retreatCap = distNow + 1

        for (var ri = 0; ri < reachCount; ri++) {
            // Budget scan over VALID candidates only — previously the 50-cell
            // cap exhausted on cells behind us that got rejected by retreatCap,
            // leaving no anchor at all (T3 c202 reproduced this).
            if (anchorScanned >= 80) break
            if (getOperations() > _ops79) break

            var cand = reach[ri]
            if (cand == playerPos) continue
            if (isObstacle(cand)) continue
            if (isEntity(cand) && cand != playerPos) continue

            var mpCost = getGraphMPCost(cand)
            if (mpCost >= 999 || mpCost > availableMP) continue

            var candDistToEnemy = getCellDistance(cand, targetPos)
            if (candDistToEnemy == null) continue

            // Hard gate: no further-than-now anchors. We bait, we don't flee.
            if (candDistToEnemy > retreatCap) continue

            anchorScanned++

            // (1) Shooter term — does this cell let US fire on the enemy right
            // now? Previous "cover" term (+400 if NO LoS) created a trap: we
            // kept hiding even when the kiter was already in our weapon arc,
            // never converting position into damage. Invert: reward cells with
            // LoS+range, so BAIT_ANCHOR doubles as a firing platform when the
            // bait has actually been taken.
            var shooterScore = 0
            if (candDistToEnemy >= minWR && candDistToEnemy <= maxWR
                && getCachedLineOfSight(cand, targetPos)) {
                shooterScore = 400
            }

            // (2) Advance-trap — for each cell the enemy can step to in their
            // next MP-radius advance, would that cell be inside OUR weapon arc
            // with LoS? Each match = enemy commits to a step that lets us fire.
            // Sample enemyMP ring around target (not just 1-ring) so a 4-MP
            // kiter who advances 2 cells is also accounted for.
            var advanceTrap = 0
            var enemyAdv = GLOBAL_NEIGHBORS[targetPos]
            if (enemyAdv != null) {
                var ringSamples = 0
                for (var advCell in enemyAdv) {
                    if (ringSamples >= 8) break
                    ringSamples++
                    if (isObstacle(advCell)) continue
                    var advDist = getCellDistance(advCell, cand)
                    if (advDist == null) continue
                    if (advDist < minWR || advDist > maxWR) continue
                    if (!getCachedLineOfSight(advCell, cand)) continue
                    advanceTrap += 120
                }
            }

            // (3) Threat term — penalise cells the enemy can pummel from now.
            var threatHere = this._fieldMap.getThreatAtCell(cand)
            if (threatHere == null) threatHere = 0

            // (4) Engagement-band term — reward cells inside the band, penalize
            //     cells outside. Replaces the old "distance bonus" that was
            //     causing infinite retreat (cells farther = always more bonus).
            // Exception: when target is already inside our weapon envelope, a
            // "too-close" penalty actively hurts — we get a viable Magnum shot
            // at dist 7 yet the band pushes us to retreat to dist 10. koe2
            // T7-T13 reproduced this: bot stalled in buff-only loops while a
            // dist-7 shooter cell existed but scored -50 (below 100 threshold).
            // Skip the too-close penalty entirely when the cell CAN already
            // fire (shooterScore > 0) — let the shooter+advance terms decide.
            var bandTerm = 0
            if (candDistToEnemy >= bandLo && candDistToEnemy <= bandHi) {
                bandTerm = 200
            } else if (candDistToEnemy < bandLo) {
                // Inside enemy poison reach without our weapons reaching back.
                // If we CAN fire from here, the cell is a shooter, not a bait
                // anchor — don't penalize it for being inside the band.
                if (shooterScore > 0) {
                    bandTerm = 0
                } else {
                    bandTerm = -150 * (bandLo - candDistToEnemy)
                }
            } else {
                // Beyond bait range — every cell of extra distance penalises.
                bandTerm = -80 * (candDistToEnemy - bandHi)
            }

            // (5) Closing bonus — prefer cells that get us CLOSER vs further.
            //     Direct counter to the previous retreat behavior.
            var closeBonus = (distNow - candDistToEnemy) * 30

            var score = shooterScore + advanceTrap + bandTerm + closeBonus - threatHere - mpCost * 5

            if (score > bestScore) {
                bestScore = score
                bestCell = cand
            }
        }

        // Require at least one of cover/trap to fire. Bare relocation is
        // not worth the override gate / scoring overhead. Threshold relaxed
        // 200 → 100 so positions where the best anchor has only a small
        // distance/trap edge still emit (T3 c272 / no obvious cover in MP
        // range was producing no anchor at 200).
        if (getTurn() <= 20) {
            debugW("BANCHOR_DIAG_T" + getTurn() + "_scanned" + anchorScanned + "_bc" + bestCell + "_bs" + bestScore + "_dn" + distNow + "_mr" + maxWR + "_em" + enemyMP + "_rc" + reachCount)
        }
        if (bestCell == -1) return null
        if (bestScore < 100) return null

        var actions = []
        var tpBudget = availableTP

        // Movement to anchor cell.
        push(actions, new Action(Action.MOVEMENT_DEFENSIVE, -1, -1, bestCell, this._target))

        // Antidote if heavily poisoned (kiter trademark) — frees the scenario
        // from being misvalued by stacked DoT.
        var antidoteAction = this.getAntidoteAction(tpBudget)
        if (antidoteAction != null) {
            push(actions, antidoteAction)
            tpBudget -= getCachedChipCost(CHIP_ANTIDOTE)
        }

        // Defensive chip — prefer Fortress > Wall > Helmet > Bark, only if
        // not already shielded.
        var hasShield = this._player.hasEffect(EFFECT_ABSOLUTE_SHIELD)
                        || this._player.hasEffect(EFFECT_RELATIVE_SHIELD)
        if (!hasShield) {
            var shieldCandidates = [CHIP_FORTRESS, CHIP_WALL, CHIP_HELMET, CHIP_BARK]
            for (var sChip in shieldCandidates) {
                if (!mapContainsKey(this._arsenal.playerEquippedChips, sChip)) continue
                if (getCooldown(sChip, this._player._id) > 0) continue
                var sCost = getCachedChipCost(sChip)
                if (tpBudget < sCost) continue
                push(actions, new Action(Action.ACTION_BUFF, -1, sChip, -1, this._player))
                tpBudget -= sCost
                break
            }
        }

        // If we have leftover TP and we're under HP pressure, top up with a
        // heal so the buff still scores as defensive even when shields are CD.
        var hpRatio = (this._player._maxHealth > 0)
                      ? (this._player._currHealth * 100 / this._player._maxHealth)
                      : 100
        if (hpRatio < 80) {
            var healCandidates = [CHIP_REMISSION, CHIP_CURE, CHIP_BANDAGE]
            for (var hChip in healCandidates) {
                if (!mapContainsKey(this._arsenal.playerEquippedChips, hChip)) continue
                if (getCooldown(hChip, this._player._id) > 0) continue
                var hCost = getCachedChipCost(hChip)
                if (tpBudget < hCost) continue
                push(actions, new Action(Action.ACTION_BUFF, -1, hChip, -1, this._player))
                tpBudget -= hCost
                break
            }
        }

        // BAIT_ANCHOR only emits when the anchor cell can actually fire — if
        // no shooter cell exists, this template silently sat at atk0 and
        // blocked TELEPORT-COMBO scenarios (which DO work on cover maps via
        // chip-based repositioning) from winning the scoring race.
        var bestDistToEnemy = getCellDistance(bestCell, targetPos)
        var attacksAppended = 0
        if (bestDistToEnemy != null
            && bestDistToEnemy >= minWR && bestDistToEnemy <= maxWR
            && getCachedLineOfSight(bestCell, targetPos)
            && tpBudget >= 4) {
            var anchorAttacks = this.getAttackActions(tpBudget, 1.0, bestCell)
            for (var atkAct in anchorAttacks) {
                push(actions, atkAct)
                attacksAppended++
            }
        }
        if (attacksAppended == 0) {
            if (getTurn() <= 20) {
                debugW("BANCHOR_SKIP_T" + getTurn() + "_c" + bestCell + "_sc" + bestScore + "_dn" + distNow + "_bd" + bestDistToEnemy + "_NO_SHOT")
            }
            return null
        }

        var checkpoint = new Action(Action.ACTION_CHECKPOINT, -1, -1, -1, null)
        checkpoint.checkpointType = "BAIT_ANCHOR"
        push(actions, checkpoint)

        if (getTurn() <= 20) {
            debugW("BANCHOR_T" + getTurn() + "_c" + bestCell + "_sc" + bestScore + "_mp" + getGraphMPCost(bestCell) + "_atk" + attacksAppended)
        }

        return actions
    }

    createParametricScenario(params, availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        var antidoteAction = this.getAntidoteAction(tpBudget)
        if (antidoteAction != null) {
            push(actions, antidoteAction)
            tpBudget -= getCachedChipCost(CHIP_ANTIDOTE)
        }

        var paramManumission = this.getManumissionAction(tpBudget)
        if (paramManumission != null) {
            push(actions, paramManumission)
            tpBudget -= getCachedChipCost(CHIP_MANUMISSION)
            tpBudget += 2
        }

        // Parametric scenario respects the same minAttackTP reservation.
        // OTKO/stand variants used by KILL state pass through buildKillScenarios
        // and the reservation is naturally relaxed (high TP, kill margin already verified).
        var minAttackTPp = max(4, floor(availableTP * 0.5))

        if (params.buffStrategy == 1 || params.buffStrategy == 3) {

            var offensiveBuff = this.getOffensiveBuff()
            if (offensiveBuff != null) {
                var offCostP = getCachedChipCost(offensiveBuff.chip)
                if (tpBudget - offCostP >= minAttackTPp) {
                    push(actions, offensiveBuff)
                    tpBudget -= offCostP
                }
            }
        }

        if (params.buffStrategy == 2 || params.buffStrategy == 3) {

            var defensiveBuff = this.getDefensiveBuff()
            if (defensiveBuff != null) {
                var defCostP = getCachedChipCost(defensiveBuff.chip)
                if (tpBudget - defCostP >= minAttackTPp) {
                    push(actions, defensiveBuff)
                    tpBudget -= defCostP
                }
            }
        }

        if (params.buffStrategy == 4) {

            var damageReturnBuff = this.getDamageReturnBuff()
            if (damageReturnBuff != null) {
                var drCostP = getCachedChipCost(damageReturnBuff.chip)
                if (tpBudget - drCostP >= minAttackTPp) {
                    push(actions, damageReturnBuff)
                    tpBudget -= drCostP
                }
            }

            var debuffAction = this.getDebuffAction()
            if (debuffAction != null && debuffAction.chip != -1) {
                var debuffCostParam = getCachedChipCost(debuffAction.chip)
                if (tpBudget - debuffCostParam >= minAttackTPp) {
                    push(actions, debuffAction)
                    tpBudget -= debuffCostParam
                }
            }
        }

        if (params.healThreshold >= 0) {

            if (params.healThreshold >= 0.99) {
                var currentHP = this._player._currHealth
                var maxHP = this._player._maxHealth
                var hpRatio = currentHP / maxHP

                if (hpRatio < params.healThreshold) {

                    var remissionAction = this.getRemissionAction()
                    if (remissionAction != null) {
                        var tpRemission = getCachedChipCost(CHIP_REMISSION)
                        // Phase I: gate by minAttackTPp so heals don't starve attacks
                        if (tpBudget - tpRemission >= minAttackTPp) {
                            push(actions, remissionAction)
                            tpBudget -= tpRemission
                        }
                    }

                    var regenAction = this.getRegenerationAction()
                    if (regenAction != null) {
                        var tpRegen = getCachedChipCost(CHIP_REGENERATION)
                        if (tpBudget - tpRegen >= minAttackTPp) {
                            push(actions, regenAction)
                            tpBudget -= tpRegen
                        }
                    }
                }
            } else {

                var healAction = this.getHealingAction(tpBudget, params.healThreshold)
                if (healAction != null) {
                    var healCost = getCachedChipCost(healAction.chip)
                    // Phase I: same gate
                    if (tpBudget - healCost >= minAttackTPp) {
                        push(actions, healAction)
                        tpBudget -= healCost
                    }
                }
            }
        }

        var appliedLeatherBoots = false
        var leatherBootsBuff = this.getLeatherBootsBuff()
        if (leatherBootsBuff != null) {
            var tpLeatherBoots = getCachedChipCost(CHIP_LEATHER_BOOTS)
            if (tpBudget >= tpLeatherBoots) {
                push(actions, leatherBootsBuff)
                tpBudget -= tpLeatherBoots
                mpBudget += 2
                appliedLeatherBoots = true
            }
        }

        // Motivation: +2 TP for 3 turns. Helper gates on shackle/opening only.
        // Adds tpBudget back this turn (+2) so the combo planner can still spend.
        var motivBuff = this.getMotivationBuff()
        if (motivBuff != null) {
            var tpMotiv = getCachedChipCost(CHIP_MOTIVATION)
            if (tpBudget >= tpMotiv) {
                push(actions, motivBuff)
                tpBudget -= tpMotiv
                tpBudget += 2
            }
        }

        // Adrenaline +5 TP is a combo enabler — try as long as it's available,
        // not gated on Leather Boots being applied first.
        var adrenalineBuff = this.getAdrenalineBuff()
        if (adrenalineBuff != null) {
            var tpAdrenaline = getCachedChipCost(CHIP_ADRENALINE)
            if (tpBudget >= tpAdrenaline) {
                push(actions, adrenalineBuff)
                tpBudget -= tpAdrenaline
                tpBudget += 5
            }
        }

        var didJump = false
        // AGI ≥ 300 gate removed: Jump is a mobility chip whose whole purpose is
        // closing distance for slow builds — the high-AGI gate was backwards and
        // killed Jump usage on STR bruisers (LeekRain etc.) facing kiters.
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_JUMP) &&
            getCooldown(CHIP_JUMP, this._player._id) == 0 &&
            tpBudget >= getCachedChipCost(CHIP_JUMP) &&
            !this._player.hasEffect(EFFECT_BUFF_AGILITY)) {
            var jumpCostP = getCachedChipCost(CHIP_JUMP)
            var jumpTarget = -1
            var targetPos = this._target._cellPos
            // Tiered ranking: A=REACH_HIT, B=HIDE (denied/low HP), C=APPROACH, D=ANY.
            // TP doesn't carry; if any reachable cell exists, commit. Pick best tier.
            var origDistP = getCellDistance(simPos, targetPos)
            if (origDistP == null) origDistP = 99
            var maxWRJP = 0
            for (var wIdJP in mapKeys(this._arsenal.playerEquippedWeapons)) {
                var wObjJP = this._arsenal.playerEquippedWeapons[wIdJP]
                if (wObjJP != null && wObjJP._maxRange > maxWRJP) maxWRJP = wObjJP._maxRange
            }
            var deniedJP = this._player.hasEffect(EFFECT_SHACKLE_TP)
                || this._player.hasEffect(EFFECT_SHACKLE_STRENGTH)
                || this._player.hasEffect(EFFECT_SHACKLE_MAGIC)
            var lowHPJP = (this._player._currHealth * 100 / max(1, this._player._maxHealth)) < 60
            // Tier 3 kite-gate: only worth closing if even after enemy uses
            // their full MP to retreat, we'd still be within weapon range.
            // Otherwise we burn 4 TP to get one turn of poison-soaking.
            var enemyMPJP = this._target._currMp
            if (enemyMPJP == null) enemyMPJP = 5
            var kiteHorizonJP = maxWRJP + enemyMPJP
            var bestTierP = 5
            var bestMetricP = 99999
            var simX = getCellX(simPos)
            var simY = getCellY(simPos)
            for (var jdx = -3; jdx <= 3; jdx++) {
                for (var jdy = -3; jdy <= 3; jdy++) {
                    if (jdx == 0 && jdy == 0) continue
                    if (abs(jdx) + abs(jdy) > 3) continue
                    var jCand = getCellFromXY(simX + jdx, simY + jdy)
                    if (jCand == null || jCand < 0) continue
                    if (isObstacle(jCand) || isEntity(jCand)) continue
                    var jDist = getCellDistance(simPos, jCand)
                    if (jDist == null || jDist < 1 || jDist > 3) continue
                    var d = getCellDistance(jCand, targetPos)
                    if (d == null) continue
                    var hasLosJP = lineOfSight(jCand, targetPos)
                    var tier = 4
                    var metric = d
                    if (hasLosJP && d >= 1 && d <= maxWRJP) {
                        tier = 1
                    } else if ((deniedJP || lowHPJP) && !hasLosJP) {
                        tier = 2
                        metric = abs(d - max(2, maxWRJP - 2))
                    } else if (origDistP - d >= 2 && d <= kiteHorizonJP) {
                        // Only APPROACH if jump puts us in next-turn weapon
                        // reach even if enemy MP-retreats. Otherwise it's a
                        // careless close into poison spam.
                        tier = 3
                        // Threat-aware metric: prefer cells with lower
                        // predicted incoming damage.
                        metric = d + getAdversarialThreat(jCand) / 100.0
                    }
                    if (tier < bestTierP || (tier == bestTierP && metric < bestMetricP)) {
                        bestTierP = tier
                        bestMetricP = metric
                        jumpTarget = jCand
                    }
                }
            }
            // Suppress Tier 4 (any) — without a real utility tier, JUMP at
            // long range just feeds us into enemy chip range.
            if (bestTierP > 3) jumpTarget = -1
            if (jumpTarget != -1) {
                push(actions, new Action(Action.ACTION_TELEPORT, -1, CHIP_JUMP, jumpTarget, this._target))
                tpBudget -= jumpCostP
                simPos = jumpTarget
                didJump = true
            }
        }

        var didTeleport = false
        if (!didJump && params.repositioning == "otko" && this.checkOTKOOpportunity()) {
            var distToTarget = getCellDistance(this._player._cellPos, this._target._cellPos)
            var maxWeaponRange = 12
            var repoTeleChip = getAvailableTeleportChip(this._arsenal, this._player._id)

            if (distToTarget > maxWeaponRange && repoTeleChip != null) {
                var tpTeleportRepo = getCachedChipCost(repoTeleChip)
                if (tpBudget >= tpTeleportRepo) {
                    var bestCell = this._fieldMap.getBestWeaponOrChipCell()
                    if (bestCell != null && bestCell != -1) {
                        var teleportDist = getCellDistance(this._player._cellPos, bestCell._id)
                        var repoMaxRange = getTeleportMaxRange(repoTeleChip)
                        if (teleportDist >= 1 && teleportDist <= repoMaxRange) {
                            push(actions, new Action(Action.ACTION_TELEPORT, -1, repoTeleChip, bestCell._id, this._target))
                            tpBudget -= tpTeleportRepo
                            simPos = bestCell._id
                            didTeleport = true
                        }
                    }
                }
            }
        }

        // Suppress getMoveToOptimalCell when a JUMP/TELEPORT already
        // repositioned simPos. The helper queries fieldMap caches that were
        // built from the player's ACTUAL pre-jump cell, so it can pick a
        // "best" cell that walks us back to where we just jumped from.
        // T8 bug: JUMP closed to fire range, then getMoveToOptimalCell
        // appended MOVEMENT_OFFENSIVE to the pre-jump optimal cell.
        if (params.movementFraction > 0 && !didTeleport && !didJump) {
            var mpToUse = floor(mpBudget * params.movementFraction)
            var moveAction = this.getMoveToOptimalCell(mpToUse)
            if (moveAction != null) {
                push(actions, moveAction)
                var moveCost = getGraphMPCost(moveAction.targetCell)
                if (moveCost < 999) {
                    mpBudget -= moveCost
                    simPos = moveAction.targetCell
                }
            }
        }

        // Phase I: Verify target is in weapon range; if so, reserve enough TP
        // for at least one weapon attack BEFORE applying denial chips. This
        // prevents the SUSTAIN/ATTRITION paralysis where chips eat all TP.
        var paramInRange = false
        for (var paramWid in mapKeys(this._arsenal.playerEquippedWeapons)) {
            var paramW = this._arsenal.playerEquippedWeapons[paramWid]
            var paramDist = getCellDistance(simPos, this._target._cellPos)
            if (paramDist != null && paramDist >= paramW._minRange && paramDist <= paramW._maxRange) {
                paramInRange = true
                break
            }
        }
        var paramReservedAttackTP = paramInRange ? 8 : 0

        var denialActionsP = this.getDenialActions(tpBudget, simPos)
        for (var da in denialActionsP) {
            var daCost = getCachedChipCost(da.chip)
            // Phase I: only apply denial if it doesn't starve the reserved attack
            if (tpBudget - daCost < paramReservedAttackTP) break
            push(actions, da)
            tpBudget -= daCost
        }

        if (tpBudget >= 4) {

            var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
            for (var atk in attackActions) {
                push(actions, atk)
            }
        }

        if (params.repositioning == "hide") {
            var hideAction = this.getHideAndSeekAction(mpBudget)
            if (hideAction != null) {
                push(actions, hideAction)
            }
        } else if (params.repositioning == "kite") {
            var kiteAction = this.getKiteAwayAction(mpBudget)
            if (kiteAction != null) {
                push(actions, kiteAction)
            }
        }

        return actions
    }

    createNeutrinoStackingScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        if (!mapContainsKey(this._arsenal.playerEquippedWeapons, WEAPON_NEUTRINO)) {
            return null
        }

        var dist = getCellDistance(simPos, this._target._cellPos)
        if (dist == null) return null

        var isDiagonal = this.isDiagonal(simPos, this._target._cellPos)
        if (!isDiagonal || dist < 2 || dist > 6) {
            return null
        }

        if (!getCachedLineOfSight(simPos, this._target._cellPos)) {
            return null
        }

        if (tpBudget < 16) {
            return null
        }

        var currentStacks = this._arsenal.getVulnerabilityStacks(this._target)
        var vulnRemaining = this._target.getEffectRemaining(EFFECT_VULNERABILITY)
        if (currentStacks >= 3 && vulnRemaining >= 2) {
            return null
        }

        if (getWeapon() != WEAPON_NEUTRINO) {
            push(actions, new Action(Action.ACTION_WEAPON_SWAP, -1, -1, -1, this._target))
            actions[count(actions) - 1].weapon = WEAPON_NEUTRINO
            tpBudget -= 1
        }

        for (var i = 0; i < 3; i++) {
            if (tpBudget >= 4) {
                push(actions, new Action(Action.ACTION_DIRECT, WEAPON_NEUTRINO, -1, this._target._cellPos, this._target))
                tpBudget -= 4
            }
        }

        var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        var hideAction = this.getHideAndSeekAction(mpBudget)
        if (hideAction != null) {
            push(actions, hideAction)
        }

        return actions
    }

    createGrappleHeavySwordScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        if (!mapContainsKey(this._arsenal.playerEquippedWeapons, WEAPON_HEAVY_SWORD)) {
            return null
        }
        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_GRAPPLE)) {
            return null
        }
        if (getCooldown(CHIP_GRAPPLE, this._player._id) > 0) {
            return null
        }

        var dist = getCellDistance(simPos, this._target._cellPos)
        if (dist == null) {
            return null
        }

        if (tpBudget < 10) {
            return null
        }

        var playerX = getCellX(simPos)
        var playerY = getCellY(simPos)
        var enemyPos = this._target._cellPos
        var enemyX = getCellX(enemyPos)
        var enemyY = getCellY(enemyPos)

        var isOnSameLine = (playerY == enemyY) || (playerX == enemyX)
        if (!isOnSameLine) {
            return null
        }

        var grappleCell = -1
        if (playerY == enemyY) {

            grappleCell = (enemyX < playerX) ? getCellFromXY(playerX - 1, playerY) : getCellFromXY(playerX + 1, playerY)
        } else {

            grappleCell = (enemyY < playerY) ? getCellFromXY(playerX, playerY - 1) : getCellFromXY(playerX, playerY + 1)
        }

        if (grappleCell == -1 || grappleCell == null) {
            return null
        }

        push(actions, new Action(Action.ACTION_DIRECT, -1, CHIP_GRAPPLE, grappleCell, this._target))
        tpBudget -= getCachedChipCost(CHIP_GRAPPLE)

        var enemyPulledPosition = grappleCell

        if (getWeapon() != WEAPON_HEAVY_SWORD) {
            push(actions, new Action(Action.ACTION_WEAPON_SWAP, WEAPON_HEAVY_SWORD, -1, -1, this._target))
            tpBudget -= 1
        }

        var heavySwordCost = getCachedWeaponCost(WEAPON_HEAVY_SWORD, this._arsenal)
        if (heavySwordCost == null) heavySwordCost = 15
        push(actions, new Action(Action.ACTION_DIRECT, WEAPON_HEAVY_SWORD, -1, enemyPulledPosition, this._target))
        tpBudget -= heavySwordCost

        if (tpBudget >= heavySwordCost) {
            push(actions, new Action(Action.ACTION_DIRECT, WEAPON_HEAVY_SWORD, -1, enemyPulledPosition, this._target))
            tpBudget -= heavySwordCost
        }

        var hideAction = this.getHideAndSeekAction(mpBudget)
        if (hideAction != null) {
            push(actions, hideAction)
        }

        return actions
    }

    // Mirror of createGrappleHeavySwordScenario but for Axe. Same template
    // shape: Grapple pulls the kiter adjacent on a line axis, then we dump
    // Axe×2 at melee. Used by close-range STR builds without Heavy Sword
    // (e.g. LeekRain post-loadout-swap vs koe2).
    createGrappleAxeScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        if (!mapContainsKey(this._arsenal.playerEquippedWeapons, WEAPON_AXE)) {
            return null
        }
        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_GRAPPLE)) {
            return null
        }
        if (getCooldown(CHIP_GRAPPLE, this._player._id) > 0) {
            return null
        }

        var dist = getCellDistance(simPos, this._target._cellPos)
        if (dist == null) {
            return null
        }

        var axeCost = getCachedWeaponCost(WEAPON_AXE, this._arsenal)
        if (axeCost == null) axeCost = 6
        var grappleCost = getCachedChipCost(CHIP_GRAPPLE)
        // Need grapple + at least one Axe swing; preferably two.
        if (tpBudget < grappleCost + axeCost) {
            return null
        }

        var playerX = getCellX(simPos)
        var playerY = getCellY(simPos)
        var enemyPos = this._target._cellPos
        var enemyX = getCellX(enemyPos)
        var enemyY = getCellY(enemyPos)

        var isOnSameLine = (playerY == enemyY) || (playerX == enemyX)
        if (!isOnSameLine) {
            return null
        }

        var grappleCell = -1
        if (playerY == enemyY) {
            grappleCell = (enemyX < playerX) ? getCellFromXY(playerX - 1, playerY) : getCellFromXY(playerX + 1, playerY)
        } else {
            grappleCell = (enemyY < playerY) ? getCellFromXY(playerX, playerY - 1) : getCellFromXY(playerX, playerY + 1)
        }

        if (grappleCell == -1 || grappleCell == null) {
            return null
        }

        push(actions, new Action(Action.ACTION_DIRECT, -1, CHIP_GRAPPLE, grappleCell, this._target))
        tpBudget -= grappleCost

        var enemyPulledPosition = grappleCell

        if (getWeapon() != WEAPON_AXE) {
            push(actions, new Action(Action.ACTION_WEAPON_SWAP, WEAPON_AXE, -1, -1, this._target))
            tpBudget -= 1
        }

        push(actions, new Action(Action.ACTION_DIRECT, WEAPON_AXE, -1, enemyPulledPosition, this._target))
        tpBudget -= axeCost

        if (tpBudget >= axeCost) {
            push(actions, new Action(Action.ACTION_DIRECT, WEAPON_AXE, -1, enemyPulledPosition, this._target))
            tpBudget -= axeCost
        }

        var hideAction = this.getHideAndSeekAction(mpBudget)
        if (hideAction != null) {
            push(actions, hideAction)
        }

        return actions
    }

    createSteroidOTKOScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP

        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_STEROID)) {
            return null
        }
        if (getCooldown(CHIP_STEROID, this._player._id) > 0) {
            return null
        }
        var steroidTeleChip = getAvailableTeleportChip(this._arsenal, this._player._id)
        if (steroidTeleChip == null) {
            return null
        }

        var tpTeleportSteroid = getCachedChipCost(steroidTeleChip)
        var steroidMaxRange = getTeleportMaxRange(steroidTeleChip)
        var tpSteroidCost = getCachedChipCost(CHIP_STEROID)
        if (tpBudget < tpSteroidCost + tpTeleportSteroid) {
            return null
        }

        push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_STEROID, -1, this._player))
        tpBudget -= tpSteroidCost

        var bestOTKO = this._fieldMap.getBestOTKOCell()
        if (bestOTKO == null) {

            bestOTKO = this._fieldMap.getBestWeaponOrChipCell()
            if (bestOTKO == null || bestOTKO == -1) {
                return null
            }
        }

        var teleportDist = getCellDistance(this._player._cellPos, bestOTKO._id)
        if (teleportDist == null || teleportDist < 1 || teleportDist > steroidMaxRange) {
            return null
        }

        push(actions, new Action(Action.ACTION_TELEPORT, -1, steroidTeleChip, bestOTKO._id, this._target))
        tpBudget -= tpTeleportSteroid

        var attackActions = this.getAttackActions(tpBudget, 1.0, bestOTKO._id)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        return actions
    }

    createSteroidRecheckScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP

        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_STEROID)) {
            return null
        }
        if (getCooldown(CHIP_STEROID, this._player._id) > 0) {
            return null
        }

        var tpSteroidRecheck = getCachedChipCost(CHIP_STEROID)
        if (tpBudget < tpSteroidRecheck + 3) {
            return null
        }

        push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_STEROID, -1, this._player))
        tpBudget -= tpSteroidRecheck

        var context = [:]
        context['target'] = this._target
        context['remainingTP'] = tpBudget

        var checkpoint = Action.createCheckpoint("BUFF_RECHECK", "evaluateBuffRecheckContinuation", context)
        push(actions, checkpoint)

        return actions
    }

    createDualBuffAttackScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP

        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_STEROID)) return null
        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_WARM_UP)) return null
        if (getCooldown(CHIP_STEROID, this._player._id) > 0) return null
        if (getCooldown(CHIP_WARM_UP, this._player._id) > 0) return null

        var tpSteroid = getCachedChipCost(CHIP_STEROID)
        var tpWarmUp = getCachedChipCost(CHIP_WARM_UP)
        var buffCost = tpSteroid + tpWarmUp

        if (tpBudget < buffCost + 4) return null

        push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_STEROID, -1, this._player))
        tpBudget -= tpSteroid

        push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_WARM_UP, -1, this._player))
        tpBudget -= tpWarmUp

        var simPos = this._player._cellPos
        var approachCell = this.getApproachEnemyCell(mpBudget)
        if (approachCell != null && approachCell != -1) {
            push(actions, new Action(Action.MOVEMENT_APPROACH, -1, -1, approachCell, this._target))
            simPos = approachCell
        }

        var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        if (count(actions) < 3) return null

        return actions
    }

    createJumpAttackScenario(availableTP, availableMP) {
        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_JUMP)) return null
        if (getCooldown(CHIP_JUMP, this._player._id) > 0) return null

        var jumpCost = getCachedChipCost(CHIP_JUMP)
        if (availableTP < jumpCost + 4) return null

        var playerPos = this._player._cellPos
        var targetPos = this._target._cellPos

        var maxWeaponRange = 0
        for (var wid in mapKeys(this._arsenal.playerEquippedWeapons)) {
            var wObj = this._arsenal.playerEquippedWeapons[wid]
            if (wObj != null && wObj._maxRange > maxWeaponRange) maxWeaponRange = wObj._maxRange
        }
        if (maxWeaponRange == 0) return null

        var bestAttackCell = -1
        var bestLaunchCell = -1
        var bestDamage = 0
        var reachable = getReachableCells()

        // Fix #3: compute baseline damage from the best graph-reachable cell
        // (no Jump). Used to gate Jump scenarios: only emit Jump if it beats
        // walk+attack by enough damage to cover the 3 TP Jump cost. Previously
        // we filtered out all graph-reachable candidates and only considered
        // cells exclusively reachable via Jump — this missed cases where Jump
        // lets us reach a *better* attack cell that's also walk-reachable.
        var baselineDamage = 0
        var baselineOpsLimit = _ops86 - 300000
        for (var rCell in reachable) {
            if (getOperations() > baselineOpsLimit) break
            var rDist = getCellDistance(rCell, targetPos)
            if (rDist == null || rDist > maxWeaponRange) continue
            var rDamage = 0
            for (var wid in mapKeys(this._arsenal.playerEquippedWeapons)) {
                var wObj = this._arsenal.playerEquippedWeapons[wid]
                if (wObj == null) continue
                if (rDist < wObj._minRange || rDist > wObj._maxRange) continue
                if (!getCachedLineOfSight(rCell, targetPos)) continue
                var dmg = this._arsenal.getNetDamageAgainstTarget(
                    this._player._strength, this._player._magic,
                    this._player._wisdom, this._player._science,
                    wid, this._target)
                var swapCost = (getWeapon() != wid) ? 1 : 0
                var uses = min(wObj._maxUse, floor((availableTP - swapCost) / wObj._cost))
                if (uses > 0) rDamage += dmg * uses
            }
            if (rDamage > baselineDamage) baselineDamage = rDamage
        }

        // Magic-poison kiter trap detection: against koe2-class enemies that
        // hit us with MP debuffs after we close, jumping into a cell with
        // <=2 walkable neighbors strands us there for 4+ zero-damage turns.
        // The scorer already penalizes the landing position, but the Jump
        // scenario still wins overall because no non-Jump damage option
        // exists at that range. The generator-side filter here eliminates
        // the candidate so the search proceeds to non-bunker landing cells
        // (or returns null and lets walk+fire scenarios compete cleanly).
        var jaEnemyProf = getEnemyProfile(this._target._id)
        var jaSkipBunker = (jaEnemyProf != null && jaEnemyProf['isKiter']
                            && jaEnemyProf['kiterFlavor'] == 'magic_poison')

        for (var candidate = 0; candidate < 613; candidate++) {
            if (getOperations() > _ops86) break
            if (isObstacle(candidate)) continue
            if (isEntity(candidate)) continue

            var distToTarget = getCellDistance(candidate, targetPos)
            if (distToTarget == null || distToTarget > maxWeaponRange) continue

            // Bunker filter (magic-poison kiter only). Count walkable
            // 4-neighbors; reject candidates with <=2 escape routes since
            // an MP debuff next turn would strand us.
            if (jaSkipBunker && candidate != playerPos) {
                var jaCx = getCellX(candidate)
                var jaCy = getCellY(candidate)
                var jaWalk = 0
                var jaN1 = getCellFromXY(jaCx + 1, jaCy)
                if (jaN1 != null && jaN1 != -1 && getCellContent(jaN1) == CELL_EMPTY) jaWalk++
                var jaN2 = getCellFromXY(jaCx - 1, jaCy)
                if (jaN2 != null && jaN2 != -1 && getCellContent(jaN2) == CELL_EMPTY) jaWalk++
                var jaN3 = getCellFromXY(jaCx, jaCy + 1)
                if (jaN3 != null && jaN3 != -1 && getCellContent(jaN3) == CELL_EMPTY) jaWalk++
                var jaN4 = getCellFromXY(jaCx, jaCy - 1)
                if (jaN4 != null && jaN4 != -1 && getCellContent(jaN4) == CELL_EMPTY) jaWalk++
                if (jaWalk <= 2) continue
            }

            // Filter relaxed: previously skipped any graph-reachable candidate
            // (Jump's purpose was "reach what you can't walk to"). Now we also
            // consider Jump to walk-reachable cells — but gate the final
            // scenario emission on damage strictly beating the no-Jump baseline.

            var launchCell = -1
            var launchMP = 999
            for (var rCell in reachable) {
                var jumpDist = getCellDistance(rCell, candidate)
                if (jumpDist != null && jumpDist >= 1 && jumpDist <= 3) {
                    var mp = getGraphMPCost(rCell)
                    if (mp < launchMP && mp <= availableMP) {
                        launchMP = mp
                        launchCell = rCell
                    }
                }
            }

            if (launchCell == -1) continue

            var tpBudget = availableTP - jumpCost
            var cellDamage = 0
            for (var wid in mapKeys(this._arsenal.playerEquippedWeapons)) {
                var wObj = this._arsenal.playerEquippedWeapons[wid]
                if (wObj == null) continue
                if (distToTarget < wObj._minRange || distToTarget > wObj._maxRange) continue
                if (!getCachedLineOfSight(candidate, targetPos)) continue
                var dmg = this._arsenal.getNetDamageAgainstTarget(
                    this._player._strength, this._player._magic,
                    this._player._wisdom, this._player._science,
                    wid, this._target)
                var swapCost = (getWeapon() != wid) ? 1 : 0
                var uses = min(wObj._maxUse, floor((tpBudget - swapCost) / wObj._cost))
                if (uses > 0) cellDamage += dmg * uses
            }

            if (cellDamage > bestDamage) {
                bestDamage = cellDamage
                bestAttackCell = candidate
                bestLaunchCell = launchCell
            }
        }

        if (bestAttackCell == -1) return null

        // Damage-gate the Jump scenario against the no-Jump baseline. Require
        // Jump damage to exceed baseline by at least jumpCost × (avg dmg/TP).
        // If baseline already matches/exceeds Jump, walk+attack is strictly
        // better — emit no scenario and let standard movement scenarios handle.
        if (baselineDamage > 0 && availableTP > 0) {
            var avgDmgPerTP = baselineDamage / availableTP
            var requiredImprovement = jumpCost * avgDmgPerTP
            if (bestDamage <= baselineDamage + requiredImprovement) return null
        }

        var actions = []
        if (bestLaunchCell != playerPos) {
            push(actions, new Action(Action.MOVEMENT_OFFENSIVE, -1, -1, bestLaunchCell, this._target))
        }
        push(actions, new Action(Action.ACTION_TELEPORT, -1, CHIP_JUMP, bestAttackCell, this._target))
        var tpAfterJump = availableTP - jumpCost
        var attackActions = this.getAttackActions(tpAfterJump, 1.0, bestAttackCell)
        for (var atk in attackActions) push(actions, atk)

        return actions
    }

    // Phase P: dedicated JUMP-to-fire template, narrower and stricter than
    // createJumpAttackScenario. Built specifically for the case where the
    // player is at d=4-8 from a kiter with no MP-reachable shot, but JUMP
    // could land a hit. Differences from createJumpAttackScenario:
    //   - No magic-poison bunker filter (we're already in trouble at this
    //     point — accepting a bunker is better than not shooting).
    //   - Doesn't depend on `getReachableCells()` / `getGraphMPCost()`, so it
    //     still emits a candidate when the player is shackled (negative MP).
    //   - Always launches from player's current cell (no walk-then-jump).
    //   - Bounded search (~25 candidate cells max) — cheap to run every turn.
    // Failure mode this fixes: at T10 in fight 52571411, FIRETURN=1 but no
    // OFFENSIVE scenario reached the candidate pool because JumpAttack's
    // launchCell search rejected c450 (mp=0 > availableMP=-2 when shackled).
    createJumpToFireScenario(availableTP, availableMP) {
        if (this._target == null) return null
        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_JUMP)) return null
        if (getCooldown(CHIP_JUMP, this._player._id) > 0) return null

        var jumpCost = getCachedChipCost(CHIP_JUMP)
        if (availableTP < jumpCost + 4) return null  // need at least one cheap shot

        var pX = getCellX(this._player._cellPos)
        var pY = getCellY(this._player._cellPos)
        var targetPos = this._target._cellPos
        var tpAfterJump = availableTP - jumpCost

        var bestCell = -1
        var bestDamage = 0

        // Enumerate JUMP destinations within Manhattan range 3
        for (var dx = -3; dx <= 3; dx++) {
            for (var dy = -3; dy <= 3; dy++) {
                if (dx == 0 && dy == 0) continue
                if (abs(dx) + abs(dy) > 3) continue
                var jc = getCellFromXY(pX + dx, pY + dy)
                if (jc == null || jc < 0) continue
                if (isObstacle(jc) || isEntity(jc)) continue

                var jd = getCellDistance(jc, targetPos)
                if (jd == null) continue

                // Lazy LoS check (only computed if a weapon/chip clears the
                // range gate; cached after first item).
                var hasLoSCached = -1
                var cellDamage = 0
                for (var wid in mapKeys(this._arsenal.playerEquippedWeapons)) {
                    var w = this._arsenal.playerEquippedWeapons[wid]
                    if (w == null) continue
                    if (jd < w._minRange || jd > w._maxRange) continue
                    // Launch-type geometry — same fix class as the chip-block
                    // launch_type validation in scenario_helpers.
                    if (w._launchType != null && w._launchType > 0 &&
                        !isSimLaunchValid(w._launchType, jc, targetPos)) continue
                    if (hasLoSCached == -1) {
                        hasLoSCached = getCachedLineOfSight(jc, targetPos) ? 1 : 0
                    }
                    if (hasLoSCached == 0) break
                    var swapCost = (getWeapon() != wid) ? 1 : 0
                    var uses = min(w._maxUse, floor((tpAfterJump - swapCost) / w._cost))
                    if (uses <= 0) continue
                    var dmg = this._arsenal.getNetDamageAgainstTarget(
                        this._player._strength, this._player._magic,
                        this._player._wisdom, this._player._science,
                        wid, this._target)
                    if (dmg <= 0) continue
                    var totalDmg = dmg * uses
                    if (totalDmg > cellDamage) cellDamage = totalDmg
                }

                // Also scan damage chips (ROCKFALL, LIGHTNING, ICEBERG,
                // METEORITE, PLASMA, ...). Original implementation only
                // considered weapons, which is why koe2 fight 52575194 T6 had
                // no offensive scenario: from c=170 d=5 mp=-1 KILL state, no
                // weapon's launch geometry matched (off-axis LINE weapons)
                // but ROCKFALL (POINT, range 5-7) would have fired. T7
                // emitted via a different template by chance; T6 sat
                // buffing. With chips added here, J2FIRE becomes the reliable
                // safety net for shackled turns regardless of which damage
                // type fits the current geometry.
                if (hasLoSCached == -1) {
                    hasLoSCached = getCachedLineOfSight(jc, targetPos) ? 1 : 0
                }
                if (hasLoSCached == 1) {
                    var damageChipsJ2F = [CHIP_LIGHTNING, CHIP_PLASMA, CHIP_METEORITE,
                                          CHIP_ICEBERG, CHIP_ROCKFALL, CHIP_FIRE_BALL,
                                          CHIP_ROCK, CHIP_FLAME, CHIP_STALACTITE]
                    for (var cid in damageChipsJ2F) {
                        if (!mapContainsKey(this._arsenal.playerEquippedChips, cid)) continue
                        if (getCooldown(cid, this._player._id) > 0) continue
                        var ch = this._arsenal.playerEquippedChips[cid]
                        if (ch == null) continue
                        if (jd < ch._minRange || jd > ch._maxRange) continue
                        if (ch._launchType != null && ch._launchType > 0 &&
                            !isSimLaunchValid(ch._launchType, jc, targetPos)) continue
                        var chCost = getCachedChipCost(cid)
                        if (tpAfterJump < chCost) continue
                        var chDmg = this._arsenal.getNetDamageAgainstTarget(
                            this._player._strength, this._player._magic,
                            this._player._wisdom, this._player._science,
                            cid, this._target)
                        if (chDmg == null || chDmg <= 0) continue
                        if (chDmg > cellDamage) cellDamage = chDmg
                    }
                }

                if (cellDamage > bestDamage) {
                    bestDamage = cellDamage
                    bestCell = jc
                }
            }
        }

        if (bestCell == -1 || bestDamage == 0) return null

        var actions = []
        push(actions, new Action(Action.ACTION_TELEPORT, -1, CHIP_JUMP, bestCell, this._target))
        var attackActions = this.getAttackActions(tpAfterJump, 1.0, bestCell)
        for (var atk in attackActions) push(actions, atk)

        // Require at least the JUMP + one shot
        if (count(actions) < 2) return null

        if (getTurn() <= 20) {
            debugW("J2FIRE_T" + getTurn() + "_jc" + bestCell + "_d" + bestDamage + "_tp" + availableTP)
        }

        return actions
    }

    createNeutrinoRecheckScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var simPos = this._player._cellPos

        if (!mapContainsKey(this._arsenal.playerEquippedWeapons, WEAPON_NEUTRINO)) {
            return null
        }

        if (tpBudget < 15) {
            return null
        }

        var dist = getCellDistance(simPos, this._target._cellPos)
        if (dist == null) return null

        var isOnAxis = getCellX(simPos) == getCellX(this._target._cellPos) ||
                       getCellY(simPos) == getCellY(this._target._cellPos)
        if (!isOnAxis) return null
        if (dist < 2 || dist > 6) return null

        var neutrinoCount = floor((tpBudget - 10) / 4)
        if (neutrinoCount > 3) neutrinoCount = 3
        if (neutrinoCount < 2) neutrinoCount = 2

        for (var n = 0; n < neutrinoCount; n++) {
            push(actions, new Action(Action.ACTION_DIRECT, WEAPON_NEUTRINO, -1, -1, this._target))
            tpBudget -= 4
        }

        var expectedVuln = neutrinoCount * 8

        var context = [:]
        context['target'] = this._target
        context['remainingTP'] = tpBudget
        context['vulnerabilityPercent'] = expectedVuln

        var checkpoint = Action.createCheckpoint("VULNERABILITY_RECHECK", "evaluateVulnerabilityRecheckContinuation", context)
        push(actions, checkpoint)

        return actions
    }

    createGrappleHSRecheckScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var simPos = this._player._cellPos

        if (!mapContainsKey(this._arsenal.playerEquippedWeapons, WEAPON_HEAVY_SWORD)) {
            return null
        }
        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_GRAPPLE)) {
            return null
        }
        if (getCooldown(CHIP_GRAPPLE, this._player._id) > 0) {
            return null
        }

        if (tpBudget < 12) {
            return null
        }

        var enemyPos = this._target._cellPos
        var isOnAxis = getCellX(simPos) == getCellX(enemyPos) ||
                       getCellY(simPos) == getCellY(enemyPos)
        if (!isOnAxis) return null

        var dist = getCellDistance(simPos, enemyPos)
        if (dist == null) return null
        if (dist < 2 || dist > 8) return null

        var dx = getCellX(enemyPos) - getCellX(simPos)
        var dy = getCellY(enemyPos) - getCellY(simPos)
        var dirX = 0
        var dirY = 0
        if (dx != 0) dirX = dx / abs(dx)
        if (dy != 0) dirY = dy / abs(dy)

        var grappleTargetCell = getCellFromXY(getCellX(simPos) + dirX, getCellY(simPos) + dirY)
        if (grappleTargetCell == null) {
            return null
        }

        push(actions, new Action(Action.ACTION_DEBUFF, -1, CHIP_GRAPPLE, grappleTargetCell, this._target))
        tpBudget -= getCachedChipCost(CHIP_GRAPPLE)

        var context = [:]
        context['target'] = this._target
        context['remainingTP'] = tpBudget
        context['vulnerabilityPercent'] = 0

        var checkpoint = Action.createCheckpoint("VULNERABILITY_RECHECK", "evaluateVulnerabilityRecheckContinuation", context)
        push(actions, checkpoint)

        return actions
    }

    createHealRecheckScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP

        var playerHP = this._player._currHealth
        var playerMaxHP = this._player._maxHealth
        var playerHPPercent = (playerHP * 100) / playerMaxHP

        if (playerHPPercent > 70) {
            return null
        }

        if (tpBudget < 10) {
            return null
        }

        var healAction = this.getSmartHealingAction()
        if (healAction == null) {
            return null
        }

        push(actions, healAction)
        if (healAction.weaponId != -1 && healAction.weaponId != null) {
            var healWeaponCost = getCachedWeaponCost(healAction.weaponId, this._arsenal)
            if (healWeaponCost == null) healWeaponCost = 9
            tpBudget -= healWeaponCost
        } else if (healAction.chip != -1 && healAction.chip != null) {
            tpBudget -= getCachedChipCost(healAction.chip)
        }

        var context = [:]
        context['target'] = this._target
        context['remainingTP'] = tpBudget

        var checkpoint = Action.createCheckpoint("HEAL_RECHECK", "evaluateHealRecheckContinuation", context)
        push(actions, checkpoint)

        return actions
    }

    createGrappleCovidScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        var str = this._player._strength
        var mag = this._player._magic
        var agi = this._player._agility

        if (!(mag > str && mag > agi)) {
            return null
        }

        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_GRAPPLE)) return null
        if (getCooldown(CHIP_GRAPPLE, this._player._id) > 0) return null

        var hasCovid = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_COVID) &&
                      getCooldown(CHIP_COVID, this._player._id) == 0

        if (!hasCovid) return null

        var covidTracker = new CooldownTracker(this._target)
        var covidAntidoteCD = covidTracker.getCooldownRemaining(this._target._id, CooldownTracker.CHIP_ANTIDOTE_ID)
        if (covidAntidoteCD < 3) return null

        var tpGrapple = getCachedChipCost(CHIP_GRAPPLE)
        var tpCovid = getCachedChipCost(CHIP_COVID)
        if (tpBudget < tpGrapple + tpCovid) return null

        var enemyPos = this._target._cellPos
        var enemyX = getCellX(enemyPos)
        var enemyY = getCellY(enemyPos)

        var playerX = getCellX(simPos)
        var playerY = getCellY(simPos)
        var onAxis = (playerX == enemyX || playerY == enemyY)
        var dist = getCellDistance(simPos, enemyPos)

        var grappleCell = simPos
        var moveCost = 0

        if (onAxis && dist != null && dist >= 3 && dist <= 8 && getCachedLineOfSight(simPos, enemyPos)) {
            grappleCell = simPos
        } else {
            var reachableCells = getReachableCells()
            if (reachableCells == null || count(reachableCells) == 0) return null

            var bestCell = -1
            var bestScore = -999999

            for (var cellId in reachableCells) {
                var pathCost = getGraphMPCost(cellId)
                if (pathCost >= 999 || pathCost > mpBudget) continue

                var cx = getCellX(cellId)
                var cy = getCellY(cellId)
                var cellOnAxis = (cx == enemyX || cy == enemyY)
                if (!cellOnAxis) continue

                var cellDist = getCellDistance(cellId, enemyPos)
                if (cellDist == null || cellDist < 3 || cellDist > 8) continue

                if (!getCachedLineOfSight(cellId, enemyPos)) continue

                var score = 1000 - pathCost * 50
                if (cellDist >= 4 && cellDist <= 6) score += 200
                if (score > bestScore) {
                    bestScore = score
                    bestCell = cellId
                    moveCost = pathCost
                }
            }

            if (bestCell == -1) return null

            grappleCell = bestCell
        }

        if (grappleCell != simPos) {
            push(actions, new Action(Action.MOVEMENT_OFFENSIVE, -1, -1, grappleCell, this._target))
            mpBudget -= moveCost
            simPos = grappleCell
        }

        var grappleDist = getCellDistance(grappleCell, enemyPos)
        var hasArsenic = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_ARSENIC) &&
                        getCooldown(CHIP_ARSENIC, this._player._id) == 0
        if (hasArsenic && grappleDist != null && grappleDist >= 3 && grappleDist <= 4) {
            var tpArsenic = getCachedChipCost(CHIP_ARSENIC)
            if (tpBudget >= tpGrapple + tpCovid + tpArsenic) {
                push(actions, new Action(Action.ACTION_DIRECT, -1, CHIP_ARSENIC, enemyPos, this._target))
                tpBudget -= tpArsenic
            }
        }

        push(actions, new Action(Action.ACTION_DIRECT, -1, CHIP_GRAPPLE, enemyPos, this._target))
        tpBudget -= tpGrapple

        push(actions, new Action(Action.ACTION_DIRECT, -1, CHIP_COVID, enemyPos, this._target))
        tpBudget -= tpCovid
        var covidBreakdown = this._arsenal.getDamageBreakdown(str, mag, this._player._wisdom, this._player._science, CHIP_COVID)

        var poisonChips = this._arsenal.getPoisonChipsSorted(str, mag, this._player._wisdom, this._player._science)
        for (var poisonChip in poisonChips) {
            var chipId = poisonChip._id
            if (chipId == CHIP_COVID || chipId == CHIP_ARSENIC || chipId == CHIP_GRAPPLE) continue
            var chipCost = getCachedChipCost(chipId)
            if (tpBudget < chipCost) continue
            if (getCooldown(chipId, this._player._id) > 0) continue
            if (2 < poisonChip._minRange || 2 > poisonChip._maxRange) continue
            push(actions, new Action(Action.ACTION_DIRECT, -1, chipId, enemyPos, this._target))
            tpBudget -= chipCost
        }

        if (tpBudget >= 3) {
            var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
            for (var atk in attackActions) {
                push(actions, atk)
            }
        }

        var kiteAction = this.getKiteAwayAction(mpBudget)
        if (kiteAction != null) {
            push(actions, kiteAction)
        }

        var markerAction = new Action(Action.ACTION_CHECKPOINT, -1, -1, -1, this._target)
        markerAction.checkpointType = "POISON_DUMP"
        push(actions, markerAction)

        return actions
    }

    createPoisonBaitScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        var str = this._player._strength
        var mag = this._player._magic
        var agi = this._player._agility

        if (!(mag > str && mag > agi)) {
            return null
        }

        if (POISON_PHASE != "BAIT") {
            return null
        }

        var tpBoots = getCachedChipCost(CHIP_LEATHER_BOOTS)
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_LEATHER_BOOTS) &&
            getCooldown(CHIP_LEATHER_BOOTS, this._player._id) == 0 &&
            tpBudget >= tpBoots) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_LEATHER_BOOTS, -1, this._player))
            tpBudget -= tpBoots
            mpBudget += 2
        }

        // Denial-teleport branch: if the target is out of shackle range and
        // teleport + at least one shackle is ready, jump into shackle range
        // instead of walking. Solves the kite-and-shoot pattern that wastes
        // 4-5 turns of poison ticks while we close.
        var distToEnemy = getCellDistance(simPos, this._target._cellPos)
        var denialTele = (distToEnemy != null && distToEnemy > 6) ? this.findDenialTeleportCell() : null
        if (denialTele != null && tpBudget >= denialTele['cost']) {
            push(actions, new Action(Action.ACTION_TELEPORT, -1, denialTele['chip'], denialTele['cell'], this._target))
            tpBudget -= denialTele['cost']
            simPos = denialTele['cell']
            distToEnemy = getCellDistance(simPos, this._target._cellPos)
        }

        var moveAction = null
        if (distToEnemy != null && distToEnemy > 6) {
            moveAction = new Action(Action.MOVEMENT_APPROACH, -1, -1, this._target._cellPos, this._target)
        } else {
            moveAction = this.getMoveToOptimalCell(mpBudget)
        }
        if (moveAction != null) {
            push(actions, moveAction)
            if (moveAction.type == Action.MOVEMENT_APPROACH) {
                var path = getPath(simPos, this._target._cellPos)
                if (path != null && count(path) > 1) {
                    var maxSteps = min(mpBudget, count(path) - 1)
                    if (maxSteps > 0) {
                        simPos = path[maxSteps]
                        mpBudget -= maxSteps
                    }
                }
            } else if (moveAction.targetCell != -1) {
                simPos = moveAction.targetCell
                var moveCost = getGraphMPCost(simPos)
                if (moveCost < 999) {
                    mpBudget -= moveCost
                }
            }
        }

        var tpWiz = getCachedChipCost(CHIP_WIZARDRY)
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_WIZARDRY) &&
            getCooldown(CHIP_WIZARDRY, this._player._id) == 0 &&
            tpBudget >= tpWiz) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_WIZARDRY, -1, this._player))
            tpBudget -= tpWiz
        }

        var tpAdren = getCachedChipCost(CHIP_ADRENALINE)
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_ADRENALINE) &&
            getCooldown(CHIP_ADRENALINE, this._player._id) == 0 &&
            tpBudget >= tpAdren) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_ADRENALINE, -1, this._player))
            tpBudget -= tpAdren
            tpBudget += 5
        }

        // Denial first — shackles are the highest-value action in BAIT (deny
        // enemy TP/MP for 2-3 turns AND bait their Antidote/Liberation). Queue
        // them before poisons so they don't get starved when TP runs low.
        var denialChips = [CHIP_SOPORIFIC, CHIP_BALL_AND_CHAIN]
        for (var dChip in denialChips) {
            if (!mapContainsKey(this._arsenal.playerEquippedChips, dChip)) continue
            if (getCooldown(dChip, this._player._id) > 0) continue
            var dCost = getCachedChipCost(dChip)
            if (tpBudget < dCost) continue

            var dObj = this._arsenal.playerEquippedChips[dChip]
            var dist = getCellDistance(simPos, this._target._cellPos)
            if (dist == null || dist < dObj._minRange || dist > dObj._maxRange) continue
            if (!getCachedLineOfSight(simPos, this._target._cellPos)) continue

            if (dObj._aoeType != AREA_POINT) {
                if (fieldMap.wouldAoEHitCell(this._target._cellPos, dObj._aoeType, simPos, simPos)) continue
            }

            push(actions, new Action(Action.ACTION_DEBUFF, -1, dChip, this._target._cellPos, this._target))
            tpBudget -= dCost
        }

        var poisonChips = this._arsenal.getPoisonChipsSorted(str, mag, this._player._wisdom, this._player._science)
        for (var poisonChip in poisonChips) {
            var chipId = poisonChip._id
            if (chipId == CHIP_COVID) continue

            var chipCost = getCachedChipCost(chipId)
            if (tpBudget < chipCost) continue
            if (getCooldown(chipId, this._player._id) > 0) continue

            var dist = getCellDistance(simPos, this._target._cellPos)
            if (dist == null || dist < poisonChip._minRange || dist > poisonChip._maxRange) continue
            if (!getCachedLineOfSight(simPos, this._target._cellPos)) continue

            if (poisonChip._aoeType != AREA_POINT) {
                if (fieldMap.wouldAoEHitCell(this._target._cellPos, poisonChip._aoeType, simPos, simPos)) continue
            }

            push(actions, new Action(Action.ACTION_DIRECT, -1, chipId, this._target._cellPos, this._target))
            tpBudget -= chipCost
        }

        if (tpBudget >= 4) {
            // Phase H: chip poisons queued — direct-damage weapons take priority.
            this._dotDiscountReason = "poisons_queued"
            var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
            this._dotDiscountReason = null
            for (var atk in attackActions) {
                push(actions, atk)
            }
        }

        var kiteAction = this.getKiteAwayAction(mpBudget)
        if (kiteAction != null) {
            push(actions, kiteAction)
        }

        if (count(actions) > 0) {
            var checkpoint = new Action(Action.ACTION_CHECKPOINT, -1, -1, -1, null)
            checkpoint.checkpointType = "POISON_BAIT"
            push(actions, checkpoint)
            return actions
        }

        return null
    }

    createShieldRotationScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP

        if (tpBudget < 10) {
            return null
        }

        var hasFortress = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_FORTRESS)
        var hasWall = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_WALL)

        var fortressTurns = this._player.getEffectRemaining(EFFECT_RELATIVE_SHIELD)
        var wallTurns = this._player.getEffectRemaining(EFFECT_ABSOLUTE_SHIELD)

        var shieldApplied = false

        var tpFortressShield = getCachedChipCost(CHIP_FORTRESS)
        var tpWallShield = getCachedChipCost(CHIP_WALL)
        if (hasFortress && fortressTurns <= 1 && getCooldown(CHIP_FORTRESS, this._player._id) == 0 && tpBudget >= tpFortressShield) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_FORTRESS, -1, this._player))
            tpBudget -= tpFortressShield
            shieldApplied = true
        } else if (hasWall && wallTurns <= 1 && getCooldown(CHIP_WALL, this._player._id) == 0 && tpBudget >= tpWallShield) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_WALL, -1, this._player))
            tpBudget -= tpWallShield
            shieldApplied = true
        }

        if (!shieldApplied) {
            return null
        }

        var simPos = this._player._cellPos
        var attackActions = []
        if (tpBudget >= 4) {
            attackActions = this.getAttackActions(tpBudget, 0.65, simPos)
        }

        if (count(attackActions) == 0) {
            var moveAction = this.getMoveToOptimalCell(availableMP)
            if (moveAction != null) {
                push(actions, moveAction)
                var moveCost = getGraphMPCost(moveAction.targetCell)
                if (moveCost < 999) {
                    simPos = moveAction.targetCell
                }
            }
            if (tpBudget >= 4) {
                attackActions = this.getAttackActions(tpBudget, 0.65, simPos)
            }
        }

        for (var atk in attackActions) {
            push(actions, atk)
        }

        if (count(actions) > 0) {
            return actions
        }

        return null
    }

    createDamageReturnCyclingScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP

        if (tpBudget < 8) {
            return null
        }

        var str = this._player._strength
        var mag = this._player._magic
        var agi = this._player._agility

        var hasMirror = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_MIRROR)
        var hasThorn = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_THORN)
        var hasBramble = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_BRAMBLE)
        var hasAnyDamageReturn = hasMirror || hasThorn || hasBramble

        if (agi < 300 || !hasAnyDamageReturn) {
            return null
        }

        var returnRemaining = this._player.getDamageReturnRemaining()

        var mirrorCd = hasMirror ? getCooldown(CHIP_MIRROR, this._player._id) : 999
        var thornCd = hasThorn ? getCooldown(CHIP_THORN, this._player._id) : 999
        var brambleCd = hasBramble ? getCooldown(CHIP_BRAMBLE, this._player._id) : 999

        var distToEnemy = getCellDistance(this._player._cellPos, this._target._cellPos)
        if (distToEnemy == null) distToEnemy = 99
        var inCloseCombat = distToEnemy <= 8
        var expectedThreat = this._fieldMap.getThreatAtCell(this._player._cellPos)

        var tpBrambleCost = getCachedChipCost(CHIP_BRAMBLE)
        var tpMirrorCost = getCachedChipCost(CHIP_MIRROR)
        var tpThornCost = getCachedChipCost(CHIP_THORN)

        var enemyCanAttack1 = predictEnemyCanAttackWithin(this._player._cellPos, this._target, 1)
        var enemyCanAttack2 = predictEnemyCanAttackWithin(this._player._cellPos, this._target, 2)

        // Check if any reflect needs applying
        var needsReflect = returnRemaining <= 2
        var anyReady = (mirrorCd == 0 && hasMirror) || (thornCd == 0 && hasThorn) || (brambleCd == 0 && hasBramble)
        if (!needsReflect || !anyReady) {
            return null
        }

        // AGI buffs BEFORE reflects for higher damage return values
        var agiBufs = this.getAgiBuff()
        for (var ab in agiBufs) {
            if (tpBudget >= getCachedChipCost(ab.chip) + 8) {
                push(actions, ab)
                tpBudget -= getCachedChipCost(ab.chip)
            }
        }

        // Apply reflects
        var buffApplied = false
        if (hasBramble && returnRemaining <= 1 && brambleCd == 0 && tpBudget >= tpBrambleCost + 8 && inCloseCombat && expectedThreat > 300 && enemyCanAttack1) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_BRAMBLE, -1, this._player))
            tpBudget -= tpBrambleCost
            buffApplied = true
        }
        if (hasMirror && returnRemaining <= 2 && mirrorCd == 0 && tpBudget >= tpMirrorCost + 4) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_MIRROR, -1, this._player))
            tpBudget -= tpMirrorCost
            buffApplied = true
        }
        if (hasThorn && returnRemaining <= 2 && thornCd == 0 && tpBudget >= tpThornCost + 4 && enemyCanAttack2) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_THORN, -1, this._player))
            tpBudget -= tpThornCost
            buffApplied = true
        }

        if (!buffApplied) {
            return null
        }

        var simPos = this._player._cellPos
        var attackActions = []
        if (tpBudget >= 4) {
            attackActions = this.getAttackActions(tpBudget, 0.65, simPos)
        }

        if (count(attackActions) == 0) {
            var moveAction = this.getMoveToOptimalCell(availableMP)
            if (moveAction != null) {
                push(actions, moveAction)
                var moveCost = getGraphMPCost(moveAction.targetCell)
                if (moveCost < 999) {
                    simPos = moveAction.targetCell
                }
            }
            if (tpBudget >= 4) {
                attackActions = this.getAttackActions(tpBudget, 0.65, simPos)
            }
        }

        for (var atk in attackActions) {
            push(actions, atk)
        }

        if (count(actions) > 0) {
            return actions
        }

        return null
    }

    createPoisonDumpScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        var str = this._player._strength
        var mag = this._player._magic
        var agi = this._player._agility

        if (!(mag > str && mag > agi)) {
            return null
        }

        var currentTurn = getTurn()

        if (POISON_PHASE != "DUMP") {
            return null
        }

        var hpPercent = this._player._currHealth * 100 / this._player._maxHealth
        if (hpPercent < 50) {

            // Phase I: reserve TP for at least 1 weapon attack BEFORE
            // applying defensive buffs, when target is in weapon range.
            // Prevents pure-defense turns when offense is feasible.
            var dumpInWeaponRange = false
            for (var dumpWid in mapKeys(this._arsenal.playerEquippedWeapons)) {
                var dumpW = this._arsenal.playerEquippedWeapons[dumpWid]
                var dumpDist = getCellDistance(simPos, this._target._cellPos)
                if (dumpDist != null && dumpDist >= dumpW._minRange && dumpDist <= dumpW._maxRange) {
                    dumpInWeaponRange = true
                    break
                }
            }
            var dumpReservedAttackTP = dumpInWeaponRange ? 8 : 0
            var dumpDefBudget = tpBudget - dumpReservedAttackTP

            var tpFortress = getCachedChipCost(CHIP_FORTRESS)
            var tpWall = getCachedChipCost(CHIP_WALL)
            if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_FORTRESS) &&
                getCooldown(CHIP_FORTRESS, this._player._id) == 0 &&
                dumpDefBudget >= tpFortress) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_FORTRESS, -1, this._player))
                tpBudget -= tpFortress
                dumpDefBudget -= tpFortress
            } else if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_WALL) &&
                getCooldown(CHIP_WALL, this._player._id) == 0 &&
                dumpDefBudget >= tpWall) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_WALL, -1, this._player))
                tpBudget -= tpWall
                dumpDefBudget -= tpWall
            }

            var tpRemissionDump = getCachedChipCost(CHIP_REMISSION)
            if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_REMISSION) &&
                getCooldown(CHIP_REMISSION, this._player._id) == 0 &&
                dumpDefBudget >= tpRemissionDump) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_REMISSION, -1, this._player))
                tpBudget -= tpRemissionDump
                dumpDefBudget -= tpRemissionDump
            }
        }

        // Denial-teleport in DUMP too: same kiter-counter logic.
        var dumpDistToEnemy = getCellDistance(simPos, this._target._cellPos)
        var dumpDenialTele = (dumpDistToEnemy != null && dumpDistToEnemy > 6) ? this.findDenialTeleportCell() : null
        if (dumpDenialTele != null && tpBudget >= dumpDenialTele['cost']) {
            push(actions, new Action(Action.ACTION_TELEPORT, -1, dumpDenialTele['chip'], dumpDenialTele['cell'], this._target))
            tpBudget -= dumpDenialTele['cost']
            simPos = dumpDenialTele['cell']
        }

        var moveAction = this.getMoveToOptimalCell(mpBudget)
        if (moveAction != null) {
            push(actions, moveAction)
            if (moveAction.targetCell != -1) {
                simPos = moveAction.targetCell
                var moveCost = getGraphMPCost(simPos)
                if (moveCost < 999) {
                    mpBudget -= moveCost
                }
            }
        }

        var dumpTracker = new CooldownTracker(this._target)
        var dumpAntidoteCD = dumpTracker.getCooldownRemaining(this._target._id, CooldownTracker.CHIP_ANTIDOTE_ID)

        var hasGrapple = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_GRAPPLE) &&
                         getCooldown(CHIP_GRAPPLE, this._player._id) == 0
        var hasCovid = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_COVID) &&
                       getCooldown(CHIP_COVID, this._player._id) == 0 &&
                       dumpAntidoteCD >= 3
        var tpGrapple = getCachedChipCost(CHIP_GRAPPLE)
        var tpCovid = getCachedChipCost(CHIP_COVID)
        var grapplePulled = false
        var simDist = getCellDistance(simPos, this._target._cellPos)

        if (hasGrapple && hasCovid && tpBudget >= tpGrapple + tpCovid && simDist != null) {
            var hasArsenic = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_ARSENIC) &&
                             getCooldown(CHIP_ARSENIC, this._player._id) == 0
            if (hasArsenic && simDist >= 3 && simDist <= 4) {
                var tpArsenic = getCachedChipCost(CHIP_ARSENIC)
                if (tpBudget >= tpGrapple + tpCovid + tpArsenic && getCachedLineOfSight(simPos, this._target._cellPos)) {
                    push(actions, new Action(Action.ACTION_DIRECT, -1, CHIP_ARSENIC, this._target._cellPos, this._target))
                    tpBudget -= tpArsenic
                }
            }

            if (simDist >= 1 && simDist <= 8 && getCachedLineOfSight(simPos, this._target._cellPos)) {
                push(actions, new Action(Action.ACTION_DIRECT, -1, CHIP_GRAPPLE, this._target._cellPos, this._target))
                tpBudget -= tpGrapple
                grapplePulled = true
                simDist = 2

                push(actions, new Action(Action.ACTION_DIRECT, -1, CHIP_COVID, this._target._cellPos, this._target))
                tpBudget -= tpCovid
            }
        }

        var tpWizardryDump = getCachedChipCost(CHIP_WIZARDRY)
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_WIZARDRY) &&
            getCooldown(CHIP_WIZARDRY, this._player._id) == 0 &&
            tpBudget >= tpWizardryDump) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_WIZARDRY, -1, this._player))
            tpBudget -= tpWizardryDump
        }

        // Queue shackles in DUMP phase too — denial stacks with poison and
        // doesn't depend on the BAIT/DUMP state to be effective.
        var dumpDenialChips = [CHIP_SOPORIFIC, CHIP_BALL_AND_CHAIN]
        for (var dDChip in dumpDenialChips) {
            if (!mapContainsKey(this._arsenal.playerEquippedChips, dDChip)) continue
            if (getCooldown(dDChip, this._player._id) > 0) continue
            var dDCost = getCachedChipCost(dDChip)
            if (tpBudget < dDCost) continue
            var dDObj = this._arsenal.playerEquippedChips[dDChip]
            var dDDist = getCellDistance(simPos, this._target._cellPos)
            if (grapplePulled) dDDist = simDist
            if (dDDist == null || dDDist < dDObj._minRange || dDDist > dDObj._maxRange) continue
            if (!getCachedLineOfSight(simPos, this._target._cellPos)) continue
            if (dDObj._aoeType != AREA_POINT &&
                fieldMap.wouldAoEHitCell(this._target._cellPos, dDObj._aoeType, simPos, simPos)) continue
            push(actions, new Action(Action.ACTION_DEBUFF, -1, dDChip, this._target._cellPos, this._target))
            tpBudget -= dDCost
        }

        var poisonChips = this._arsenal.getPoisonChipsSorted(str, mag, this._player._wisdom, this._player._science)

        for (var poisonChip in poisonChips) {
            var chipId = poisonChip._id

            if (grapplePulled && (chipId == CHIP_COVID || chipId == CHIP_ARSENIC || chipId == CHIP_GRAPPLE)) continue

            var chipCost = getCachedChipCost(chipId)

            if (tpBudget < chipCost) continue
            if (getCooldown(chipId, this._player._id) > 0) continue

            var dist = getCellDistance(simPos, this._target._cellPos)
            if (grapplePulled) dist = simDist
            if (dist == null || dist < poisonChip._minRange || dist > poisonChip._maxRange) continue

            if (!getCachedLineOfSight(simPos, this._target._cellPos)) continue

            push(actions, new Action(Action.ACTION_DIRECT, -1, chipId, this._target._cellPos, this._target))
            tpBudget -= chipCost
        }

        if (tpBudget >= 4) {
            // Phase H: chip poisons are now queued — direct-damage weapons
            // (e.g. Unbridled Gazor) should beat poison weapons (Flame Thrower)
            // because the weapon dot would be redundant.
            this._dotDiscountReason = "poisons_queued"
            var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
            this._dotDiscountReason = null
            for (var atk in attackActions) {
                push(actions, atk)
            }
        }

        var kiteAction = this.getKiteAwayAction(mpBudget)
        if (kiteAction != null) {
            push(actions, kiteAction)
        }

        if (count(actions) > 0) {
            var markerAction = new Action(Action.ACTION_CHECKPOINT, -1, -1, -1, this._target)
            markerAction.checkpointType = "POISON_DUMP"
            push(actions, markerAction)

            POISON_PHASE = "SUSTAIN"
            LAST_POISON_DUMP_TURN = currentTurn

            return actions
        }

        return null
    }

    createNeutrinoOTKOScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        if (!mapContainsKey(this._arsenal.playerEquippedWeapons, WEAPON_NEUTRINO)) {
            return null
        }
        var neutrinoTeleChip = getAvailableTeleportChip(this._arsenal, this._player._id)
        if (neutrinoTeleChip == null) {
            return null
        }

        var tpTeleportNeutrino = getCachedChipCost(neutrinoTeleChip)
        var neutrinoTeleMaxRange = getTeleportMaxRange(neutrinoTeleChip)
        if (tpBudget < 12 + tpTeleportNeutrino) {
            return null
        }

        var enemyHP = this._target._currHealth
        var enemyMaxHP = this._target._maxHealth
        var enemyHPPercent = (enemyHP * 100) / enemyMaxHP

        if (enemyHPPercent >= 40) {
            return null
        }

        var dist = getCellDistance(simPos, this._target._cellPos)
        if (dist == null) return null

        var isDiagonal = this.isDiagonal(simPos, this._target._cellPos)
        if (!isDiagonal || dist < 2 || dist > 6) {
            return null
        }

        if (!getCachedLineOfSight(simPos, this._target._cellPos)) {
            return null
        }

        if (getWeapon() != WEAPON_NEUTRINO) {
            push(actions, new Action(Action.ACTION_WEAPON_SWAP, -1, -1, -1, this._target))
            actions[count(actions) - 1].weapon = WEAPON_NEUTRINO
            tpBudget -= 1
        }

        for (var i = 0; i < 3; i++) {
            if (tpBudget >= 4) {
                push(actions, new Action(Action.ACTION_DIRECT, WEAPON_NEUTRINO, -1, this._target._cellPos, this._target))
                tpBudget -= 4
            }
        }

        var bestOTKO = this._fieldMap.getBestOTKOCell()
        if (bestOTKO == null) {
            bestOTKO = this._fieldMap.getBestWeaponOrChipCell()
            if (bestOTKO == null) {
                return null
            }
        }

        var teleportDist = getCellDistance(simPos, bestOTKO._id)
        if (teleportDist == null || teleportDist < 1 || teleportDist > neutrinoTeleMaxRange) {
            return null
        }

        push(actions, new Action(Action.ACTION_TELEPORT, -1, neutrinoTeleChip, bestOTKO._id, this._target))
        tpBudget -= tpTeleportNeutrino

        var attackActions = this.getAttackActions(tpBudget, 1.0, bestOTKO._id)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        return actions
    }

    createAdrenalineComboScenario(comboScenarioCreator, requiredTP, availableTP, availableMP) {
        var tpGap = requiredTP - availableTP

        if (tpGap < 1 || tpGap > 4) {
            return null
        }

        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_ADRENALINE)) {
            return null
        }
        if (getCooldown(CHIP_ADRENALINE, this._player._id) > 0) {
            return null
        }

        if (availableTP < 1) {
            return null
        }

        var actions = []

        push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_ADRENALINE, -1, this._player))
        var newTPBudget = availableTP - 1 + 5

        var comboActions = comboScenarioCreator(newTPBudget, availableMP)
        if (comboActions == null || count(comboActions) == 0) {
            return null
        }

        for (var action in comboActions) {
            push(actions, action)
        }

        return actions
    }

    createStaticAttackScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var simPos = this._player._cellPos

        var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)

        if (count(attackActions) == 0) {
            var moveAction = this.getMoveToOptimalCell(availableMP)
            if (moveAction != null) {
                push(actions, moveAction)
                var moveCost = getGraphMPCost(moveAction.targetCell)
                if (moveCost < 999) {
                    simPos = moveAction.targetCell
                }
            }
            attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
        }

        for (var atk in attackActions) {
            push(actions, atk)
        }

        return actions
    }

    createTimePressureScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        var tpAdren = getCachedChipCost(CHIP_ADRENALINE)
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_ADRENALINE) &&
            getCooldown(CHIP_ADRENALINE, this._player._id) == 0 &&
            tpBudget >= tpAdren) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_ADRENALINE, -1, this._player))
            tpBudget -= tpAdren
            tpBudget += 5
        }

        var tpBoots = getCachedChipCost(CHIP_LEATHER_BOOTS)
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_LEATHER_BOOTS) &&
            getCooldown(CHIP_LEATHER_BOOTS, this._player._id) == 0 &&
            tpBudget >= tpBoots) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_LEATHER_BOOTS, -1, this._player))
            tpBudget -= tpBoots
            mpBudget += 2
        }

        var moveAction = this.getMoveToOptimalCell(mpBudget)
        if (moveAction != null) {
            push(actions, moveAction)
            var moveCost = getGraphMPCost(moveAction.targetCell)
            if (moveCost < 999) {
                mpBudget -= moveCost
                simPos = moveAction.targetCell
            }
        }

        var denialActionsTP = this.getDenialActions(tpBudget, simPos)
        for (var da in denialActionsTP) {
            push(actions, da)
            tpBudget -= getCachedChipCost(da.chip)
        }

        var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        return actions
    }

    createSimpleOffensiveScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        var moveAction = this.getMoveToOptimalCell(mpBudget)
        if (moveAction != null) {
            push(actions, moveAction)
            var moveCost = getGraphMPCost(moveAction.targetCell)
            if (moveCost < 999) {
                mpBudget -= moveCost
                simPos = moveAction.targetCell
            }
        }

        var denialActionsS = this.getDenialActions(tpBudget, simPos)
        for (var da in denialActionsS) {
            push(actions, da)
            tpBudget -= getCachedChipCost(da.chip)
        }

        var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        var hideAction = this.getHideAndSeekAction(mpBudget)
        if (hideAction != null) {
            push(actions, hideAction)
        }

        return actions
    }

    createNovaAttritionScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        var sci = this._player._science
        var res = this._player._resistance
        if (sci < 200 || res < 200) return null

        var antidoteAction = this.getAntidoteAction(tpBudget)
        if (antidoteAction != null) {
            push(actions, antidoteAction)
            tpBudget -= getCachedChipCost(CHIP_ANTIDOTE)
        }

        var defensiveBuff = this.getDefensiveBuff()
        if (defensiveBuff != null && tpBudget >= getCachedChipCost(defensiveBuff.chip)) {
            push(actions, defensiveBuff)
            tpBudget -= getCachedChipCost(defensiveBuff.chip)
        }

        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_PRISM) &&
            getCooldown(CHIP_PRISM, this._player._id) == 0) {
            var prismCost = getCachedChipCost(CHIP_PRISM)
            if (tpBudget >= prismCost) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_PRISM, -1, this._player))
                tpBudget -= prismCost
            }
        } else if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_KNOWLEDGE) &&
                   getCooldown(CHIP_KNOWLEDGE, this._player._id) == 0) {
            var knowledgeCost = getCachedChipCost(CHIP_KNOWLEDGE)
            if (tpBudget >= knowledgeCost) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_KNOWLEDGE, -1, this._player))
                tpBudget -= knowledgeCost
            }
        }

        var healAction = this.getHealingAction(tpBudget, 0.80)
        if (healAction != null) {
            push(actions, healAction)
            if (healAction.chip != -1) tpBudget -= getCachedChipCost(healAction.chip)
        }

        var leatherBoots = this.getLeatherBootsBuff()
        if (leatherBoots != null) {
            var bootsCost = getCachedChipCost(CHIP_LEATHER_BOOTS)
            if (tpBudget >= bootsCost) {
                push(actions, leatherBoots)
                tpBudget -= bootsCost
                mpBudget += 2
            }
        }

        var motivBuffA = this.getMotivationBuff()
        if (motivBuffA != null) {
            var motivCostA = getCachedChipCost(CHIP_MOTIVATION)
            if (tpBudget >= motivCostA) {
                push(actions, motivBuffA)
                tpBudget -= motivCostA
                tpBudget += 2
            }
        }

        var moveAction = this.getMoveToOptimalCell(mpBudget)
        if (moveAction != null) {
            push(actions, moveAction)
            var moveCost = getGraphMPCost(moveAction.targetCell)
            if (moveCost < 999) {
                mpBudget -= moveCost
                simPos = moveAction.targetCell
            }
        }

        var novaWeaponFired = false
        for (var weaponId in mapKeys(this._arsenal.playerEquippedWeapons)) {
            var weapon = this._arsenal.playerEquippedWeapons[weaponId]
            if (!mapContainsKey(weapon._effects, EFFECT_NOVA_DAMAGE)) continue

            var dist = getCellDistance(simPos, this._target._cellPos)
            if (dist == null || dist < weapon._minRange || dist > weapon._maxRange) continue
            if (!getCachedLineOfSight(simPos, this._target._cellPos)) continue

            if (tpBudget >= weapon._cost) {
                push(actions, new Action(Action.ACTION_DIRECT, weaponId, -1, this._target._cellPos, this._target))
                tpBudget -= weapon._cost
                novaWeaponFired = true
                break
            }
        }

        var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
        for (var atk in attackActions) {
            push(actions, atk)
        }

        var hideAction = this.getHideAndSeekAction(mpBudget)
        if (hideAction != null) {
            push(actions, hideAction)
        }

        if (count(actions) < 2) return null
        return actions
    }

    createBruiserReflectScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var simPos = this._player._cellPos

        var str = this._player._strength
        var agi = this._player._agility
        if (str < 400 || agi < 400) return null

        var hasMirror = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_MIRROR)
        var hasThorn = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_THORN)
        var hasBramble = mapContainsKey(this._arsenal.playerEquippedChips, CHIP_BRAMBLE)
        if (!hasMirror && !hasThorn && !hasBramble) return null

        if (tpBudget < 10) return null

        // Adrenaline first to unlock TP for the full buff+reflect sequence
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_ADRENALINE) &&
            getCooldown(CHIP_ADRENALINE, this._player._id) == 0 &&
            tpBudget >= getCachedChipCost(CHIP_ADRENALINE)) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_ADRENALINE, -1, this._player))
            tpBudget -= getCachedChipCost(CHIP_ADRENALINE)
            tpBudget += 5  // Adrenaline grants +5 TP
        }

        // AGI buffs BEFORE reflects: reflect damage scales with caster's AGI
        // at cast time, so Warm up/Stretching must precede Mirror/Thorn/Bramble.
        var agiBufActions = this.getAgiBuff()
        for (var ab in agiBufActions) {
            if (tpBudget >= getCachedChipCost(ab.chip)) {
                push(actions, ab)
                tpBudget -= getCachedChipCost(ab.chip)
            }
        }

        // Now apply reflects with boosted AGI — this is the core of the build
        var damageReturnActions = this.getAllDamageReturnBuffs()
        for (var dr in damageReturnActions) {
            if (tpBudget >= getCachedChipCost(dr.chip)) {
                push(actions, dr)
                tpBudget -= getCachedChipCost(dr.chip)
            }
        }

        // STR buff only if TP remains after reflects
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_STEROID) &&
            getCooldown(CHIP_STEROID, this._player._id) == 0 &&
            tpBudget >= getCachedChipCost(CHIP_STEROID)) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_STEROID, -1, this._player))
            tpBudget -= getCachedChipCost(CHIP_STEROID)
        }

        var hpPercent = this._player._currHealth * 100 / this._player._maxHealth
        if (hpPercent < 70) {
            var healAction = this.getHealingAction(tpBudget, 0.7)
            if (healAction != null) {
                push(actions, healAction)
                tpBudget -= getCachedChipCost(healAction.chip)
            }
        }

        var leatherBoots = this.getLeatherBootsBuff()
        if (leatherBoots != null) {
            var bootsCost = getCachedChipCost(CHIP_LEATHER_BOOTS)
            if (tpBudget >= bootsCost) {
                push(actions, leatherBoots)
                tpBudget -= bootsCost
                mpBudget += 2
            }
        }

        var motivBuffR = this.getMotivationBuff()
        if (motivBuffR != null) {
            var motivCostR = getCachedChipCost(CHIP_MOTIVATION)
            if (tpBudget >= motivCostR) {
                push(actions, motivBuffR)
                tpBudget -= motivCostR
                tpBudget += 2
            }
        }

        var moveAction = this.getMoveToOptimalCell(mpBudget)
        if (moveAction != null) {
            push(actions, moveAction)
            var moveCost = getGraphMPCost(moveAction.targetCell)
            if (moveCost < 999) {
                mpBudget -= moveCost
                simPos = moveAction.targetCell
            }
        }

        if (tpBudget >= 5) {
            var attackActions = this.getAttackActions(tpBudget, 1.0, simPos)
            for (var atk in attackActions) {
                push(actions, atk)
            }
        }

        if (hpPercent < 30) {
            var hideAction = this.getHideAndSeekAction(mpBudget)
            if (hideAction != null) {
                push(actions, hideAction)
            }
        }

        if (count(actions) < 2) return null
        return actions
    }

    // Phase 2: Dedicated MOTIVATION setup template. MOTIVATION costs 4 TP to
    // return +2 TP/turn for 3 turns (6 TP gross). Net +2 TP, but the real value
    // is the 16-TP combo windows it enables on turns N+1/N+2: STEROID(5) +
    // double DESTROYER attack (14 TP) fits in 16 TP but not 14. This template
    // pre-commits the setup turn (cast MOTIVATION + approach + light mobility
    // prep) and marks it with a COMBO_SETUP checkpoint so the scorer treats
    // it as a multi-turn plan rather than a single-buff scenario.
    //
    // Fires only when:
    // - MOTIVATION equipped and off-CD
    // - 2-3 turn combat horizon ahead (enemy >40%, our HP >35%, turn <= 30)
    // - We can't shoot this turn from current cell (no direct attack alt)
    // - TP surplus to still take a meaningful approach action this turn
    createMotivationSetupScenario(availableTP, availableMP) {
        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_MOTIVATION)) return null
        if (getCooldown(CHIP_MOTIVATION, this._player._id) > 0) return null

        var msMotivCost = getCachedChipCost(CHIP_MOTIVATION)
        // Threshold: MOTIVATION (4) + LEATHER_BOOTS (3) = 7. Lowered from +6
        // so T1 with 8 TP (LeekRain log) doesn't reject the setup outright.
        if (availableTP < msMotivCost + 3) return null

        var msEnemyHPPct = (this._target._currHealth * 100) / max(1, this._target._maxHealth)
        var msPlayerHPPct = (this._player._currHealth * 100) / max(1, this._player._maxHealth)
        if (msEnemyHPPct <= 40) return null
        if (msPlayerHPPct <= 35) return null
        if (getTurn() > 30) return null

        // Skip if we can already shoot — direct attack templates win this turn.
        var msDist = getCellDistance(this._player._cellPos, this._target._cellPos)
        if (msDist == null) return null
        var msMaxWR = 0
        for (var msWid in mapKeys(this._arsenal.playerEquippedWeapons)) {
            var msW = this._arsenal.playerEquippedWeapons[msWid]
            if (msW != null && msW._maxRange > msMaxWR) msMaxWR = msW._maxRange
        }
        if (msDist <= msMaxWR &&
            getCachedLineOfSight(this._player._cellPos, this._target._cellPos)) {
            return null
        }

        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP

        // Cast MOTIVATION first (the setup core).
        push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_MOTIVATION, -1, this._player))
        tpBudget -= msMotivCost
        tpBudget += 2  // immediate +2 TP from the buff (current-turn effect)

        // LEATHER_BOOTS: +2 MP for the approach. Cheap (3 TP) and pays directly
        // into the closing distance this turn.
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_LEATHER_BOOTS) &&
            getCooldown(CHIP_LEATHER_BOOTS, this._player._id) == 0) {
            var msBootsCost = getCachedChipCost(CHIP_LEATHER_BOOTS)
            if (tpBudget >= msBootsCost) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_LEATHER_BOOTS, -1, this._player))
                tpBudget -= msBootsCost
                mpBudget += 2
            }
        }

        // Approach the enemy with whatever MP we have.
        var msApproachCell = this.getApproachEnemyCell(mpBudget)
        if (msApproachCell != null && msApproachCell != -1) {
            push(actions, new Action(Action.MOVEMENT_APPROACH, -1, -1, msApproachCell, this._target))
        }

        // JUMP to close further if available. Pure TP-for-distance trade —
        // perfect with MOTIVATION's surplus economy. Inline cell pick: scan
        // 3-cell radius around post-move position, take the cell that reduces
        // distance to enemy the most (must be empty, non-obstacle).
        var msJumpCost = getCachedChipCost(CHIP_JUMP)
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_JUMP) &&
            getCooldown(CHIP_JUMP, this._player._id) == 0 &&
            tpBudget >= msJumpCost) {
            var msJumpFrom = (msApproachCell != null && msApproachCell != -1) ? msApproachCell : this._player._cellPos
            var msFromDist = getCellDistance(msJumpFrom, this._target._cellPos)
            if (msFromDist == null) msFromDist = 99
            var msJumpBest = -1
            var msJumpBestDist = msFromDist
            var msFromX = getCellX(msJumpFrom)
            var msFromY = getCellY(msJumpFrom)
            for (var msDx = -3; msDx <= 3; msDx++) {
                for (var msDy = -3; msDy <= 3; msDy++) {
                    if (msDx == 0 && msDy == 0) continue
                    if (abs(msDx) + abs(msDy) > 3) continue
                    var msCand = getCellFromXY(msFromX + msDx, msFromY + msDy)
                    if (msCand == null || msCand < 0) continue
                    if (isObstacle(msCand) || isEntity(msCand)) continue
                    var msCandDist = getCellDistance(msJumpFrom, msCand)
                    if (msCandDist == null || msCandDist < 1 || msCandDist > 3) continue
                    var msToEnemy = getCellDistance(msCand, this._target._cellPos)
                    if (msToEnemy == null) continue
                    if (msToEnemy < msJumpBestDist) {
                        msJumpBestDist = msToEnemy
                        msJumpBest = msCand
                    }
                }
            }
            if (msJumpBest != -1 && msJumpBestDist < msFromDist) {
                push(actions, new Action(Action.ACTION_TELEPORT, -1, CHIP_JUMP, msJumpBest, null))
                tpBudget -= msJumpCost
            }
        }

        // COMBO_SETUP checkpoint: locks this as a multi-turn plan in the scorer.
        var msCheckpoint = new Action(Action.ACTION_CHECKPOINT, -1, -1, -1, null)
        msCheckpoint.checkpointType = "MOTIVATION_SETUP"
        push(actions, msCheckpoint)

        // Require at least MOTIVATION + one positioning action.
        if (count(actions) < 3) return null
        return actions
    }

    // Option B: Buff-Stack-Until-Shot. Triggers when no shot lands this turn
    // but FIRETURN is in [2,3] — stacks offensive buffs whose duration outlasts
    // FIRETURN, then closes distance with approach + JUMP. Distinct from
    // MotivationSetup (which requires MOTIVATION and is TP-economy focused).
    createBuffStageScenario(availableTP, availableMP) {
        if (this._target == null) return null
        if (__nearestFireTurn < 2 || __nearestFireTurn > 3) return null
        if (__timePressure) return null
        if (getTurn() > 35) return null

        var bsEnemyHPPct = (this._target._currHealth * 100) / max(1, this._target._maxHealth)
        var bsPlayerHPPct = (this._player._currHealth * 100) / max(1, this._player._maxHealth)
        if (bsEnemyHPPct <= 35) return null
        if (bsPlayerHPPct <= 35) return null

        // Skip if MOTIVATION setup is firing — they overlap.
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_MOTIVATION) &&
            getCooldown(CHIP_MOTIVATION, this._player._id) == 0) return null

        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP
        var buffsCast = 0

        // Candidate buffs by duration. FIRETURN=2 → any 3-dur buff survives.
        // KNOWLEDGE (2-dur) skipped at FIRETURN=3 (expires on shot turn).
        var bsCandidates = []
        if (this._player._strength >= this._player._magic) {
            push(bsCandidates, CHIP_STEROID)
            push(bsCandidates, CHIP_WARM_UP)
            push(bsCandidates, CHIP_RAGE)
        } else {
            push(bsCandidates, CHIP_WIZARDRY)
            push(bsCandidates, CHIP_PRISM)
        }
        if (__nearestFireTurn == 2) {
            push(bsCandidates, CHIP_KNOWLEDGE)
        }

        for (var bsi = 0; bsi < count(bsCandidates); bsi++) {
            var bsChip = bsCandidates[bsi]
            if (!mapContainsKey(this._arsenal.playerEquippedChips, bsChip)) continue
            if (getCooldown(bsChip, this._player._id) > 0) continue
            var bsCost = getCachedChipCost(bsChip)
            if (tpBudget < bsCost + 1) continue
            push(actions, new Action(Action.ACTION_BUFF, -1, bsChip, -1, this._player))
            tpBudget -= bsCost
            buffsCast += 1
            if (buffsCast >= 2) break
        }

        if (buffsCast == 0) return null

        // LEATHER_BOOTS: +2 MP closing.
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_LEATHER_BOOTS) &&
            getCooldown(CHIP_LEATHER_BOOTS, this._player._id) == 0) {
            var bsBootsCost = getCachedChipCost(CHIP_LEATHER_BOOTS)
            if (tpBudget >= bsBootsCost) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_LEATHER_BOOTS, -1, this._player))
                tpBudget -= bsBootsCost
                mpBudget += 2
            }
        }

        // Approach with available MP.
        var bsApproachCell = this.getApproachEnemyCell(mpBudget)
        if (bsApproachCell != null && bsApproachCell != -1) {
            push(actions, new Action(Action.MOVEMENT_APPROACH, -1, -1, bsApproachCell, this._target))
        }

        // JUMP further if available (3-cell radius scan, take the cell that
        // reduces distance to enemy the most).
        var bsJumpCost = getCachedChipCost(CHIP_JUMP)
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_JUMP) &&
            getCooldown(CHIP_JUMP, this._player._id) == 0 &&
            tpBudget >= bsJumpCost) {
            var bsJumpFrom = (bsApproachCell != null && bsApproachCell != -1) ? bsApproachCell : this._player._cellPos
            var bsFromDist = getCellDistance(bsJumpFrom, this._target._cellPos)
            if (bsFromDist == null) bsFromDist = 99
            var bsJumpBest = -1
            var bsJumpBestDist = bsFromDist
            var bsFromX = getCellX(bsJumpFrom)
            var bsFromY = getCellY(bsJumpFrom)
            for (var bsDx = -3; bsDx <= 3; bsDx++) {
                for (var bsDy = -3; bsDy <= 3; bsDy++) {
                    if (bsDx == 0 && bsDy == 0) continue
                    if (abs(bsDx) + abs(bsDy) > 3) continue
                    var bsCand = getCellFromXY(bsFromX + bsDx, bsFromY + bsDy)
                    if (bsCand == null || bsCand < 0) continue
                    if (isObstacle(bsCand) || isEntity(bsCand)) continue
                    var bsCandDist = getCellDistance(bsJumpFrom, bsCand)
                    if (bsCandDist == null || bsCandDist < 1 || bsCandDist > 3) continue
                    var bsToEnemy = getCellDistance(bsCand, this._target._cellPos)
                    if (bsToEnemy == null) continue
                    if (bsToEnemy < bsJumpBestDist) {
                        bsJumpBestDist = bsToEnemy
                        bsJumpBest = bsCand
                    }
                }
            }
            if (bsJumpBest != -1 && bsJumpBestDist < bsFromDist) {
                push(actions, new Action(Action.ACTION_TELEPORT, -1, CHIP_JUMP, bsJumpBest, null))
                tpBudget -= bsJumpCost
            }
        }

        // BUFF_STAGE checkpoint flag.
        var bsCheckpoint = new Action(Action.ACTION_CHECKPOINT, -1, -1, -1, null)
        bsCheckpoint.checkpointType = "BUFF_STAGE"
        push(actions, bsCheckpoint)

        if (count(actions) < 3) return null
        return actions
    }

    createBuffApproachScenario(availableTP, availableMP) {
        var actions = []
        var tpBudget = availableTP
        var mpBudget = availableMP

        var hasAnyHitCells = false
        for (var weaponId in mapKeys(this._fieldMap.weaponHitmap)) {
            var cells = this._fieldMap.weaponHitmap[weaponId]
            if (count(cells) > 0) {
                hasAnyHitCells = true
                break
            }
        }
        if (!hasAnyHitCells) {
            for (var chipId in mapKeys(this._fieldMap.chipHitmap)) {
                var cells = this._fieldMap.chipHitmap[chipId]
                if (count(cells) > 0) {
                    hasAnyHitCells = true
                    break
                }
            }
        }
        if (hasAnyHitCells) {
            return null
        }

        var str = this._player._strength
        var mag = this._player._magic
        var agi = this._player._agility
        var buffApplied = false

        // Engagement horizon: how far can we plausibly be from "in attack range"
        // after this turn's move+jump? If target is farther, offensive buffs
        // (Steroid 3t, Knowledge 2t, Warm_up 2t) will expire before we fire —
        // skip them and spend TP on Jump for closing instead.
        var distNow = getCellDistance(this._player._cellPos, this._target._cellPos)
        if (distNow == null) distNow = 99
        var maxWeapRange = 0
        for (var wRangeId in mapKeys(this._arsenal.playerEquippedWeapons)) {
            var wRangeObj = this._arsenal.playerEquippedWeapons[wRangeId]
            if (wRangeObj != null && wRangeObj._maxRange > maxWeapRange) maxWeapRange = wRangeObj._maxRange
        }
        // Will skip offensive buffs if even after move + jump (3) we won't be
        // within ~2 turns of weapon range. 2-turn horizon ≈ 2*(mp+3) cells.
        var engagementHorizon = maxWeapRange + 2 * (mpBudget + 3)
        var skipOffensiveBuffs = (distNow > engagementHorizon)

        if (!skipOffensiveBuffs && str > 400 && agi > 400 &&
            (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_MIRROR) ||
             mapContainsKey(this._arsenal.playerEquippedChips, CHIP_THORN) ||
             mapContainsKey(this._arsenal.playerEquippedChips, CHIP_BRAMBLE))) {
            var tpSterBR = getCachedChipCost(CHIP_STEROID)
            if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_STEROID) &&
                getCooldown(CHIP_STEROID, this._player._id) == 0 &&
                tpBudget >= tpSterBR) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_STEROID, -1, this._player))
                tpBudget -= tpSterBR
                buffApplied = true
            }
            var tpWarmBR = getCachedChipCost(CHIP_WARM_UP)
            if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_WARM_UP) &&
                getCooldown(CHIP_WARM_UP, this._player._id) == 0 &&
                tpBudget >= tpWarmBR) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_WARM_UP, -1, this._player))
                tpBudget -= tpWarmBR
                buffApplied = true
            }
        } else if (!skipOffensiveBuffs && mag > str && mag > agi) {
            var tpKnowBA = getCachedChipCost(CHIP_KNOWLEDGE)
            if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_KNOWLEDGE) &&
                getCooldown(CHIP_KNOWLEDGE, this._player._id) == 0 &&
                tpBudget >= tpKnowBA) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_KNOWLEDGE, -1, this._player))
                tpBudget -= tpKnowBA
                buffApplied = true
            }
        } else if (!skipOffensiveBuffs && str > mag && str > agi) {
            var tpSterBA = getCachedChipCost(CHIP_STEROID)
            if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_STEROID) &&
                getCooldown(CHIP_STEROID, this._player._id) == 0 &&
                tpBudget >= tpSterBA) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_STEROID, -1, this._player))
                tpBudget -= tpSterBA
                buffApplied = true
            }
        } else if (!skipOffensiveBuffs && agi > str && agi > mag) {
            var tpWarmBA = getCachedChipCost(CHIP_WARM_UP)
            if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_WARM_UP) &&
                getCooldown(CHIP_WARM_UP, this._player._id) == 0 &&
                tpBudget >= tpWarmBA) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_WARM_UP, -1, this._player))
                tpBudget -= tpWarmBA
                buffApplied = true
            }
        }

        var hasShield = this._player.hasEffect(EFFECT_ABSOLUTE_SHIELD) || this._player.hasEffect(EFFECT_RELATIVE_SHIELD)
        var tpFortressBR = getCachedChipCost(CHIP_FORTRESS)
        var tpWallBR = getCachedChipCost(CHIP_WALL)
        if (!hasShield && tpBudget >= tpWallBR) {
            if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_FORTRESS) &&
                getCooldown(CHIP_FORTRESS, this._player._id) == 0 &&
                tpBudget >= tpFortressBR) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_FORTRESS, -1, this._player))
                tpBudget -= tpFortressBR
            } else if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_WALL) &&
                getCooldown(CHIP_WALL, this._player._id) == 0 &&
                tpBudget >= tpWallBR) {
                push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_WALL, -1, this._player))
                tpBudget -= tpWallBR
            }
        }

        var approachCell = this.getApproachEnemyCell(mpBudget)
        var postMoveCell = (approachCell != null && approachCell != -1) ? approachCell : this._player._cellPos
        if (approachCell != null && approachCell != -1) {
            push(actions, new Action(Action.MOVEMENT_APPROACH, -1, -1, approachCell, this._target))
        }

        // Closing-distance Jump: when out of attack range, every cell counts.
        // Jump (range 1-3 line) lets us close 1-3 cells for TP not MP — pure
        // gain when MP can't get us into range. Save BuffApproach's TP for this.
        var jumpCostBA = getCachedChipCost(CHIP_JUMP)
        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_JUMP) &&
            getCooldown(CHIP_JUMP, this._player._id) == 0 &&
            tpBudget >= jumpCostBA) {
            var jumpTargetBA = -1
            // Tiered ranking (same scheme as parametric scenario): A=REACH_HIT,
            // B=HIDE (denied/low HP), C=APPROACH, D=ANY. TP doesn't carry — if
            // any reachable cell exists, commit; pick highest-utility tier.
            var origDistBA = getCellDistance(postMoveCell, this._target._cellPos)
            if (origDistBA == null) origDistBA = 99
            var maxWRBA = 0
            for (var wIdBA in mapKeys(this._arsenal.playerEquippedWeapons)) {
                var wObjBA = this._arsenal.playerEquippedWeapons[wIdBA]
                if (wObjBA != null && wObjBA._maxRange > maxWRBA) maxWRBA = wObjBA._maxRange
            }
            var deniedBA = this._player.hasEffect(EFFECT_SHACKLE_TP)
                || this._player.hasEffect(EFFECT_SHACKLE_STRENGTH)
                || this._player.hasEffect(EFFECT_SHACKLE_MAGIC)
            var lowHPBA = (this._player._currHealth * 100 / max(1, this._player._maxHealth)) < 60
            var enemyMPBA = this._target._currMp
            if (enemyMPBA == null) enemyMPBA = 5
            var kiteHorizonBA = maxWRBA + enemyMPBA
            var bestTierBA = 5
            var bestMetricBA = 99999
            var pmX = getCellX(postMoveCell)
            var pmY = getCellY(postMoveCell)
            for (var jdx = -3; jdx <= 3; jdx++) {
                for (var jdy = -3; jdy <= 3; jdy++) {
                    if (jdx == 0 && jdy == 0) continue
                    if (abs(jdx) + abs(jdy) > 3) continue
                    var jCand = getCellFromXY(pmX + jdx, pmY + jdy)
                    if (jCand == null || jCand < 0) continue
                    if (isObstacle(jCand) || isEntity(jCand)) continue
                    var jDist = getCellDistance(postMoveCell, jCand)
                    if (jDist == null || jDist < 1 || jDist > 3) continue
                    var toEnemy = getCellDistance(jCand, this._target._cellPos)
                    if (toEnemy == null) continue
                    var hasLosBA = lineOfSight(jCand, this._target._cellPos)
                    var tierBA = 4
                    var metricBA = toEnemy
                    if (hasLosBA && toEnemy >= 1 && toEnemy <= maxWRBA) {
                        tierBA = 1
                    } else if ((deniedBA || lowHPBA) && !hasLosBA) {
                        tierBA = 2
                        metricBA = abs(toEnemy - max(2, maxWRBA - 2))
                    } else if (origDistBA - toEnemy >= 2 && toEnemy <= kiteHorizonBA) {
                        tierBA = 3
                        metricBA = toEnemy + getAdversarialThreat(jCand) / 100.0
                    }
                    if (tierBA < bestTierBA || (tierBA == bestTierBA && metricBA < bestMetricBA)) {
                        bestTierBA = tierBA
                        bestMetricBA = metricBA
                        jumpTargetBA = jCand
                    }
                }
            }
            if (bestTierBA > 3) jumpTargetBA = -1
            if (jumpTargetBA != -1) {
                push(actions, new Action(Action.ACTION_TELEPORT, -1, CHIP_JUMP, jumpTargetBA, this._target))
                tpBudget -= jumpCostBA
            }
        }

        if (count(actions) > 0) {
            return actions
        }

        return null
    }

    createCrystalSlideScenario(tp, mp) {
        if (_bossTargetEID == null || _myCrystalSolved) {
            return null
        }
        if (_graalEntity == null) {
            return null
        }

        var primaryDir = getDirectionToSlide(null)
        if (primaryDir == null) {
            return null
        }

        var directions = [primaryDir]
        var altDir = (primaryDir == "pull") ? "push" : "pull"
        push(directions, altDir)

        var playerCell = this._player._cellPos

        for (var direction in directions) {
            var slideChip = (direction == "pull") ? CHIP_GRAPPLE : CHIP_BOXING_GLOVE
            var minDist = (direction == "pull") ? 1 : 2
            var maxDist = 8

            if (!mapContainsKey(this._arsenal.playerEquippedChips, slideChip)) {
                continue
            }

            var chipCost = getCachedChipCost(slideChip)
            if (tp < chipCost) {
                continue
            }

            var distToCrystal = getCellDistance(playerCell, _myCrystalCell)
            var onSameLine = isOnSameLine(playerCell, _myCrystalCell)
            var inRange = distToCrystal != null && distToCrystal >= minDist && distToCrystal <= maxDist

            if (inRange && onSameLine) {
                var correctSide = this.checkCorrectSide(playerCell, null, direction)
                if (correctSide) {
                    var actions = []
                    push(actions, new Action(Action.ACTION_DEBUFF, -1, slideChip, _myCrystalCell, this._target))
                    return actions
                }
            }

            var posCell = this.findSlidePositionCell(null, direction, mp)
            if (posCell != null && posCell != -1) {
                var moveCost = getGraphMPCost(posCell)
                if (moveCost != null && moveCost < 999 && moveCost <= mp) {
                    var actions = []
                    push(actions, new Action(Action.MOVEMENT_APPROACH, -1, -1, posCell, this._target))
                    push(actions, new Action(Action.ACTION_DEBUFF, -1, slideChip, _myCrystalCell, this._target))
                    return actions
                }
            }
        }

        return null
    }

    createMultiSlideScenario(tp, mp) {
        if (_bossTargetEID == null || _myCrystalSolved) return null
        if (_graalEntity == null) return null

        var primaryDir = getDirectionToSlide(null)
        if (primaryDir == null) return null

        var playerCell = this._player._cellPos
        var distToCrystal = getCellDistance(playerCell, _myCrystalCell)
        var onSameLine = isOnSameLine(playerCell, _myCrystalCell)
        if (!onSameLine || distToCrystal == null) return null

        var directions = [primaryDir]
        var altDir = (primaryDir == "pull") ? "push" : "pull"
        push(directions, altDir)

        for (var direction in directions) {
            var slideChip = (direction == "pull") ? CHIP_GRAPPLE : CHIP_BOXING_GLOVE
            if (!mapContainsKey(this._arsenal.playerEquippedChips, slideChip)) continue

            var minDist = (direction == "pull") ? 1 : 2
            if (distToCrystal < minDist || distToCrystal > 8) continue
            if (!this.checkCorrectSide(playerCell, null, direction)) continue

            var chipCost = getCachedChipCost(slideChip)
            var maxUsesPerRound = 4

            var actions = []
            var tpBudget = tp
            var usesAdded = 0

            while (tpBudget >= chipCost && usesAdded < maxUsesPerRound) {
                push(actions, new Action(Action.ACTION_DEBUFF, -1, slideChip, _myCrystalCell, this._target))
                tpBudget -= chipCost
                usesAdded++
            }

            if (usesAdded > 1) return actions
        }

        return null
    }

    createCrystalInversionScenario(tp, mp) {
        if (_bossTargetEID == null || _myCrystalSolved) return null
        if (_graalEntity == null) return null
        if (_usedInversion) return null

        var distToAxis = getDistanceToAxis(null)
        if (distToAxis <= 8) return null

        if (!mapContainsKey(this._arsenal.playerEquippedChips, CHIP_INVERSION)) return null

        var chipCost = getCachedChipCost(CHIP_INVERSION)
        if (tp < chipCost) return null

        var actions = []
        var playerCell = this._player._cellPos
        var dist = getCellDistance(playerCell, _myCrystalCell)

        if (dist != null && dist >= 1 && dist <= 14 && getCachedLineOfSight(playerCell, _myCrystalCell)) {
            push(actions, new Action(Action.ACTION_DEBUFF, -1, CHIP_INVERSION, _myCrystalCell, this._target))
            return actions
        }

        if (mp <= 0) return null

        var reachableCells = getReachableCells()
        var bestCell = -1
        var bestDist = 999

        for (var cellId in reachableCells) {
            var d = getCellDistance(cellId, _myCrystalCell)
            if (d == null || d < 1 || d > 14) continue
            if (!getCachedLineOfSight(cellId, _myCrystalCell)) continue
            var pathCost = getGraphMPCost(cellId)
            if (pathCost >= 999 || pathCost > mp) continue
            if (d < bestDist) {
                bestDist = d
                bestCell = cellId
            }
        }

        if (bestCell == -1) return null

        push(actions, new Action(Action.MOVEMENT_APPROACH, -1, -1, bestCell, this._target))
        push(actions, new Action(Action.ACTION_DEBUFF, -1, CHIP_INVERSION, _myCrystalCell, this._target))

        return actions
    }

    createCrystalApproachScenario(tp, mp) {
        if (_bossTargetEID == null || _myCrystalSolved) return null
        if (_graalEntity == null) return null
        if (mp <= 0) return null

        var primaryDir = getDirectionToSlide(null)
        if (primaryDir == null) return null

        var actions = []
        var tpBudget = tp
        var mpBudget = mp

        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_LEATHER_BOOTS) &&
            getCooldown(CHIP_LEATHER_BOOTS, this._player._id) == 0 &&
            tpBudget >= getCachedChipCost(CHIP_LEATHER_BOOTS)) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_LEATHER_BOOTS, -1, this._player))
            tpBudget -= getCachedChipCost(CHIP_LEATHER_BOOTS)
            mpBudget += 2
        }

        var directions = [primaryDir]
        var altDir = (primaryDir == "pull") ? "push" : "pull"
        push(directions, altDir)

        for (var direction in directions) {
            var slideChip = (direction == "pull") ? CHIP_GRAPPLE : CHIP_BOXING_GLOVE
            if (!mapContainsKey(this._arsenal.playerEquippedChips, slideChip)) continue

            var posCell = this.findSlidePositionCell(null, direction, mpBudget)
            if (posCell != null && posCell != -1) {
                push(actions, new Action(Action.MOVEMENT_APPROACH, -1, -1, posCell, this._target))
                if (count(actions) > 0) return actions
            }

            var idealCell = findIdealSlideCell(null, direction, this._player._cellPos)
            if (idealCell != -1) {
                push(actions, new Action(Action.MOVEMENT_APPROACH, -1, -1, idealCell, this._target))
                if (count(actions) > 0) return actions
            }
        }

        var approachCell = this.getApproachEnemyCell(mpBudget)
        if (approachCell != null && approachCell != -1) {
            push(actions, new Action(Action.MOVEMENT_APPROACH, -1, -1, approachCell, this._target))
        }

        if (count(actions) > 0) return actions
        return null
    }

    createPuzzleDefenseScenario(tp, mp) {
        var actions = []
        var tpBudget = tp

        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_FORTRESS) &&
            getCooldown(CHIP_FORTRESS, this._player._id) == 0 &&
            tpBudget >= getCachedChipCost(CHIP_FORTRESS)) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_FORTRESS, -1, this._player))
            tpBudget -= getCachedChipCost(CHIP_FORTRESS)
        }

        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_WALL) &&
            getCooldown(CHIP_WALL, this._player._id) == 0 &&
            tpBudget >= getCachedChipCost(CHIP_WALL)) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_WALL, -1, this._player))
            tpBudget -= getCachedChipCost(CHIP_WALL)
        }

        if (mapContainsKey(this._arsenal.playerEquippedChips, CHIP_ARMORING) &&
            getCooldown(CHIP_ARMORING, this._player._id) == 0 &&
            tpBudget >= getCachedChipCost(CHIP_ARMORING)) {
            push(actions, new Action(Action.ACTION_BUFF, -1, CHIP_ARMORING, -1, this._player))
            tpBudget -= getCachedChipCost(CHIP_ARMORING)
        }

        var hpRatio = this._player._currHealth / this._player._maxHealth
        if (hpRatio < 0.8) {
            var healAction = this.getHealingAction(tpBudget, 0.8)
            if (healAction != null) {
                push(actions, healAction)
            }
        }

        if (count(actions) > 0) return actions
        return null
    }

    checkCorrectSide(playerCell, crystal, direction) {
        var pcx = getCellX(playerCell)
        var pcy = getCellY(playerCell)
        var cx = _myCrystalX
        var cy = _myCrystalY
        var gx = _graalX
        var gy = _graalY
        var axis = _myCrystalGoalAxis

        if (axis == "north" || axis == "south") {
            if (direction == "pull") {
                return (cx < gx && pcx > cx) || (cx > gx && pcx < cx)
            } else {
                return (cx < gx && pcx < cx) || (cx > gx && pcx > cx)
            }
        } else {
            if (direction == "pull") {
                return (cy < gy && pcy > cy) || (cy > gy && pcy < cy)
            } else {
                return (cy < gy && pcy < cy) || (cy > gy && pcy > cy)
            }
        }
    }

    findSlidePositionCell(crystal, direction, mpBudget) {
        var minDist = (direction == "pull") ? 1 : 2
        var maxDist = 8

        var reachableCells = getReachableCells()
        if (reachableCells == null || count(reachableCells) == 0) return -1

        var bestCell = -1
        var bestCost = 999

        for (var cellId in reachableCells) {
            if (!isOnSameLine(cellId, _myCrystalCell)) continue

            var dist = getCellDistance(cellId, _myCrystalCell)
            if (dist == null || dist < minDist || dist > maxDist) continue

            if (!this.checkCorrectSide(cellId, crystal, direction)) continue

            if (isEntity(cellId) && cellId != this._player._cellPos) continue

            var pathCost = getGraphMPCost(cellId)
            if (pathCost >= 999 || pathCost > mpBudget) continue

            if (pathCost < bestCost) {
                bestCost = pathCost
                bestCell = cellId
            }
        }

        return bestCell
    }
}
