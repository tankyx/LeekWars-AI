

class ThreatPrediction {
    maxDamage = 0
    enemyId = -1
    enemyName = ""
    assumedPosition = -1
    weaponId = -1
    chipId = -1
    confidence = 1.0
}

// Returns the enemy's effective MP next turn, accounting for movement-buff
// chips they could cast (Leather Boots +2, Seven League Boots +3) given
// current TP and cooldown. Threat cache was previously using raw _currMp,
// so a 6-MP enemy with Leather Boots ready was modeled as reaching 6 cells
// when they actually reach 8 — letting us walk into "safe" cells they tap.
function getEffectiveEnemyMP(enemy) {
    var mp = enemy._currMp
    var tp = enemy._currTp
    var chips = getChips(enemy._id)
    var bonus = 0
    // Prefer Seven League Boots (+3) when both available.
    if (inArray(chips, CHIP_SEVEN_LEAGUE_BOOTS) &&
        getCooldown(CHIP_SEVEN_LEAGUE_BOOTS, enemy._id) == 0) {
        var slbCost = getChipCost(CHIP_SEVEN_LEAGUE_BOOTS)
        if (slbCost != null && tp >= slbCost) bonus = 3
    }
    if (bonus < 2 && inArray(chips, CHIP_LEATHER_BOOTS) &&
        getCooldown(CHIP_LEATHER_BOOTS, enemy._id) == 0) {
        var lbCost = getChipCost(CHIP_LEATHER_BOOTS)
        if (lbCost != null && tp >= lbCost) {
            if (bonus < 2) bonus = 2
        }
    }
    return mp + bonus
}

// Returns the set of cells an entity can teleport/jump to on their next turn,
// given current TP and cooldowns. These are "blink" landing cells that bypass
// MP-walking entirely. Used for enemy threat reach AND for the player cover
// heatmap (to mark cells we could land on via JUMP/TELEPORTATION).
function getEntityBlinkCells(enemy) {
    var blinkCells = []
    var tp = enemy._currTp
    var chips = getChips(enemy._id)
    var origin = enemy._cellPos

    var ranges = []
    if (inArray(chips, CHIP_TELEPORTATION) &&
        getCooldown(CHIP_TELEPORTATION, enemy._id) == 0) {
        var tCost = getChipCost(CHIP_TELEPORTATION)
        if (tCost != null && tp >= tCost) {
            push(ranges, ['min': getChipMinRange(CHIP_TELEPORTATION),
                          'max': getChipMaxRange(CHIP_TELEPORTATION)])
        }
    }
    if (inArray(chips, CHIP_JUMP) &&
        getCooldown(CHIP_JUMP, enemy._id) == 0) {
        var jCost = getChipCost(CHIP_JUMP)
        if (jCost != null && tp >= jCost) {
            push(ranges, ['min': getChipMinRange(CHIP_JUMP),
                          'max': getChipMaxRange(CHIP_JUMP)])
        }
    }
    if (count(ranges) == 0) return blinkCells

    // Iterate the board once; cheaper than two passes when both chips are up.
    for (var c = 0; c < 613; c++) {
        if (isObstacle(c)) continue
        if (isEntity(c)) continue
        if (c == origin) continue
        var d = getCellDistance(origin, c)
        if (d == null) continue
        var inRange = false
        for (var r = 0; r < count(ranges); r++) {
            if (d >= ranges[r]['min'] && d <= ranges[r]['max']) { inRange = true; break }
        }
        if (!inRange) continue
        if (!getCachedLineOfSight(origin, c)) continue
        push(blinkCells, c)
    }
    return blinkCells
}

function predictEnemyThreatAtCell(targetCell, enemy, player, arsenal) {

    var prediction = new ThreatPrediction()
    prediction.enemyId = enemy._id
    prediction.enemyName = getName(enemy._id)
    prediction.assumedPosition = enemy._cellPos

    var enemyWeapons = getWeapons(enemy._id)
    var enemyChips = getChips(enemy._id)
    // Effective MP accounts for boots they could cast this turn (+2/+3).
    var enemyMP = getEffectiveEnemyMP(enemy)
    var enemyTP = enemy._currTp

    var currentPosDamage = calculateBestAttackDamage(
        enemy._cellPos, targetCell, enemy, enemyWeapons, enemyChips, enemyTP
    )

    var maxDamageAfterMovement = currentPosDamage
    var bestPosition = enemy._cellPos

    if (enemyMP > 0) {
        var searchRadius = min(enemyMP, 11)

        for (var dx = -searchRadius; dx <= searchRadius; dx++) {
            for (var dy = -searchRadius; dy <= searchRadius; dy++) {
                var dist = abs(dx) + abs(dy)
                if (dist == 0 || dist > searchRadius) continue

                var testCell = enemy._cellPos + 18 * dx + 17 * dy
                if (testCell < 0 || testCell >= 613) continue
                if (isObstacle(testCell)) continue

                var pathLen = getCachedPathLength(enemy._cellPos, testCell)
                if (pathLen == null || pathLen > enemyMP) continue

                var testDamage = calculateBestAttackDamage(
                    testCell, targetCell, enemy, enemyWeapons, enemyChips, enemyTP
                )

                if (testDamage > maxDamageAfterMovement) {
                    maxDamageAfterMovement = testDamage
                    bestPosition = testCell
                }
            }
        }
    }

    // Blink cells (teleport/jump): bypass MP. Bound separately since they're
    // typically a small set and LoS-validated already.
    var blinkCells = getEntityBlinkCells(enemy)
    for (var bi = 0; bi < count(blinkCells); bi++) {
        var bCell = blinkCells[bi]
        var bDmg = calculateBestAttackDamage(bCell, targetCell, enemy, enemyWeapons, enemyChips, enemyTP)
        if (bDmg > maxDamageAfterMovement) {
            maxDamageAfterMovement = bDmg
            bestPosition = bCell
        }
    }

    var enemyCritChance = min(0.5, enemy._agility / 2000.0)
    var enemyCritMult = 1.0 + enemyCritChance * 0.3
    maxDamageAfterMovement *= enemyCritMult

    prediction.maxDamage = maxDamageAfterMovement
    prediction.assumedPosition = bestPosition
    prediction.confidence = (bestPosition == enemy._cellPos) ? 1.0 : 0.8

    return prediction
}

function calculateBestAttackDamage(fromCell, targetCell, enemy, weapons, chips, availableTP) {

    var dist = getCellDistance(fromCell, targetCell)
    if (dist == null) return 0

    // Collect all viable attack options. Previously this returned max() over a
    // single weapon OR single chip — which under-counted multi-chip burst
    // enemies (Nexayn2 iceberg+stalactite+rockfall pattern: each chip ~567/432/
    // 380, max=567, actual stackable = 1379). LR moved into a "max threat 567"
    // cell thinking it was survivable; died to the combined burst.
    //
    // New model: greedy-fill within enemy TP budget. Sort attacks by damage
    // descending, take each in order until TP runs out. Slight over-estimate
    // vs ideal MILP (ignores swap costs between weapons, and assumes all
    // chips off CD), but right-direction conservative for threat assessment.
    var hasLos = lineOfSight(fromCell, targetCell)
    var attacks = []

    for (var weaponId in weapons) {
        var minRange = getWeaponMinRange(weaponId)
        var maxRange = getWeaponMaxRange(weaponId)
        var weaponCost = getWeaponCost(weaponId)
        var maxUses = getWeaponMaxUses(weaponId)

        if (dist < minRange || dist > maxRange) continue
        if (!hasLos) continue
        if (weaponCost <= 0) continue

        var effects = getWeaponEffects(weaponId)
        var baseDmg = 0
        for (var eff in effects) {
            if (eff[0] == EFFECT_DAMAGE) {
                baseDmg = (eff[1] + eff[2]) / 2
                break
            }
        }
        if (baseDmg <= 0) continue

        var scaledDmg = baseDmg * (1 + enemy._strength / 100)
        push(attacks, [scaledDmg, weaponCost, true, maxUses])
    }

    for (var chipId in chips) {
        var minRange = getChipMinRange(chipId)
        var maxRange = getChipMaxRange(chipId)
        var chipCost = getChipCost(chipId)

        if (dist < minRange || dist > maxRange) continue
        if (chipCost > availableTP) continue
        if (chipCost <= 0) continue

        var effects = getChipEffects(chipId)
        var baseDmg = 0
        for (var eff in effects) {
            if (eff[0] == EFFECT_DAMAGE) {
                baseDmg = (eff[1] + eff[2]) / 2
                break
            }
        }
        if (baseDmg <= 0) continue

        var scaledDmg = baseDmg * (1 + max(enemy._strength, enemy._magic) / 100)
        push(attacks, [scaledDmg, chipCost, false, 1])
    }

    if (count(attacks) == 0) return 0

    arraySort(attacks, function(a, b) {
        if (a[0] > b[0]) return -1
        if (a[0] < b[0]) return 1
        return 0
    })

    var totalDamage = 0
    var remainingTP = availableTP
    for (var atk in attacks) {
        if (remainingTP <= 0) break
        var aDmg = atk[0]
        var aCost = atk[1]
        var aIsWeapon = atk[2]
        var aUses = atk[3]
        var uses = aIsWeapon ? min(aUses, floor(remainingTP / aCost)) : (remainingTP >= aCost ? 1 : 0)
        if (uses <= 0) continue
        totalDamage += aDmg * uses
        remainingTP -= aCost * uses
    }

    return totalDamage
}

function predictTotalThreatAtCell(targetCell, enemies, player, arsenal) {

    var totalThreat = 0
    var predictions = []

    for (var enemy in enemies) {
        if (isDead(enemy._id)) continue

        var pred = predictEnemyThreatAtCell(targetCell, enemy, player, arsenal)
        totalThreat += pred.maxDamage
        push(predictions, pred)
    }

    return ['total': totalThreat, 'predictions': predictions]
}

function precomputeEnemyReachablePositions(enemy) {
    var positions = [enemy._cellPos]
    // Effective MP factors in Leather Boots (+2) / Seven League Boots (+3)
    // they could cast on their incoming turn given current TP and cooldown.
    var enemyMP = getEffectiveEnemyMP(enemy)
    if (enemyMP > 0) {
        // Cap at 11 to cover base 6 + SLB 3 + Leather 2 in the most extreme
        // case; the pathLen check then gates per actual board topology.
        var searchRadius = min(enemyMP, 11)
        for (var dx = -searchRadius; dx <= searchRadius; dx++) {
            for (var dy = -searchRadius; dy <= searchRadius; dy++) {
                var dist = abs(dx) + abs(dy)
                if (dist == 0 || dist > searchRadius) continue
                var testCell = enemy._cellPos + 18 * dx + 17 * dy
                if (testCell < 0 || testCell >= 613) continue
                if (isObstacle(testCell)) continue
                var pathLen = getCachedPathLength(enemy._cellPos, testCell)
                if (pathLen == null || pathLen > enemyMP) continue
                push(positions, testCell)
            }
        }
    }
    // Merge teleport/jump landing cells — these bypass MP entirely and were
    // previously unmodeled, so a Teleportation-equipped enemy could land in
    // any LoS cell at range 12 while we scored the target as safe.
    var blink = getEntityBlinkCells(enemy)
    for (var b = 0; b < count(blink); b++) {
        push(positions, blink[b])
    }
    return positions
}

function predictEnemyThreatAtCellFast(targetCell, enemy, reachablePositions, enemyWeapons, enemyChips, enemyTP) {
    var maxDamage = 0
    for (var pos in reachablePositions) {
        var dmg = calculateBestAttackDamage(pos, targetCell, enemy, enemyWeapons, enemyChips, enemyTP)
        if (dmg > maxDamage) maxDamage = dmg
    }
    var enemyCritChance = min(0.5, enemy._agility / 2000.0)
    var enemyCritMult = 1.0 + enemyCritChance * 0.3
    return maxDamage * enemyCritMult
}

function buildAdversarialThreatCache(playerObj, enemies, arsenalObj) {
    __adversarialThreatCache = [:]
    __adversarialThreatCacheBuilt = false

    var reachable = getReachableCells()
    var playerCell = playerObj._cellPos
    var cellsToEvaluate = []
    push(cellsToEvaluate, playerCell)
    for (var c in reachable) push(cellsToEvaluate, c)

    var aliveEnemies = []
    for (var eid in mapKeys(enemies)) {
        if (!isDead(eid)) push(aliveEnemies, enemies[eid])
    }

    if (count(aliveEnemies) > 0) {
        if (count(aliveEnemies) > 2) {
            arraySort(aliveEnemies, function(a, b) {
                var da = getCellDistance(playerCell, a._cellPos)
                var db = getCellDistance(playerCell, b._cellPos)
                if (da == null) da = 999
                if (db == null) db = 999
                return da - db
            })
            aliveEnemies = [aliveEnemies[0], aliveEnemies[1]]
        }

        // Pre-compute reachable positions and equipment per enemy (Phase 3.1)
        var enemyData = []
        for (var enemy in aliveEnemies) {
            push(enemyData, [
                'enemy': enemy,
                'positions': precomputeEnemyReachablePositions(enemy),
                'weapons': getWeapons(enemy._id),
                'chips': getChips(enemy._id),
                'tp': enemy._currTp
            ])
        }

        for (var i = 0; i < count(cellsToEvaluate); i++) {
            if (getOperations() > _ops71) break
            var evalCell = cellsToEvaluate[i]
            var totalThreat = 0
            for (var ed in enemyData) {
                totalThreat += predictEnemyThreatAtCellFast(
                    evalCell, ed['enemy'], ed['positions'],
                    ed['weapons'], ed['chips'], ed['tp']
                )
            }
            __adversarialThreatCache[evalCell] = totalThreat
        }
        __adversarialThreatCacheBuilt = true
    }
}

function getAdversarialThreat(cell) {
    if (!__adversarialThreatCacheBuilt) return 0
    if (mapContainsKey(__adversarialThreatCache, cell)) return __adversarialThreatCache[cell]
    return 0
}

function calculateTPReservation(player, enemies) {

    var hpPercent = (player._currHealth * 100) / player._maxHealth
    var reservation = ['reserved': 0, 'reason': "none", 'action': -1]

    if (hpPercent >= 50) {
        return reservation
    }

    if (hpPercent < 30) {
        var emergencyTeleChip = null
        for (var chip in player._chips) {
            if (chip == CHIP_TELEPORTATION || chip == CHIP_JUMP) {
                emergencyTeleChip = chip
                break
            }
        }

        if (emergencyTeleChip != null) {
            var tpCost = getChipCost(emergencyTeleChip)
            reservation['reserved'] = tpCost
            reservation['reason'] = "emergency_teleport"
            reservation['action'] = emergencyTeleChip
            return reservation
        }
    }

    if (hpPercent < 40) {
        var hasRemission = false
        var hasFortress = false

        for (var chip in player._chips) {
            if (chip == CHIP_REMISSION) hasRemission = true
            if (chip == CHIP_FORTRESS) hasFortress = true
        }

        var reserveAmount = 0
        if (hasRemission) reserveAmount += getChipCost(CHIP_REMISSION)
        if (hasFortress) reserveAmount += getChipCost(CHIP_FORTRESS)

        if (reserveAmount > 0) {
            reservation['reserved'] = reserveAmount
            reservation['reason'] = "heal_shield_combo"
            reservation['action'] = CHIP_REMISSION
            return reservation
        }
    }

    return reservation
}

function shouldReserveTP(player, enemies) {
    var hpPercent = (player._currHealth * 100) / player._maxHealth
    return hpPercent < 40
}

function calculate2TurnKill(player, target, arsenal, availableTP) {

    var result = ['viable': false, 'debuffCost': 0, 'expectedKillTP': 0, 'confidence': 0.0]

    var targetHP = target._currHealth
    if (targetHP <= 0) return result

    var directDamageThisTurn = calculateMaxDirectDamage(player, target, arsenal, availableTP)

    if (directDamageThisTurn >= targetHP) {
        result['viable'] = false
        result['confidence'] = 0.0
        return result
    }

    var debuffOptions = analyzeDebuffOptions(player, target, arsenal)

    if (count(debuffOptions) == 0) return result

    for (var opt in debuffOptions) {
        var debuffCost = opt['tpCost']
        var damageAmplification = opt['amplification']

        var remainingTP = availableTP - debuffCost

        var thisTurnDamage = calculateMaxDirectDamage(player, target, arsenal, remainingTP)

        var nextTurnTP = player._maxTp

        var nextTurnDamage = calculateMaxDirectDamage(player, target, arsenal, nextTurnTP) * damageAmplification

        var totalDamage = thisTurnDamage + nextTurnDamage

        if (totalDamage >= targetHP * 0.9) {
            result['viable'] = true
            result['debuffCost'] = debuffCost
            result['expectedKillTP'] = nextTurnTP
            result['confidence'] = min(1.0, totalDamage / targetHP)
            return result
        }
    }

    return result
}

function calculateMaxDirectDamage(player, target, arsenal, availableTP) {

    var maxDamage = 0

    for (var weaponId in mapKeys(arsenal.playerEquippedWeapons)) {
        var weapon = arsenal.playerEquippedWeapons[weaponId]
        var cost = weapon._cost
        var maxUses = weapon._maxUse

        var possibleUses = min(maxUses, floor(availableTP / cost))
        if (possibleUses <= 0) continue

        var damagePerUse = arsenal.getNetDamageAgainstTarget(
            player._strength, player._magic, player._wisdom,
            player._science, weaponId, target
        )

        var totalDamage = damagePerUse * possibleUses
        if (totalDamage > maxDamage) {
            maxDamage = totalDamage
        }
    }

    return maxDamage
}

function analyzeDebuffOptions(player, target, arsenal) {
    var options = []

    var playerWeapons = getWeapons()
    var playerChips = getChips()

    var hasNeutrino = false
    for (var wpn in playerWeapons) {
        if (wpn == WEAPON_NEUTRINO) {
            hasNeutrino = true
            break
        }
    }

    if (hasNeutrino) {
        var neutrinoCost = getWeaponCost(WEAPON_NEUTRINO)
        push(options, [
            'chip': WEAPON_NEUTRINO,
            'tpCost': neutrinoCost * 3,
            'amplification': 1.24,
            'stacks': 3
        ])
    }

    var hasLiberation = false
    for (var chip in playerChips) {
        if (chip == CHIP_LIBERATION) {
            hasLiberation = true
            break
        }
    }

    if (hasLiberation && (target._absShield > 50 || target._relShield > 20)) {
        var liberationCost = getChipCost(CHIP_LIBERATION)
        var amplification = 1.0 + (target._relShield / 100)
        push(options, [
            'chip': CHIP_LIBERATION,
            'tpCost': liberationCost,
            'amplification': amplification,
            'stacks': 1
        ])
    }

    return options
}

function getSafeOffensiveTP(player, enemies) {
    var reservation = calculateTPReservation(player, enemies)
    return player._currTp - reservation['reserved']
}

function isPredictedSurvivable(cell, enemies, player, arsenal) {
    var threatData = predictTotalThreatAtCell(cell, enemies, player, arsenal)
    var predictedThreat = threatData['total']

    var safetyMargin = 1.2
    return (predictedThreat * safetyMargin) < player._currHealth
}

// Phase O: estimate how many turns until the player can land a shot on the
// target. Returns:
//   0 — current cell has a clean shot (range+LoS+positive dmg)
//   1 — after-move (MP) or JUMP this turn produces a shot
//   2 — 2-ply reach (an MP-reachable cell can next-turn-MP into a shot)
//   3 — further away than 2 turns (treat as "stuck/far")
// Used by the scorer to:
//   (a) decay offensive-buff value when buffs would expire before any shot
//   (b) reward closing moves when we need to traverse multiple turns
// Skips GL splash optimization for simplicity — Phase L already handles
// fine-grained fire-cell discovery; this is a coarse classifier.
function _canShootAtTargetFrom(cell, target, weaponIds, damageChipIds, arsenalObj) {
    var d = getCellDistance(cell, target._cellPos)
    if (d == null) return false

    for (var wid in weaponIds) {
        var w = arsenalObj.playerEquippedWeapons[wid]
        if (d < w._minRange || d > w._maxRange) continue
        if (w._launchType == LAUNCH_TYPE_LINE && !fieldMap.isOnSameLine(cell, target._cellPos)) continue
        if (!lineOfSight(cell, target._cellPos)) continue
        return true
    }

    for (var cid in damageChipIds) {
        var c = arsenalObj.playerEquippedChips[cid]
        if (d < c._minRange || d > c._maxRange) continue
        if (!lineOfSight(cell, target._cellPos)) continue
        return true
    }

    return false
}

function estimateNearestFireTurn(playerObj, targetObj, arsenalObj) {
    if (targetObj == null) return 3

    var weaponIds = mapKeys(arsenalObj.playerEquippedWeapons)

    var damageChipIds = []
    for (var cid in mapKeys(arsenalObj.playerEquippedChips)) {
        if (isPoisonChip(cid) || isDebuffChip(cid)) continue
        var cobj = arsenalObj.playerEquippedChips[cid]
        if (cobj == null) continue
        var bd = getCachedDamageBreakdown(cid)
        if (bd != null && (bd['direct'] > 0 || bd['nova'] > 0)) push(damageChipIds, cid)
    }

    if (_canShootAtTargetFrom(playerObj._cellPos, targetObj, weaponIds, damageChipIds, arsenalObj)) return 0

    var mpCells = fieldMap.getReachableCellsWithinMP(playerObj._cellPos, playerObj._currMp)
    for (var c in mpCells) {
        if (_canShootAtTargetFrom(c, targetObj, weaponIds, damageChipIds, arsenalObj)) return 1
    }

    var hasJump = mapContainsKey(arsenalObj.playerEquippedChips, CHIP_JUMP) &&
                  getCooldown(CHIP_JUMP, playerObj._id) == 0
    if (hasJump) {
        var pX = getCellX(playerObj._cellPos)
        var pY = getCellY(playerObj._cellPos)
        for (var jdx = -3; jdx <= 3; jdx++) {
            for (var jdy = -3; jdy <= 3; jdy++) {
                if (jdx == 0 && jdy == 0) continue
                if (abs(jdx) + abs(jdy) > 3) continue
                var jc = getCellFromXY(pX + jdx, pY + jdy)
                if (jc == null || jc < 0) continue
                if (isObstacle(jc) || isEntity(jc)) continue
                if (_canShootAtTargetFrom(jc, targetObj, weaponIds, damageChipIds, arsenalObj)) return 1
            }
        }
    }

    // 2-ply coarse scan: any cell within currentMP + nextTurnMP that has a shot
    // means we can reach a fire position in 2 turns of plain movement.
    if (getOperations() < _ops79) {
        var farRadius = min(playerObj._currMp + getMP(), 8)
        var pX2 = getCellX(playerObj._cellPos)
        var pY2 = getCellY(playerObj._cellPos)
        for (var dx2 = -farRadius; dx2 <= farRadius; dx2++) {
            for (var dy2 = -farRadius; dy2 <= farRadius; dy2++) {
                if (abs(dx2) + abs(dy2) > farRadius) continue
                if (abs(dx2) + abs(dy2) <= playerObj._currMp) continue  // already covered by MP scan
                var fc = getCellFromXY(pX2 + dx2, pY2 + dy2)
                if (fc == null || fc < 0) continue
                if (isObstacle(fc)) continue
                if (_canShootAtTargetFrom(fc, targetObj, weaponIds, damageChipIds, arsenalObj)) return 2
            }
        }
    }

    return 3
}
