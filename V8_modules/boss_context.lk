
global _bossPhase = null
global _graalEntity = null
global _graalID = -1
global _bossCombatLatched = false
global _crystalMap = [:]
global _myAssignedCrystal = null
global _bossTargetEID = null
global _usedInversion = false
global _isBossFight = false
global _puzzleRole = null
global _puzzleSolverID = -1
global _pzSolverMaxLifeSnapshot = -1
global _pzGatherDone = false
// Committed route edge: reused across turns while the crystal hasn't moved and
// the stand stays free — fresh replans flip between equivalent routes as the
// escort shuffles, wasting whole turns of MP.
global _pzRouteEID = null
global _pzRouteCrystalCell = -1
global _pzRouteStand = -1
global _pzRouteChip = null
global _pzRouteTarget = -1
// Focus crystal: solver sticks to one crystal until solved — "nearest unsolved"
// flips as she walks and the retargeting thrash wastes whole turns
global _pzFocusEID = null
global _pzSolverEverSeen = false
global _pzPartnerSolverID = -1
global _pzPartnerClaimEID = null
global PZ_MSG_FOCUS = 901

global _graalCell = -1
global _graalX = 0
global _graalY = 0
global _myCrystalCell = -1
global _myCrystalX = 0
global _myCrystalY = 0
global _myCrystalColor = null
global _myCrystalGoalAxis = null
global _myCrystalSolved = false

function detectBossFight() {
    var entities = getAliveEnemies()
    for (var eid in entities) {
        var entityType = getName(eid)
        // fennel_king too: lets a graal-less scenario start directly in
        // COMBAT phase (local phase-2 sandbox); real fights have both
        if (entityType == "graal" || entityType == "fennel_king") {
            return true
        }
    }
    return false
}

function initBossContext() {
    _isBossFight = true
    updateBossContext()
}

function updateBossContext() {
    if (!_isBossFight) return

    _graalEntity = null
    _graalCell = -1
    _graalX = 0
    _graalY = 0
    _crystalMap = [:]

    var allEntities = []
    var enemies = getAliveEnemies()
    for (var eid in enemies) {
        push(allEntities, eid)
    }
    var allies = getAliveAllies()
    for (var aid in allies) {
        push(allEntities, aid)
    }

    for (var eid in allEntities) {
        var entityType = getName(eid)
        var cellId = getCell(eid)

        if (entityType == "graal") {
            _graalID = eid
            // Fight 52976869: after the graal self-destructs (puzzle success!)
            // it can linger in the alive list with no cell — treating it as
            // alive kept us in PUZZLE pushing crystals toward getCellFromXY(0,-1)
            // while the now-vulnerable army killed us. Only a graal with a real
            // cell and life counts. Fight 52978013: it passed BOTH checks and
            // we puzzled for 6 dead-graal turns — isAlive() is checked below
            // and the COMBAT latch makes the transition one-way.
            if (cellId == null || cellId < 0) { continue }
            var gLife = getLife(eid)
            if (gLife == null || gLife <= 0) { continue }
            if (!isAlive(eid)) { continue }
            _graalEntity = [
                'id': eid,
                'cell': cellId,
                'x': getCellX(cellId),
                'y': getCellY(cellId)
            ]
            _graalCell = cellId
            _graalX = getCellX(cellId)
            _graalY = getCellY(cellId)
        }
        else if (entityType == "red_crystal" || entityType == "blue_crystal" ||
                 entityType == "yellow_crystal" || entityType == "green_crystal") {
            var color = substring(entityType, 0, indexOf(entityType, "_"))
            var goalAxis = getGoalAxis(color)

            _crystalMap[eid] = [
                'id': eid,
                'color': color,
                'goalAxis': goalAxis,
                'cell': cellId,
                'x': getCellX(cellId),
                'y': getCellY(cellId),
                'solved': false
            ]
        }
    }

    // Direct-id recheck: the alive-enemies enumeration can keep serving the
    // dead graal (name+cell+life all "valid") — trust isAlive on the tracked id
    if (_graalEntity != null && _graalID != -1) {
        if (!isAlive(_graalID)) {
            _graalEntity = null
            _graalCell = -1
            _graalX = 0
            _graalY = 0
        }
    }

    // Mechanic-level truth (fight 52978013: every entity query lied for 6
    // turns): Divine Protection = ADD_STATE effect (type 59) on the army,
    // cast by the graal, gone the moment it dies. No protection => COMBAT.
    if (!_bossCombatLatched && _graalEntity != null && getTurn() > 1) {
        if (!armyHasDivineProtection()) {
            _graalEntity = null
            _graalCell = -1
            _graalX = 0
            _graalY = 0
        }
    }

    if (_bossCombatLatched) {
        _bossPhase = "COMBAT"
    } else if (_graalEntity != null) {
        _bossPhase = "PUZZLE"
    } else {
        _bossPhase = "COMBAT"
        // One-way: a graal that was seen alive and is now gone never comes back
        if (_graalID != -1) { _bossCombatLatched = true }
    }

    if (_bossPhase == "PUZZLE") {
        assignPuzzleRoles()
        if (_puzzleRole == "SOLVER") {
            assignSolverCrystal()
        } else {
            _myAssignedCrystal = null
            _bossTargetEID = null
            clearCrystalScalars()
        }
    } else {
        _puzzleRole = null
        _puzzleSolverID = -1
        _myAssignedCrystal = null
        _bossTargetEID = null
        clearCrystalScalars()
    }
}

function getBossPhase() {
    return _bossPhase
}

function armyHasDivineProtection() {
    var enemies = getAliveEnemies()
    var armySeen = false
    for (var eid in enemies) {
        var n = getName(eid)
        if (n == "graal" || indexOf(n, "crystal") != -1) continue
        armySeen = true
        var effs = getEffects(eid)
        if (effs == null) continue
        for (var e in effs) {
            if (e[0] == 59) { return true }
        }
    }
    // No army at all (local template) — no evidence the graal died
    if (!armySeen) { return true }
    return false
}

function syncCrystalScalars(crystal) {
    _myCrystalCell = crystal['cell']
    _myCrystalX = crystal['x']
    _myCrystalY = crystal['y']
    _myCrystalColor = crystal['color']
    _myCrystalGoalAxis = crystal['goalAxis']
    _myCrystalSolved = crystal['solved']
}

function clearCrystalScalars() {
    _myCrystalCell = -1
    _myCrystalX = 0
    _myCrystalY = 0
    _myCrystalColor = null
    _myCrystalGoalAxis = null
    _myCrystalSolved = false
}

function isCellSolvedForAxis(cell, goalAxis) {
    if (_graalCell == -1 || cell == null || cell < 0) return false
    var cx = getCellX(cell)
    var cy = getCellY(cell)
    if (!checkOnAxis(cx, cy, _graalX, _graalY, goalAxis)) return false
    // The crystal ray passes through entities, only obstacles block it
    // (encyclopedia). lineOfSight() is entity-blocked, so ignore everyone alive.
    return lineOfSight(cell, _graalCell, allAliveEntities())
}

function allAliveEntities() {
    var ids = [getEntity()]
    var enemies = getAliveEnemies()
    for (var e in enemies) push(ids, e)
    var allies = getAliveAllies()
    for (var a in allies) push(ids, a)
    return ids
}

function allyHasChip(eid, chipId) {
    // getChips is the truth. getCooldown(chip) on the SERVER returns a value
    // even for unequipped chips (fight 52978546: 432 warnings of every leek
    // attempting the full generic chip list; local generator returns null so
    // the sandbox never caught it).
    var chips = getChips(eid)
    if (chips == null) { return false }
    return inArray(chips, chipId)
}

// Named solvers carry the puzzle chips (grapple/boxing/inversion). Two solvers
// roughly halve the solve clock — the army's ~2500/turn makes time the enemy.
function isNamedSolver(name) {
    return name == "AdaLovelace" || name == "KurtGodel"
}

function assignPuzzleRoles() {
    if (_bossPhase != "PUZZLE") {
        _puzzleRole = null
        _puzzleSolverID = -1
        _pzPartnerSolverID = -1
        return
    }

    var myID = getEntity()
    var allAllies = [myID]
    var allies = getAliveAllies()
    for (var aid in allies) push(allAllies, aid)

    if (count(allAllies) <= 1) {
        _puzzleRole = "SOLVER"
        _puzzleSolverID = myID
        _pzPartnerSolverID = -1
        return
    }

    // Alive named solvers (cross-entity chip detection is unreliable, so trust
    // the roster; MY OWN role additionally requires a self-verified puzzle chip)
    var solverIDs = []
    for (var aid in allAllies) {
        if (isNamedSolver(getName(aid))) push(solverIDs, aid)
    }
    if (count(solverIDs) > 0) { _pzSolverEverSeen = true }

    // Fallback to first ally ONLY when no named solver ever existed (non-Ada
    // team). If they were here and DIED, nobody else has the chips — a
    // chipless "solver" walks into the castle and dies for nothing (fight
    // 52977149: ED+MH). No solver -> everyone scatters; a kited draw beats a wipe.
    if (count(solverIDs) == 0 && !_pzSolverEverSeen) push(solverIDs, allAllies[0])

    var iAmListed = false
    for (var sid in solverIDs) {
        if (sid == myID) iAmListed = true
    }
    var iHaveChips = allyHasChip(myID, CHIP_GRAPPLE) || allyHasChip(myID, CHIP_BOXING_GLOVE) || allyHasChip(myID, CHIP_INVERSION)

    if (iAmListed && (iHaveChips || count(allAllies) == 1)) {
        _puzzleRole = "SOLVER"
        _puzzleSolverID = myID
        _pzPartnerSolverID = -1
        for (var sid2 in solverIDs) {
            if (sid2 != myID) _pzPartnerSolverID = sid2
        }
        return
    }

    _pzPartnerSolverID = -1
    if (count(solverIDs) == 0) {
        // No solver alive: scatter and survive
        _puzzleRole = "SUPPORT"
        _puzzleSolverID = -1
        return
    }

    // Escort: pair supports to solvers deterministically so both solvers get
    // buffed (support[i] -> solver[i % nSolvers], both sides sorted by id —
    // every leek computes the same pairing independently)
    var supports = []
    for (var aid2 in allAllies) {
        var isSol = false
        for (var sid3 in solverIDs) {
            if (sid3 == aid2) isSol = true
        }
        if (!isSol) push(supports, aid2)
    }
    sort(supports)
    sort(solverIDs)
    var myIdx = 0
    for (var i = 0; i < count(supports); i++) {
        if (supports[i] == myID) myIdx = i
    }
    _puzzleSolverID = solverIDs[myIdx % count(solverIDs)]
    _puzzleRole = getName(myID) == "KurtGodel" ? "BUFFER" : "SUPPORT"
}

function assignSolverCrystal() {
    var myCell = getCell()
    var bestDist = 999
    var bestEID = null

    for (var eid in mapKeys(_crystalMap)) {
        var cData = _crystalMap[eid]
        if (isCrystalSolved(cData)) continue
        var d = getCellDistance(myCell, cData['cell'])
        if (d < bestDist) {
            bestDist = d
            bestEID = eid
        }
    }

    if (bestEID != null) {
        _myAssignedCrystal = _crystalMap[bestEID]
        _bossTargetEID = bestEID
        syncCrystalScalars(_crystalMap[bestEID])
    } else {
        _myAssignedCrystal = null
        _bossTargetEID = null
        clearCrystalScalars()
    }
}

function nearestUnsolvedCrystalTo(cell, excludeEID) {
    var best = null
    var bestD = 9999
    for (var eid in mapKeys(_crystalMap)) {
        if (eid == excludeEID) continue
        var cData = _crystalMap[eid]
        if (isCrystalSolved(cData)) continue
        var cc = getCell(eid)
        if (cc == null || cc < 0) continue
        var d = getCellDistance(cell, cc)
        if (d != null && d < bestD) { bestD = d; best = eid }
    }
    return best
}

// Read the partner solver's announced crystal claim from the message queue.
// The claim is cached globally: getMessages may drain, and the partner only
// re-announces on its own turns.
function readPartnerClaim() {
    if (_pzPartnerSolverID == -1) {
        _pzPartnerClaimEID = null
        return
    }
    var msgs = getMessages()
    for (var m in msgs) {
        if (getMessageAuthor(m) != _pzPartnerSolverID) continue
        if (getMessageType(m) != MESSAGE_CUSTOM) continue
        var p = getMessageParams(m)
        if (p != null && count(p) == 2 && p[0] == PZ_MSG_FOCUS) {
            _pzPartnerClaimEID = p[1]
        }
    }
}

function announceFocus(eid) {
    if (_pzPartnerSolverID != -1 && eid != null) {
        sendAll(MESSAGE_CUSTOM, [PZ_MSG_FOCUS, eid])
    }
}

function pickFocusCrystal(myCell) {
    var myID = getEntity()
    var partner = _pzPartnerSolverID
    var partnerAlive = partner != -1 && isAlive(partner)

    // Dual solvers coordinate via messages: exclude the partner's ANNOUNCED
    // claim (fight 52977482: modelling the partner by "its nearest crystal"
    // diverged from its sticky focus and both solvers ground the same crystal).
    var partnerPick = null
    if (partnerAlive) {
        readPartnerClaim()
        if (_pzPartnerClaimEID != null) {
            var pc = _crystalMap[_pzPartnerClaimEID]
            if (pc != null && !isCrystalSolved(pc)) partnerPick = _pzPartnerClaimEID
        }
        if (partnerPick == null) {
            // No claim yet (partner hasn't solved this fight) — positional guess
            partnerPick = nearestUnsolvedCrystalTo(getCell(partner), null)
            if (partnerPick == _pzFocusEID) partnerPick = null
        }
    }

    // Stickiness: keep the current focus while it's unsolved and not claimed
    // by the partner — retarget flapping thrashes routes
    if (_pzFocusEID != null && _pzFocusEID != partnerPick) {
        var fc = _crystalMap[_pzFocusEID]
        if (fc != null && !isCrystalSolved(fc)) {
            announceFocus(_pzFocusEID)
            return _pzFocusEID
        }
    }

    var mine = nearestUnsolvedCrystalTo(myCell, partnerPick)
    if (mine == null && partnerPick != null) {
        // Only the partner's crystal remains — converge on it together
        mine = partnerPick
    }
    _pzFocusEID = mine
    announceFocus(mine)
    return _pzFocusEID
}

function pickNearestUnsolvedCrystal(myCell) {
    var bestDist = 999
    var bestEID = null
    for (var eid in mapKeys(_crystalMap)) {
        var cData = _crystalMap[eid]
        var cCell = cData['cell']
        if (isCellSolvedForAxis(cCell, cData['goalAxis'])) continue
        var d = getCellDistance(myCell, cCell)
        if (d < bestDist) {
            bestDist = d
            bestEID = eid
        }
    }
    return bestEID
}

function getGoalAxis(color) {
    if (color == "red") return "south"
    if (color == "blue") return "east"
    if (color == "yellow") return "west"
    if (color == "green") return "north"
    return "unknown"
}

function isOnGoalAxis(crystal) {
    if (_graalCell == -1) return false

    var axis = crystal['goalAxis']
    var cx = crystal['x']
    var cy = crystal['y']
    var gx = _graalX
    var gy = _graalY

    if (axis == "north") {
        return cx == gx && cy < gy
    } else if (axis == "south") {
        return cx == gx && cy > gy
    } else if (axis == "east") {
        return cy == gy && cx > gx
    } else if (axis == "west") {
        return cy == gy && cx < gx
    }

    return false
}

function hasLOSToGraal(crystal) {
    if (_graalCell == -1) return false
    return lineOfSight(crystal['cell'], _graalCell, allAliveEntities())
}

function isCrystalSolved(crystal) {
    return isCellSolvedForAxis(crystal['cell'], crystal['goalAxis'])
}

function getDistanceToAxis(ignoredCrystal) {
    if (_graalCell == -1) return 999

    var axis = _myCrystalGoalAxis
    var cx = _myCrystalX
    var cy = _myCrystalY
    var gx = _graalX
    var gy = _graalY

    if (axis == "north" || axis == "south") {
        return abs(cx - gx)
    } else {
        return abs(cy - gy)
    }
}

function getDirectionToSlide(ignoredCrystal) {
    if (_graalCell == -1) return null

    var axis = _myCrystalGoalAxis
    var cx = _myCrystalX
    var cy = _myCrystalY
    var gx = _graalX
    var gy = _graalY

    if (axis == "north" || axis == "south") {
        if (cx < gx) return "pull"
        if (cx > gx) return "push"
        if (axis == "north" && cy >= gy) return "push"
        if (axis == "south" && cy <= gy) return "pull"
    } else {
        if (cy < gy) return "pull"
        if (cy > gy) return "push"
        if (axis == "east" && cx <= gx) return "pull"
        if (axis == "west" && cx >= gx) return "push"
    }

    return null
}

function getTargetAxisCell(ignoredCrystal) {
    if (_graalCell == -1) return -1

    var axis = _myCrystalGoalAxis
    var gx = _graalX
    var gy = _graalY

    var tx = gx
    var ty = gy
    if (axis == "south") ty = gy + 1
    else if (axis == "north") ty = gy - 1
    else if (axis == "east") tx = gx + 1
    else if (axis == "west") tx = gx - 1

    var cell = getCellFromXY(tx, ty)
    if (cell != null && !isObstacle(cell)) return cell

    for (var d = 2; d <= 8; d++) {
        var sx = gx
        var sy = gy
        if (axis == "south") sy = gy + d
        else if (axis == "north") sy = gy - d
        else if (axis == "east") sx = gx + d
        else if (axis == "west") sx = gx - d

        var scanCell = getCellFromXY(sx, sy)
        if (scanCell != null && !isObstacle(scanCell) && lineOfSight(scanCell, _graalCell, allAliveEntities())) {
            return scanCell
        }
    }

    return -1
}

function computePullDirection(cx, cy, playerCell) {
    var px = getCellX(playerCell)
    var py = getCellY(playerCell)

    var dx = 0
    var dy = 0
    if (px < cx) dx = -1
    else if (px > cx) dx = 1
    if (py < cy) dy = -1
    else if (py > cy) dy = 1

    return [dx, dy]
}

function computePushDirection(cx, cy, playerCell) {
    var px = getCellX(playerCell)
    var py = getCellY(playerCell)

    var dx = 0
    var dy = 0
    if (px < cx) dx = 1
    else if (px > cx) dx = -1
    if (py < cy) dy = 1
    else if (py > cy) dy = -1

    return [dx, dy]
}

function computeAxisDist(cx, cy, gx, gy, goalAxis) {
    if (goalAxis == "north" || goalAxis == "south") {
        return abs(cx - gx)
    } else {
        return abs(cy - gy)
    }
}

function checkOnAxis(cx, cy, gx, gy, goalAxis) {
    if (goalAxis == "north") return cx == gx && cy < gy
    if (goalAxis == "south") return cx == gx && cy > gy
    if (goalAxis == "east") return cy == gy && cx > gx
    if (goalAxis == "west") return cy == gy && cx < gx
    return false
}

function computeCrystalFinalDest() {
    var axis = _myCrystalGoalAxis
    var gx = _graalX
    var gy = _graalY
    if (axis == "north") return getCellFromXY(gx, gy - 1)
    if (axis == "south") return getCellFromXY(gx, gy + 1)
    if (axis == "east") return getCellFromXY(gx + 1, gy)
    if (axis == "west") return getCellFromXY(gx - 1, gy)
    return null
}

function computeCrystalAxisDest() {
    var axis = _myCrystalGoalAxis
    if (axis == "north" || axis == "south") {
        return getCellFromXY(_graalX, _myCrystalY)
    } else {
        return getCellFromXY(_myCrystalX, _graalY)
    }
}

function isCrystalOnAxis() {
    var axis = _myCrystalGoalAxis
    if (axis == "north") return _myCrystalX == _graalX && _myCrystalY < _graalY
    if (axis == "south") return _myCrystalX == _graalX && _myCrystalY > _graalY
    if (axis == "east") return _myCrystalY == _graalY && _myCrystalX > _graalX
    if (axis == "west") return _myCrystalY == _graalY && _myCrystalX < _graalX
    return false
}


function findIdealSlideCell(ignoredCrystal, direction, playerCell) {
    if (_myCrystalCell == -1 || _graalCell == -1) return -1

    var axis = _myCrystalGoalAxis
    var cx = _myCrystalX
    var cy = _myCrystalY
    var moveAxis = (axis == "north" || axis == "south") ? "x" : "y"
    var delta = (moveAxis == "x") ? (_graalX - cx) : (_graalY - cy)
    var absDelta = abs(delta)
    var sign = (delta > 0) ? 1 : -1

    if (direction == "pull") {
        var destX = (moveAxis == "x") ? _graalX : cx
        var destY = (moveAxis == "y") ? _graalY : cy
        var maxD = 8 - absDelta
        for (var d = 1; d <= maxD; d++) {
            var tx = destX
            var ty = destY
            if (moveAxis == "x") {
                tx = destX + sign * d
            } else {
                ty = destY + sign * d
            }
            var cell = getCellFromXY(tx, ty)
            if (cell == null) continue
            if (isObstacle(cell)) continue
            if (cell != playerCell && isEntity(cell)) continue
            return cell
        }
    } else {
        for (var d = 2; d <= 8; d++) {
            var tx = cx
            var ty = cy
            if (moveAxis == "x") {
                tx = cx - sign * d
            } else {
                ty = cy - sign * d
            }
            var cell = getCellFromXY(tx, ty)
            if (cell == null) continue
            if (isObstacle(cell)) continue
            if (cell != playerCell && isEntity(cell)) continue
            return cell
        }
    }
    return -1
}

function selectCombatTarget(fieldMapObj) {
    var enemies = getAliveEnemies()
    if (count(enemies) == 0) return null

    var priority = ["fennel_king", "fennel_knight", "fennel_scribe", "fennel_squire"]

    for (var pName in priority) {
        for (var eid in enemies) {
            if (getName(eid) == pName) {
                var enemySub = fieldMapObj.getEnemySubMap()
                if (mapContainsKey(enemySub, eid)) {
                    return enemySub[eid]
                }
            }
        }
    }

    var bestTarget = null
    var bestHP = 999999
    for (var eid in enemies) {
        var hp = getLife(eid)
        if (hp < bestHP) {
            bestHP = hp
            bestTarget = eid
        }
    }

    if (bestTarget != null) {
        var enemySub = fieldMapObj.getEnemySubMap()
        if (mapContainsKey(enemySub, bestTarget)) {
            return enemySub[bestTarget]
        }
    }

    return null
}

function isCrystalEntity(eid) {
    return mapContainsKey(_crystalMap, eid)
}


function bossDiag(myCell) {
    var g = "none"
    if (_graalID != -1) {
        g = _graalID + "/" + isAlive(_graalID) + "/" + getLife(_graalID) + "/" + getCell(_graalID)
    }
    say("B1 PH=" + _bossPhase + " R=" + _puzzleRole + " SID=" + _puzzleSolverID + " EID=" + _bossTargetEID + " me=" + myCell + " G=" + g)
}

function hasEntityBlockingLine(fromCell, toCell) {
    var dTotal = getCellDistance(fromCell, toCell)
    if (dTotal == null || dTotal <= 1) return false

    var enemies = getAliveEnemies()
    for (var eid in enemies) {
        if (eid == _bossTargetEID) continue
        var eCell = getCell(eid)
        if (eCell == fromCell || eCell == toCell) continue
        if (isOnSameLine(fromCell, eCell) && isOnSameLine(eCell, toCell)) {
            var d1 = getCellDistance(fromCell, eCell)
            var d2 = getCellDistance(eCell, toCell)
            if (d1 + d2 == dTotal) return true
        }
    }

    var allies = getAliveAllies()
    for (var aid in allies) {
        var aCell = getCell(aid)
        if (aCell == fromCell || aCell == toCell) continue
        if (isOnSameLine(fromCell, aCell) && isOnSameLine(aCell, toCell)) {
            var d1 = getCellDistance(fromCell, aCell)
            var d2 = getCellDistance(aCell, toCell)
            if (d1 + d2 == dTotal) return true
        }
    }

    return false
}

function diagNext(cell, step) {
    var next = cell + step
    if (next < 0 || next > 612) return -1
    if (getCellDistance(cell, next) != 1) return -1
    return next
}

function walkDiag(startCell, step, numSteps) {
    var cell = startCell
    for (var i = 0; i < numSteps; i++) {
        cell = diagNext(cell, step)
        if (cell == -1) return -1
    }
    return cell
}

function findBoxStand(crystalCell, step, myCell) {
    var pos = crystalCell
    var firstStand = -1
    var myCellValid = false
    for (var k = 1; k <= 8; k++) {
        var next = diagNext(pos, -step)
        if (next == -1) break
        pos = next
        if (isObstacle(pos)) break
        if (pos != myCell && isEntity(pos)) break
        if (k >= 2) {
            if (firstStand == -1) firstStand = pos
            if (pos == myCell) { myCellValid = true; break }
        }
    }
    if (myCellValid) return myCell
    return firstStand
}

function findGrapStand(targetCell, step, crystalSteps, myCell) {
    var pos = targetCell
    var firstStand = -1
    var myCellValid = false
    for (var j = 1; j <= 8 - crystalSteps; j++) {
        var next = diagNext(pos, step)
        if (next == -1) break
        pos = next
        if (isObstacle(pos)) break
        if (pos != myCell && isEntity(pos)) break
        if (firstStand == -1) firstStand = pos
        if (pos == myCell) { myCellValid = true; break }
    }
    if (myCellValid) return myCell
    return firstStand
}

// ============ BFS crystal route planner ============
// The greedy single-direction planner cannot route crystals around the castle
// walls (fight 52975331: crystal on-axis but beam wall-blocked, solver stuck).
// BFS over crystal cells: an edge is one grapple/boxing slide (cast cell = the
// slide DESTINATION, chip is FIRST_IN_LINE so the crystal must be the first
// entity from the stand) or one inversion swap (solver stands on the
// destination, crystal lands there). Returns the first edge of the shortest
// route as ['chip','target','stand','dest'] — replanned every cast, so stale
// entity positions self-correct.

function routeSlideStand(fromCell, destCell, step, slideLen, myCell) {
    // Collect valid stands on both sides, return the one closest to me —
    // stand choice stability matters, thrashing between far stands burns MP.
    var best = -1
    var bestD = 9999
    // Boxing stands: behind the crystal, opposite the slide direction.
    // k >= 2: boxing min range is 2 — adjacent to the crystal, the first-in-line
    // window starts past it and the crystal blocks LoS instead (cast returns -4).
    var pos = fromCell
    for (var k = 1; k <= 8 - slideLen; k++) {
        var nx = diagNext(pos, -step)
        if (nx == -1) break
        pos = nx
        if (isObstacle(pos)) break
        if (pos != myCell && isEntity(pos)) break
        if (k < 2) continue
        var d1 = getCellDistance(myCell, pos)
        if (d1 != null && d1 < bestD) { bestD = d1; best = pos }
    }
    // Grapple stands: beyond the destination, in the slide direction.
    pos = destCell
    for (var k2 = 1; k2 <= 8 - slideLen; k2++) {
        var nx2 = diagNext(pos, step)
        if (nx2 == -1) break
        pos = nx2
        if (isObstacle(pos)) break
        if (pos != myCell && isEntity(pos)) break
        var d2 = getCellDistance(myCell, pos)
        if (d2 != null && d2 < bestD) { bestD = d2; best = pos }
    }
    return best
}

function routeEdgeChip(fromCell, destCell, step, slideLen, standCell) {
    // Which chip does this stand imply? Stand behind crystal => boxing (push),
    // stand beyond destination => grapple (pull).
    var sx = getCellX(standCell)
    var cx = getCellX(fromCell)
    var dxs = getCellX(destCell)
    if (sx == cx && sx == dxs) {
        // same column: compare y ordering
        var sy = getCellY(standCell)
        var cy = getCellY(fromCell)
        var dy = getCellY(destCell)
        if ((dy > cy && sy < cy) || (dy < cy && sy > cy)) { return CHIP_BOXING_GLOVE }
        return CHIP_GRAPPLE
    }
    if ((dxs > cx && sx < cx) || (dxs < cx && sx > cx)) { return CHIP_BOXING_GLOVE }
    return CHIP_GRAPPLE
}

function planCrystalRoute(crystalCell, goalAxis, myCell, allowInversion) {
    var steps = [18, -18, 17, -17]
    var routeArmyCells = puzzleArmyCells()
    var queue = [crystalCell]
    var visited = [:]
    visited[crystalCell] = true
    var parentFrom = [:]
    var parentEdge = [:]  // dest -> ['chip','target','stand','dest']
    var found = -1
    var qi = 0
    while (qi < count(queue) && count(queue) < 400) {
        var cur = queue[qi]
        qi++
        if (cur != crystalCell && isCellSolvedForAxis(cur, goalAxis)) {
            found = cur
            break
        }
        for (var si = 0; si < 4; si++) {
            var step = steps[si]
            // Slide edges: destinations along a clear straight run
            var pos = cur
            for (var d = 1; d <= 8; d++) {
                var nx = diagNext(pos, step)
                if (nx == -1) break
                pos = nx
                if (isObstacle(pos) || pos == _graalCell) break
                if (pos != crystalCell && pos != myCell && isEntity(pos)) break
                if (!mapContainsKey(visited, pos)) {
                    var stand = routeSlideStand(cur, pos, step, d, myCell)
                    if (stand != -1) {
                        visited[pos] = true
                        parentFrom[pos] = cur
                        parentEdge[pos] = ['chip': routeEdgeChip(cur, pos, step, d, stand), 'target': pos, 'stand': stand, 'dest': pos]
                        push(queue, pos)
                    }
                }
            }
            // Inversion edges: solver stands on the destination (same line as the
            // crystal, real cast LoS) and swaps — walls between other columns
            // become irrelevant. CAUTION: the swap drops the SOLVER on the
            // crystal's current cell. Fight 52977742: a mid-route swap teleported
            // KG into the army's midst and he died two turns later. Mid-route
            // swaps require the landing to be army-safe; goal-finishing swaps
            // are always worth it.
            if (allowInversion) {
                var landingSafe = nearestArmyDistFrom(cur, routeArmyCells) >= 4
                var ipos = cur
                for (var d2 = 1; d2 <= 14; d2++) {
                    var inx = diagNext(ipos, step)
                    if (inx == -1) break
                    ipos = inx
                    if (isObstacle(ipos) || ipos == _graalCell) break
                    if (ipos != myCell && isEntity(ipos)) break
                    if (!mapContainsKey(visited, ipos)) {
                        if (landingSafe || isCellSolvedForAxis(ipos, goalAxis)) {
                            visited[ipos] = true
                            parentFrom[ipos] = cur
                            parentEdge[ipos] = ['chip': CHIP_INVERSION, 'target': -1, 'stand': ipos, 'dest': ipos]
                            push(queue, ipos)
                        }
                    }
                }
            }
        }
    }
    if (found == -1) { return null }
    // Walk back to the first edge from the crystal's current cell
    var node = found
    while (parentFrom[node] != crystalCell) {
        node = parentFrom[node]
    }
    return parentEdge[node]
}

function findBestChipMove(crystalCell, finalDest, myCell, grapUsed, boxUsed, excludeStep) {
    var crystalX = getCellX(crystalCell)
    var crystalY = getCellY(crystalCell)
    var fx = getCellX(finalDest)
    var fy = getCellY(finalDest)
    var dx = fx - crystalX
    var dy = fy - crystalY
    var curManhattan = abs(dx) + abs(dy)

    var steps = [18, -18, 17, -17]
    var sdxs = [1, -1, 0, 0]
    var sdys = [0, 0, 1, -1]

    var bestScore = -999
    var bestStand = -1
    var bestChip = null
    var bestTarget = -1
    var bestNavDist = 999
    var bestStep = 0

    for (var si = 0; si < 4; si++) {
        var step = steps[si]
        var sdx = sdxs[si]
        var sdy = sdys[si]

        if (excludeStep != 0 && step == excludeStep) continue

        var maxClear = 0
        var pos = crystalCell
        for (var d = 1; d <= 8; d++) {
            var next = diagNext(pos, step)
            if (next == -1) break
            pos = next
            if (isObstacle(pos)) break
            if (pos == _graalCell) break
            if (pos != finalDest && isEntity(pos)) break
            maxClear = d
        }
        if (maxClear == 0) continue

        var bestD = 0
        var bestImprove = -999
        for (var d = 1; d <= maxClear; d++) {
            var newManhattan = abs(dx - sdx * d) + abs(dy - sdy * d)
            var improve = curManhattan - newManhattan
            if (improve > bestImprove) {
                bestImprove = improve
                bestD = d
            }
        }
        if (bestD == 0 || bestImprove <= 0) continue

        var newCX = crystalX + sdx * bestD
        var newCY = crystalY + sdy * bestD
        var goalAxis = _myCrystalGoalAxis
        var trapped = false
        if (goalAxis == "north" && newCX == _graalX && newCY >= _graalY) trapped = true
        if (goalAxis == "south" && newCX == _graalX && newCY <= _graalY) trapped = true
        if (goalAxis == "east" && newCY == _graalY && newCX <= _graalX) trapped = true
        if (goalAxis == "west" && newCY == _graalY && newCX >= _graalX) trapped = true
        if (trapped) {
            bestD = bestD - 1
            if (bestD <= 0) continue
            bestImprove = curManhattan - (abs(dx - sdx * bestD) + abs(dy - sdy * bestD))
            if (bestImprove <= 0) continue
            newCX = crystalX + sdx * bestD
            newCY = crystalY + sdy * bestD
        }

        var targetCell = crystalCell + step * bestD

        if (boxUsed < 4) {
            var boxStand = findBoxStand(crystalCell, step, myCell)
            if (boxStand != -1) {
                var dBox = getCellDistance(myCell, boxStand)
                if (bestImprove > bestScore || (bestImprove == bestScore && dBox < bestNavDist)) {
                    bestScore = bestImprove
                    bestStand = boxStand
                    bestChip = CHIP_BOXING_GLOVE
                    bestTarget = targetCell
                    bestNavDist = dBox
                    bestStep = step
                }
            }
        }

        if (grapUsed < 4) {
            var grapStand = findGrapStand(targetCell, step, bestD, myCell)
            if (grapStand != -1) {
                var dGrap = getCellDistance(myCell, grapStand)
                if (bestImprove > bestScore || (bestImprove == bestScore && dGrap < bestNavDist)) {
                    bestScore = bestImprove
                    bestStand = grapStand
                    bestChip = CHIP_GRAPPLE
                    bestTarget = targetCell
                    bestNavDist = dGrap
                    bestStep = step
                }
            }
        }
    }

    if (bestStand == -1) return null
    return ['stand': bestStand, 'chip': bestChip, 'target': bestTarget, 'score': bestScore, 'step': bestStep]
}

function hasImprovingPath(fromCell, finalDest, excludeStep) {
    var fromX = getCellX(fromCell)
    var fromY = getCellY(fromCell)
    var fx = getCellX(finalDest)
    var fy = getCellY(finalDest)
    var curManhattan = abs(fx - fromX) + abs(fy - fromY)
    var steps = [18, -18, 17, -17]
    var sdxs = [1, -1, 0, 0]
    var sdys = [0, 0, 1, -1]
    for (var si = 0; si < 4; si++) {
        var step = steps[si]
        if (excludeStep != 0 && step == excludeStep) continue
        var next = diagNext(fromCell, step)
        if (next == -1) continue
        if (isObstacle(next)) continue
        if (next == _graalCell) continue
        // Skip ally entity check — allies can move out of the way
        // Only block on permanent obstacles (checked above) and graal
        var newManhattan = abs(fx - fromX - sdxs[si]) + abs(fy - fromY - sdys[si])
        if (newManhattan < curManhattan) return true
    }
    return false
}

function findDetourMove(crystalCell, finalDest, myCell, grapUsed, boxUsed, excludeStep) {
    var steps = [18, -18, 17, -17]
    var bestStand = -1
    var bestChip = null
    var bestTarget = -1
    var bestNavDist = 999
    var bestStep = 0
    for (var si = 0; si < 4; si++) {
        var step = steps[si]
        if (excludeStep != 0 && step == excludeStep) continue
        var next = diagNext(crystalCell, step)
        if (next == -1) continue
        if (isObstacle(next)) continue
        if (next == _graalCell) continue
        if (isEntity(next)) continue
        if (!hasImprovingPath(next, finalDest, -step)) continue
        if (boxUsed < 4) {
            var boxStand = findBoxStand(crystalCell, step, myCell)
            if (boxStand != -1) {
                var dBox = getCellDistance(myCell, boxStand)
                if (bestStand == -1 || dBox < bestNavDist) {
                    bestStand = boxStand
                    bestChip = CHIP_BOXING_GLOVE
                    bestTarget = next
                    bestNavDist = dBox
                    bestStep = step
                }
            }
        }
        if (grapUsed < 4) {
            var grapStand = findGrapStand(next, step, 1, myCell)
            if (grapStand != -1) {
                var dGrap = getCellDistance(myCell, grapStand)
                if (bestStand == -1 || dGrap < bestNavDist) {
                    bestStand = grapStand
                    bestChip = CHIP_GRAPPLE
                    bestTarget = next
                    bestNavDist = dGrap
                    bestStep = step
                }
            }
        }
    }
    if (bestStand == -1) return null
    return ['stand': bestStand, 'chip': bestChip, 'target': bestTarget, 'score': 0, 'step': bestStep]
}

function getEnclaveCells() {
    var visited = [:]
    var queue = [_graalCell]
    visited[_graalCell] = true
    // Mark crystal cells as impassable so enclave doesn't route through them
    for (var ceid in mapKeys(_crystalMap)) {
        var cCell = _crystalMap[ceid]['cell']
        visited[cCell] = true
    }
    var idx = 0
    while (idx < count(queue)) {
        var cell = queue[idx]
        idx++
        var steps = [17, -17, 18, -18]
        for (var s in steps) {
            var next = cell + s
            if (next < 0 || next > 612) continue
            if (mapContainsKey(visited, next)) continue
            if (getCellDistance(cell, next) != 1) continue
            if (isObstacle(next)) continue
            visited[next] = true
            push(queue, next)
        }
    }
    return queue
}

function findNearestEnclaveCell(myCell) {
    var enclave = getEnclaveCells()
    var bestCell = -1
    var bestDist = 999
    for (var cell in enclave) {
        var d = getCellDistance(myCell, cell)
        if (d < bestDist) {
            bestDist = d
            bestCell = cell
        }
    }
    return bestCell
}

function findTeleportTarget(crystalCell, myCell) {
    var queue = getEnclaveCells()

    var bestCell = -1
    var bestDist = 999
    for (var cell in queue) {
        if (isEntity(cell)) continue
        var dFromMe = getCellDistance(myCell, cell)
        if (dFromMe < 1 || dFromMe > 12) continue
        var dFromCrystal = getCellDistance(crystalCell, cell)
        if (dFromCrystal < bestDist) {
            bestDist = dFromCrystal
            bestCell = cell
        }
    }
    return bestCell
}

function logMapLayout() {
    var obstacles = getObstacles()
    var obsSet = [:]
    for (var o in obstacles) {
        obsSet[o] = true
    }
    var cellId = 0
    for (var row = 0; row < 35; row++) {
        var rowSize = (row % 2 == 0) ? 18 : 17
        var line = ""
        if (row % 2 != 0) line += "   "
        for (var col = 0; col < rowSize; col++) {
            if (mapContainsKey(obsSet, cellId)) {
                line += "  X  "
            } else {
                if (cellId < 10) line += "  " + cellId + "  "
                else if (cellId < 100) line += " " + cellId + "  "
                else line += " " + cellId + " "
            }
            cellId++
        }
        debug(line)
    }
}

// ============ Phase 2: poison poke (the carry) ============
// The scenario pipeline's death-prediction vs 8 enemies keeps the MAG carry
// permanently out of cast range (fight 52977750: ~300 poison damage in 8
// turns). Scripted poke-and-run: shields/antidote, step into range, dump
// AoE poisons on the army cluster, retreat with leftover MP. Poison keeps
// ticking while kiting and the army carries no cure.
function executeBossCombatPoke() {
    var myID = getEntity()
    // MAG carries poke poison; STR carries poke plasma + ranged weapon.
    // Fight 52978166: ED's normal pipeline ENGAGED at T8 (959 damage) and he
    // was dead at T9 — one turn of damage for a life. Orbit strikes sustain.
    if (getMagic() < 300 && getStrength() < 300) { return false }

    solverSurvival(myID)

    var armyCells = puzzleArmyCells()
    if (count(armyCells) == 0) {
        swatCrystals(myID)
        return false
    }

    // Pass 1: everything castable from where we stand (no MP spent).
    // minCluster 1 everywhere: fight 52978442 — the >= 2 cluster requirement
    // meant a spread-out chasing army only ever ate venom. A lone plague on
    // the king is ~1100 damage; never skip it.
    var casted = 0
    // COVID first: PROPAGATION 2 — it re-infects everything within 2 cells
    // every turn, and the infections keep spreading (Entity.java:806). One
    // point-blank cast on a chasing knight can chain through the whole army
    // (~3400/unit at MAG 600). Cast-from-here only: never dive for it.
    if (tryPoisonCast(myID, CHIP_COVID, 2, 0, 8, 1, armyCells, false)) casted++
    if (tryPoisonCast(myID, CHIP_PLAGUE, 5, 3, 6, 1, armyCells, false)) casted++
    if (tryPoisonCast(myID, CHIP_TOXIN, 7, 2, 5, 1, armyCells, false)) casted++
    if (tryPoisonCast(myID, CHIP_VENOM, 10, 0, 4, 1, armyCells, false)) casted++
    if (tryPoisonCast(myID, CHIP_ARSENIC, 4, 0, 8, 1, armyCells, false)) casted++

    // Weapon strikes for both carry types (STR guns / MAG poison weapons)
    casted += tryWeaponStrike(myID)

    // STR carry: plasma on clusters (MULTIPLIED_BY_TARGETS)
    if (getStrength() >= 300) {
        if (tryPoisonCast(myID, CHIP_PLASMA, 6, 2, 9, 2, armyCells, false)) casted++
    }

    // Pass 2: nothing reached — ONE committed approach, longest range first
    // (fight 52978075: plague's deep approach burned the MP venom needed;
    // per-chip movement races starved each other every turn)
    // DUMP posture (user doctrine: "dump poison then sustain"): with 2+ big
    // poison cooldowns up, DIVE — approach in descending range order so one
    // walk unlocks the whole kit (plague 5 -> arsenic 4 -> covid 2), unload,
    // then the sustain turns kite hard while it all ticks.
    var bigReady = 0
    if (pokeChipReady(myID, CHIP_COVID)) bigReady++
    if (pokeChipReady(myID, CHIP_PLAGUE)) bigReady++
    if (pokeChipReady(myID, CHIP_TOXIN)) bigReady++
    if (pokeChipReady(myID, CHIP_ARSENIC)) bigReady++
    var dumping = getMagic() >= 300 && bigReady >= 2

    if (dumping) {
        // Teleport INTO the enclave when the cluster is beyond walking reach
        // and the payload justifies it (covid up, or the whole kit ready)
        var diveTpCd = getCooldown(CHIP_TELEPORTATION, myID)
        var payload = pokeChipReady(myID, CHIP_COVID) || bigReady >= 3
        if (payload && diveTpCd != null && diveTpCd == 0 && getTP() >= 20) {
            var np = 9999
            for (var ac2 in armyCells) {
                var p2 = getPathLength(getCell(), ac2)
                if (p2 != null && p2 < np) np = p2
            }
            if (np > getMP() + 4) {
                var bestA = -1
                var bestC2 = 99
                for (var aim2 in armyCells) {
                    var dT2 = getCellDistance(getCell(), aim2)
                    if (dT2 == null || dT2 > 14) continue
                    var cl2 = 0
                    var pri2 = 0
                    var hasScribe = false
                    for (var ac3 in armyCells) {
                        var dd3 = getCellDistance(aim2, ac3)
                        if (dd3 != null && dd3 <= 2) {
                            cl2++
                            var e3 = getEntityOnCell(ac3)
                            if (e3 != null && e3 != -1) {
                                pri2 += bossTargetPriority(getName(e3))
                                if (getName(e3) == "fennel_scribe") hasScribe = true
                            }
                        }
                    }
                    // Dive at the SCRIBE even alone (the healer must die);
                    // otherwise require a 2+ cluster to justify the jump
                    if (cl2 < 2 && !hasScribe) continue
                    var dsc = cl2 * 20 + pri2
                    if (bestA == -1 || dsc > bestC2) { bestC2 = dsc; bestA = aim2 }
                }
                if (bestA != -1) {
                    var land = findEmptyCellNear(bestA, getCell(), 12, 2)
                    if (land != -1 && useChipOnCell(CHIP_TELEPORTATION, land) >= 1) {
                        say("PZ DIVE c" + bestC2)
                    }
                }
            }
        }
        if (tryPoisonCast(myID, CHIP_PLAGUE, 5, 3, 6, 1, armyCells, true)) casted++
        if (tryPoisonCast(myID, CHIP_TOXIN, 7, 2, 5, 1, armyCells, false)) casted++
        if (tryPoisonCast(myID, CHIP_ARSENIC, 4, 0, 8, 1, armyCells, true)) casted++
        if (tryPoisonCast(myID, CHIP_COVID, 2, 0, 8, 1, armyCells, true)) casted++
        if (tryPoisonCast(myID, CHIP_VENOM, 10, 0, 4, 1, armyCells, false)) casted++
        casted += tryWeaponStrike(myID)
        if (casted > 0) say("PZ DUMP x" + casted)
    } else if (casted == 0) {
        if (tryPoisonCast(myID, CHIP_VENOM, 10, 0, 4, 1, armyCells, true)) casted++
        else if (tryPoisonCast(myID, CHIP_TOXIN, 7, 2, 5, 1, armyCells, true)) casted++
        else if (tryPoisonCast(myID, CHIP_PLAGUE, 5, 3, 6, 1, armyCells, true)) casted++
        else if (getStrength() >= 300 && tryPoisonCast(myID, CHIP_PLASMA, 6, 2, 9, 2, armyCells, true)) casted++
        if (casted > 0) {
            if (tryPoisonCast(myID, CHIP_TOXIN, 7, 2, 5, 1, armyCells, false)) casted++
            if (tryPoisonCast(myID, CHIP_PLAGUE, 5, 3, 6, 1, armyCells, false)) casted++
            casted += tryWeaponStrike(myID)
        }
    }
    if (casted > 0) {
        say("PZ POKE x" + casted)
    } else {
        say("PZ POKE none d=" + nearestArmyDistFrom(getCell(), armyCells) + " tp=" + getTP() + " mp=" + getMP())
    }

    // Swat AFTER poking — venom (cd 1) doubles as the crystal swat and the
    // swat was eating the poke's cooldown
    swatCrystals(myID)

    // Orbit movement. Manhattan distance LIES around the castle walls (sandbox:
    // "d=10" needed a 14-cell walk), so gate on PATH length. If nothing was
    // cast this turn, close in even from the 6-9 band — sitting at
    // wall-blocked distance 8-10 pokes zero forever (fight 52978134 T7-T10).
    // Approach the ENGAGEMENT, not the horizon: our own scatter drags the army
    // around faster than carriers can chase (fight 52980206: 32/51 nones at
    // d>=12 across ten turns). Army units hunting an ally are committed and
    // reachable — position near the fight.
    var nearestC = -1
    var nearestPath = 9999
    var bestKey = 999999
    var manyAlive = count(armyCells) > 1
    var engAllies = getAliveAllies()
    for (var ac in armyCells) {
        // Don't walk toward the king — poking him is vetoed anyway
        if (manyAlive) {
            var acEnt = getEntityOnCell(ac)
            if (acEnt != null && acEnt != -1 && getName(acEnt) == "fennel_king") continue
        }
        var pd = getPathLength(getCell(), ac)
        if (pd == null) continue
        var engage = 99
        for (var al in engAllies) {
            var dAl = getCellDistance(ac, getCell(al))
            if (dAl != null && dAl < engage) engage = dAl
        }
        var key = engage * 100 + min(pd, 99)
        if (key < bestKey) { bestKey = key; nearestPath = pd; nearestC = ac }
    }
    var approachGate = casted > 0 ? 9 : 6
    if (nearestC != -1 && nearestPath > approachGate) {
        moveTowardCell(nearestC, min(getMP(), nearestPath - (approachGate - 1)))
    } else {
        var kite = pokeOrbitalCell(myID, armyCells)
        if (kite != -1 && kite != getCell()) moveTowardCell(kite)
    }
    return true
}

// Fight 52978553: the scribe healed 1763 and the king 668 — together they
// undid our entire output (2592). Kill the healer first; the king (10k) last.
function bossTargetPriority(name) {
    if (name == "fennel_scribe") { return 60 }
    if (name == "fennel_squire") { return 25 }
    // -125 ranks the king below EVERY possible non-king aim but above "no
    // target at all": he healed back 82% of what we poked into him, but a
    // vetoed poke is 100% wasted when he's the only one in reach
    if (name == "fennel_king") { return -125 }
    return 0
}

function armyCountAlive() {
    var n = 0
    var enemies = getAliveEnemies()
    for (var eid in enemies) {
        var nm = getName(eid)
        if (nm == "graal" || indexOf(nm, "crystal") != -1) continue
        n++
    }
    return n
}

function pokeChipReady(myID, chip) {
    if (!allyHasChip(myID, chip)) { return false }
    var cd = getCooldown(chip, myID)
    return cd != null && cd == 0
}

// Retreat cell for the poke orbit: like the escort kite but with a big bonus
// for FIRING POSITIONS — cells with real LoS to an army unit within 10.
// Fight 52978479: carriers parked in wall-shadow pockets ("none d=3" through
// a wall) and 32 of 34 poke turns fired nothing.
function pokeOrbitalCell(myID, armyCells) {
    var mp = getMP()
    if (mp <= 0) { return -1 }
    var myCell = getCell()
    var allies = getAliveAllies()
    var best = -1
    var bestScore = -99999
    for (var c = 0; c < 613; c++) {
        var dMe = getCellDistance(myCell, c)
        if (dMe == null || dMe > mp) continue
        if (c != myCell && (isObstacle(c) || isEntity(c))) continue
        if (c != myCell) {
            var pl = getPathLength(myCell, c)
            if (pl == null || pl > mp) continue
        }
        var score = min(nearestArmyDistFrom(c, armyCells), 9) * 14
        var canFire = false
        for (var ac in armyCells) {
            var dT = getCellDistance(c, ac)
            if (dT != null && dT >= 2 && dT <= 10 && lineOfSight(c, ac)) { canFire = true; break }
        }
        if (canFire) score += 70
        for (var aid in allies) {
            var dA = getCellDistance(c, getCell(aid))
            if (dA != null && dA < 2) score -= 25
        }
        if (score > bestScore) { bestScore = score; best = c }
    }
    return best
}

// Ranged strikes from the orbit. Stat-aware weapon table: STR carriers use
// direct-damage guns, MAG carriers use their poison weapons — fight 52978442:
// MH never fired GAZOR (pure poison, CIRCLE_3, ~570/target at MAG 600, 2/turn)
// because the strike only knew STR weapons. Line-launch weapons fire when
// aligned. Crystals included as targets — they must die to win.
function tryWeaponStrike(myID) {
    // [weapon, minRange, maxRange, tpCost, aoeAllyVetoRadius, needsLine]
    var strTable = [
        [WEAPON_ENHANCED_LIGHTNINGER, 6, 10, 9, 1, false],
        [WEAPON_RIFLE, 7, 9, 7, 0, false],
        [WEAPON_GRENADE_LAUNCHER, 4, 7, 6, 2, false],
        [WEAPON_MAGNUM, 1, 8, 5, 0, false],
        [WEAPON_DESTROYER, 1, 6, 6, 0, false]
    ]
    var magTable = [
        [WEAPON_GAZOR, 2, 7, 8, 3, true],
        [WEAPON_FLAME_THROWER, 2, 8, 6, 2, true],
        [WEAPON_DOUBLE_GUN, 2, 7, 4, 0, false]
    ]
    var table = getStrength() >= 300 ? strTable : magTable
    var weps = getWeapons()
    if (weps == null) { return 0 }

    var allies = getAliveAllies()
    var myCell = getCell()
    var enemies = getAliveEnemies()

    // Pick the first equipped weapon that has a valid target RIGHT NOW
    // (targets scored: healer first, king last)
    var pick = null
    var pickTarget = null
    for (var row in table) {
        if (pick != null) break
        if (!inArray(weps, row[0])) continue
        var bestSc = -9999
        for (var eid in enemies) {
            var nm = getName(eid)
            if (nm == "graal") continue
            var ec = getCell(eid)
            if (ec == null || ec < 0) continue
            var dd = getCellDistance(myCell, ec)
            if (dd == null || dd < row[1] || dd > row[2]) continue
            if (row[5] && !isOnSameLine(myCell, ec)) continue
            if (!lineOfSight(myCell, ec)) continue
            var allyNear = false
            for (var aid in allies) {
                var dA = getCellDistance(ec, getCell(aid))
                if (dA != null && dA <= row[4]) allyNear = true
            }
            if (allyNear) continue
            var tsc = bossTargetPriority(nm) * 2 - dd
            if (tsc > bestSc) { bestSc = tsc; pick = row; pickTarget = eid }
        }
    }
    if (pick == null) { return 0 }

    var wCost = pick[3]
    if (getWeapon() != pick[0]) {
        if (getTP() < wCost + 1) { return 0 }
        setWeapon(pick[0])
    }
    var n = 0
    while (getTP() >= wCost && n < 3) {
        if (pickTarget == null || !isAlive(pickTarget)) break
        if (useWeapon(pickTarget) < 1) break
        n++
    }
    return n
}

// Pick the aim cell with the biggest army cluster (no ally in the blast),
// walk into cast range if allowed and needed, fire.
function tryPoisonCast(myID, chip, rng, radius, cost, minCluster, armyCells, allowMove) {
    if (!allyHasChip(myID, chip)) { return false }
    if (getTP() < cost) { return false }
    var cd = getCooldown(chip, myID)
    if (cd == null || cd > 0) { return false }

    var allies = getAliveAllies()
    var myCell = getCell()
    var bestAim = -1
    var bestScore = -99999
    for (var aim in armyCells) {
        var cluster = 0
        for (var ac in armyCells) {
            var d = getCellDistance(aim, ac)
            if (d != null && d <= radius) cluster++
        }
        if (cluster < minCluster) continue
        var allyHit = false
        for (var aid in allies) {
            var dA = getCellDistance(aim, getCell(aid))
            if (dA != null && dA <= radius) allyHit = true
        }
        if (allyHit) continue
        var dMe2 = getCellDistance(myCell, aim)
        if (dMe2 == null) continue
        // Without movement only in-range, visible aims count — fight 52978097:
        // venom aims all tie at cluster 1 and the arbitrary pick ignored the
        // knight standing ADJACENT (POKE none at d=1, tp=25)
        if (!allowMove) {
            if (dMe2 > rng) continue
            if (!lineOfSight(myCell, aim)) continue
        }
        // cluster*60 + priority*2: a lone scribe (60+120) now outranks a
        // scribe-less pair (120) — he's the healer, kill-priority is real
        var sc = cluster * 60 - dMe2
        var aimEnt = getEntityOnCell(aim)
        if (aimEnt != null && aimEnt != -1) { sc += bossTargetPriority(getName(aimEnt)) * 2 }
        if (sc > bestScore) { bestScore = sc; bestAim = aim }
    }
    if (bestAim == -1) { return false }

    var dAim = getCellDistance(myCell, bestAim)
    if (dAim == null) { return false }
    if (dAim > rng || !lineOfSight(myCell, bestAim)) {
        if (!allowMove) { return false }
        // Approach: cheapest reachable cell that can cast on the aim
        var mp = getMP()
        if (mp <= 0) { return false }
        var bestStand = -1
        var bestStandScore = -9999
        for (var c = 0; c < 613; c++) {
            var dMe = getCellDistance(myCell, c)
            if (dMe == null || dMe > mp) continue
            if (c != myCell && (isObstacle(c) || isEntity(c))) continue
            var dC = getCellDistance(c, bestAim)
            if (dC == null || dC < 1 || dC > rng) continue
            var pl = getPathLength(myCell, c)
            if (pl == null || pl > mp) continue
            if (!lineOfSight(c, bestAim)) continue
            var sc2 = nearestArmyDistFrom(c, armyCells) * 3 - pl
            if (sc2 > bestStandScore) { bestStandScore = sc2; bestStand = c }
        }
        if (bestStand == -1) { return false }
        moveTowardCell(bestStand)
        // Partial move (blocked path) — cast anyway if the aim is now in reach
        var here = getCell()
        var dNow = getCellDistance(here, bestAim)
        if (dNow == null || dNow > rng || !lineOfSight(here, bestAim)) { return false }
    }
    return useChipOnCell(chip, bestAim) >= 1
}

// ============ Phase 2: plasma pre-cast (STR carries) ============
// PLASMA is MULTIPLIED_BY_TARGETS and STR-scaled: at 410 STR a 3-cluster takes
// ~1500-1700 total. Cast it before the normal pipeline runs (which handles
// weapons/movement) — never consumes the turn, only TP.
function executeBossCombatPlasma() {
    var myID = getEntity()
    if (getStrength() < 300) { return false }
    if (!allyHasChip(myID, CHIP_PLASMA)) { return false }
    if (getTP() < 9) { return false }
    var pcd = getCooldown(CHIP_PLASMA, myID)
    if (pcd == null || pcd > 0) { return false }

    var armyCells = puzzleArmyCells()
    if (count(armyCells) == 0) { return false }
    var allies = getAliveAllies()
    var myCell = getCell()
    var bestAim = -1
    var bestScore = 0
    for (var aim in armyCells) {
        var dMe = getCellDistance(myCell, aim)
        if (dMe == null || dMe > 6) continue
        var cluster = 0
        for (var ac in armyCells) {
            var d2 = getCellDistance(aim, ac)
            if (d2 != null && d2 <= 2) cluster++
        }
        if (cluster < 2) continue
        var allyHit = false
        for (var aid in allies) {
            var dA = getCellDistance(aim, getCell(aid))
            if (dA != null && dA <= 2) allyHit = true
        }
        var dSelf = getCellDistance(aim, myCell)
        if (dSelf != null && dSelf <= 2) allyHit = true
        if (allyHit) continue
        if (!lineOfSight(myCell, aim)) continue
        var sc = cluster * 100 - dMe
        if (sc > bestScore) { bestScore = sc; bestAim = aim }
    }
    if (bestAim == -1) { return false }
    if (useChipOnCell(CHIP_PLASMA, bestAim) >= 1) {
        say("PZ PLASMA")
        return true
    }
    return false
}

// ============ Phase 2: peelers ============
// The respec'd solver-tanks (STR ~0) deal nothing in COMBAT, but BOXING_GLOVE
// has NO cooldown and grapple/boxing are pure displacement — a 25-TP tank can
// shove the melee army back ~6 times per turn while the carry (MH poison /
// ED) does the killing. Full-turn override: shields, peel pushes, heal the
// carry, bodyguard positioning. Crystals (1 HP, must die to win) get swatted
// with any damage chip first.
function executeBossCombatPeel() {
    var myID = getEntity()
    if (getStrength() >= 150) { return false }
    if (!allyHasChip(myID, CHIP_BOXING_GLOVE)) { return false }

    solverSurvival(myID)

    // Carry = strongest alive damage dealer
    var carry = -1
    var bestPow = -1
    var allies = getAliveAllies()
    for (var aid in allies) {
        var p = getStrength(aid) + getMagic(aid)
        if (p > bestPow) { bestPow = p; carry = aid }
    }
    var carryCell = carry != -1 ? getCell(carry) : getCell()

    // Emergency heal on the carry
    if (carry != -1 && entityHPPercent(carry) < 55 && getCellDistance(getCell(), carryCell) <= 3 && getTP() >= 8) {
        var rcd = getCooldown(CHIP_REGENERATION, myID)
        if (rcd != null && rcd == 0) useChip(CHIP_REGENERATION, carry)
    }

    swatCrystals(myID)

    var casts = 0
    while (getTP() >= 3 && casts < 8) {
        if (!peelPushOnce(myID, carryCell)) {
            // No aligned target — spend MP to line up with the enemy nearest
            // the carry (fight 52977750: zero peels all fight, alignment never
            // happened by chance)
            if (casts == 0 && peelAlignMove(myID, carryCell)) {
                if (!peelPushOnce(myID, carryCell)) break
                casts++
                continue
            }
            break
        }
        casts++
    }
    if (casts > 0) say("PZ PEEL x" + casts)

    var kite = choosePuzzleSustainCell(myID, carryCell, carry != -1)
    if (kite != -1 && kite != getCell()) moveTowardCell(kite)
    return true
}

// Move onto the row/column of the army unit closest to the carry, at push
// distance 2-7 with clear LoS
function peelAlignMove(myID, carryCell) {
    var mp = getMP()
    if (mp <= 0) { return false }
    var myCell = getCell()
    var enemies = getAliveEnemies()
    var targets = []
    for (var eid in enemies) {
        var n = getName(eid)
        if (n == "graal" || indexOf(n, "crystal") != -1) continue
        var ec = getCell(eid)
        if (ec == null || ec < 0) continue
        var dC = getCellDistance(ec, carryCell)
        push(targets, [dC != null ? dC : 99, ec])
    }
    if (count(targets) == 0) { return false }

    // Up to 3 nearest to the carry, manual selection (sort() on nested arrays
    // has unreliable semantics in LS)
    var used = [:]
    var nChecked = 0
    while (nChecked < 3) {
        var bi = -1
        var bd = 9999
        for (var i = 0; i < count(targets); i++) {
            if (mapContainsKey(used, i)) continue
            if (targets[i][0] < bd) { bd = targets[i][0]; bi = i }
        }
        if (bi == -1) break
        used[bi] = true
        nChecked++
        var ec2 = targets[bi][1]
        var ex = getCellX(ec2)
        var ey = getCellY(ec2)
        var bestCell = -1
        var bestPl = 999
        for (var k = 2; k <= 7; k++) {
            var cands = [getCellFromXY(ex + k, ey), getCellFromXY(ex - k, ey), getCellFromXY(ex, ey + k), getCellFromXY(ex, ey - k)]
            for (var c in cands) {
                if (c == null || c < 0) continue
                if (c != myCell && (isObstacle(c) || isEntity(c))) continue
                var pl = getPathLength(myCell, c)
                if (pl == null || pl > mp || pl >= bestPl) continue
                if (!lineOfSight(c, ec2)) continue
                bestPl = pl
                bestCell = c
            }
        }
        if (bestCell != -1) {
            if (bestCell == myCell) { return true }
            moveTowardCell(bestCell)
            return getCell() == bestCell
        }
    }
    return false
}

// 1-HP crystals die to any damage chip (boxing does NO damage — its secondary
// effects are caster self-buffs)
function swatCrystals(myID) {
    // Venom included: a poison tick kills a 1-HP crystal on its next turn
    var dmgChips = [CHIP_LIGHTNING, CHIP_ROCKFALL, CHIP_SPARK, CHIP_PEBBLE, CHIP_VENOM]
    var enemies = getAliveEnemies()
    for (var eid in enemies) {
        if (indexOf(getName(eid), "crystal") == -1) continue
        for (var chip in dmgChips) {
            if (!allyHasChip(myID, chip)) continue
            var cd = getCooldown(chip, myID)
            if (cd == null || cd > 0) continue
            if (getTP() < 5) continue
            if (useChip(chip, eid) >= 1) break
        }
    }
}

function peelPushOnce(myID, carryCell) {
    var myCell = getCell()
    var enemies = getAliveEnemies()
    var bestTarget = -1
    var bestScore = -9999
    for (var eid in enemies) {
        var n = getName(eid)
        if (n == "graal" || indexOf(n, "crystal") != -1) continue
        var ec = getCell(eid)
        if (ec == null || ec < 0) continue
        if (!isOnSameLine(myCell, ec)) continue
        var dMe = getCellDistance(myCell, ec)
        if (dMe == null || dMe < 2 || dMe > 7) continue
        if (!lineOfSight(myCell, ec)) continue
        var dCarry = getCellDistance(ec, carryCell)
        var score = 100 - (dCarry != null ? dCarry : 20) * 5
        if (score > bestScore) { bestScore = score; bestTarget = eid }
    }
    if (bestTarget == -1) { return false }

    var ec2 = getCell(bestTarget)
    var step = lineStepFromTo(myCell, ec2)
    if (step == 0) { return false }
    var dest = ec2
    var pos = ec2
    while (true) {
        var nx = diagNext(pos, step)
        if (nx == -1) break
        if (isObstacle(nx) || isEntity(nx)) break
        if (getCellDistance(myCell, nx) > 8) break
        pos = nx
        dest = pos
    }
    if (dest == ec2) { return false }
    return useChipOnCell(CHIP_BOXING_GLOVE, dest) >= 1
}

function lineStepFromTo(fromCell, toCell) {
    var fx = getCellX(fromCell)
    var fy = getCellY(fromCell)
    var tx = getCellX(toCell)
    var ty = getCellY(toCell)
    if (fy == ty && tx != fx) { return tx > fx ? 18 : -18 }
    if (fx == tx && ty != fy) { return ty > fy ? 17 : -17 }
    return 0
}

function executePuzzleTurn() {
    // Hard gate: no live graal with a real cell means the puzzle is over —
    // fall through to normal combat (the army just became vulnerable)
    if (_bossPhase != "PUZZLE" || _graalCell == null || _graalCell < 0) { return false }
    if (_puzzleRole == "SOLVER") return executeSolverPuzzleTurn()
    if (_puzzleRole == "BUFFER") return executeBufferPuzzleTurn()
    if (_puzzleRole == "SUPPORT") return executeSupportPuzzleTurn()
    return false
}

function findEmptyCellNear(targetCell, fromCell, maxRange, minDistToTarget) {
    // Ring offsets: dist 1 (±17/18), dist 2 (±1/34/35/36), dist 3 (±16/19/51-54)
    var offsets = [0, 17, -17, 18, -18, 34, -34, 35, -35, 36, -36, 1, -1,
                   16, -16, 19, -19, 51, -51, 52, -52, 53, -53, 54, -54]
    var bestCell = -1
    var bestDist = 999
    for (var off in offsets) {
        var cell = targetCell + off
        if (cell < 0 || cell > 612) continue
        if (isObstacle(cell)) continue
        if (cell != fromCell && isEntity(cell)) continue
        var dFrom = getCellDistance(fromCell, cell)
        if (dFrom == null || dFrom < 1 || dFrom > maxRange) continue
        var dTo = getCellDistance(cell, targetCell)
        if (dTo == null || dTo < minDistToTarget) continue
        if (dTo < bestDist) { bestDist = dTo; bestCell = cell }
    }
    return bestCell
}

function puzzleGatherMove(gathererID, targetSolverCell) {
    // Approach to the 2-3 escort band, never adjacent — an ally standing next
    // to the solver blocks her pathing (enclave entrances are narrow).
    // Capping MP at dist-2 guarantees we can't end closer than 2.
    var walkDist = getCellDistance(getCell(), targetSolverCell)
    if (walkDist != null && walkDist > 2) {
        moveTowardCell(targetSolverCell, min(getMP(), walkDist - 2))
    }
    // MAG carriers keep teleportation for the phase-2 poison dive — fight
    // 52978546: MH burned it gathering and her first dump slipped to T14
    if (getMagic() >= 300) { return }
    var gatherCell = getCell()
    var gatherDist = getCellDistance(gatherCell, targetSolverCell)
    if (gatherDist > 5 && getTurn() >= 2) {
        var gTpCd = getCooldown(CHIP_TELEPORTATION, gathererID)
        if (gTpCd != null && gTpCd == 0 && getTP() >= 9) {
            var tpCell = findEmptyCellNear(targetSolverCell, gatherCell, 12, 2)
            if (tpCell != -1) useChipOnCell(CHIP_TELEPORTATION, tpCell)
        }
    }
}

function castBuffsOnSolver(myID, buffList) {
    var solverCell = getCell(_puzzleSolverID)
    var dist = getCellDistance(getCell(), solverCell)

    for (var buff in buffList) {
        var chip = buff[0]
        var range = buff[1]
        var cost = buff[2]
        var label = buff[3]
        if (!allyHasChip(myID, chip)) continue
        var cd = getCooldown(chip, myID)
        if (cd != null && cd == 0 && getTP() >= cost && dist <= range) {
            // useChip returns 2 on critical cast — both count as success
            if (useChip(chip, _puzzleSolverID) >= 1) say("PZ BUFF " + label + " -> solver")
        }
    }
}

function solverSelfBuff(slMyID) {
    // Self-buff: HP buffs first (turn 1), then recurring TP/MP buffs, then
    // rolling shields/heal-over-time — the army fires at us during the puzzle
    var selfBuffs = [
        [CHIP_KNOWLEDGE, 5],
        [CHIP_ELEVATION, 6],
        [CHIP_ARMORING, 5],
        [CHIP_LEATHER_BOOTS, 3],
        [CHIP_ADRENALINE, 1],
        [CHIP_MOTIVATION, 4],
        [CHIP_RAGE, 4],
        [CHIP_SEVEN_LEAGUE_BOOTS, 4],
        [CHIP_FORTRESS, 6],
        [CHIP_WALL, 3],
        [CHIP_ARMOR, 6],
        [CHIP_PRISM, 6],
        [CHIP_VACCINE, 6]
    ]
    for (var buff in selfBuffs) {
        var chip = buff[0]
        var cost = buff[1]
        if (getTP() < cost) continue
        if (!allyHasChip(slMyID, chip)) continue
        var cd = getCooldown(chip, slMyID)
        if (cd != null && cd == 0) {
            useChip(chip, slMyID)
        }
    }
}

function isPoisoned(eid) {
    var effs = getEffects(eid)
    if (effs == null) { return false }
    for (var e in effs) {
        if (e[0] == EFFECT_POISON) { return true }
    }
    return false
}

// Survival comes before puzzle progress: called at the start of every solving
// turn. A dead solver ends the fight — nobody else carries GRAPPLE/BOXING_GLOVE.
// Shields are PROACTIVE: army fire during the puzzle is guaranteed, and fight
// 52977544 showed reactive thresholds lag the bursts (Ada took a naked 976
// before the first fortress; KG ate a 3045 volley). ~2.7 TP/turn of insurance
// beats one more push.
function solverSurvival(slMyID) {
    // Excalibur (the king) applies heavy poison — cure it, don't tank it
    // (fight 52977742: KG died with only ~1.6k direct damage logged)
    if (getTP() >= 3 && allyHasChip(slMyID, CHIP_ANTIDOTE) && isPoisoned(slMyID)) {
        var pcd = getCooldown(CHIP_ANTIDOTE, slMyID)
        if (pcd != null && pcd == 0) useChip(CHIP_ANTIDOTE, slMyID)
    }
    var pct = entityHPPercent(slMyID)
    if (pct < 40 && getTP() >= 8 && allyHasChip(slMyID, CHIP_REGENERATION)) {
        var rcd = getCooldown(CHIP_REGENERATION, slMyID)
        if (rcd != null && rcd == 0) {
            if (useChip(CHIP_REGENERATION, slMyID) >= 1) say("PZ SOLVER: emergency regen")
        }
    }
    if (getTP() >= 6 && allyHasChip(slMyID, CHIP_FORTRESS)) {
        var fcd = getCooldown(CHIP_FORTRESS, slMyID)
        if (fcd != null && fcd == 0) useChip(CHIP_FORTRESS, slMyID)
    }
    if (getTP() >= 6 && allyHasChip(slMyID, CHIP_ARMOR)) {
        var acd = getCooldown(CHIP_ARMOR, slMyID)
        if (acd != null && acd == 0) useChip(CHIP_ARMOR, slMyID)
    }
    if (pct < 70 && getTP() >= 3 && allyHasChip(slMyID, CHIP_WALL)) {
        var wcd = getCooldown(CHIP_WALL, slMyID)
        if (wcd != null && wcd == 0) useChip(CHIP_WALL, slMyID)
    }
}

function executeBufferPuzzleTurn() {
    var myID = getEntity()

    if (_puzzleSolverID == -1 || !isAlive(_puzzleSolverID)) {
        say("PZ BUFFER: no solver")
        puzzleSelfPreserve(myID, false)
        return true
    }

    // Buffer (KurtGodel) closes to range 3 during the gather window so ARMORING
    // and ADRENALINE reach the solver (RAGE/SLB have range 8 and land anyway)
    var bufSolverCell = getCell(_puzzleSolverID)
    var bufDist = getCellDistance(getCell(), bufSolverCell)
    if (getTurn() <= 2 && bufDist > 3 && hasPendingSolverHPBuff(myID)) {
        puzzleGatherMove(myID, bufSolverCell)
    }

    var buffs = [
        [CHIP_ELEVATION, 5, 6, "elev"],
        [CHIP_ARMORING, 3, 5, "armor"],
        [CHIP_RAGE, 8, 4, "rage"],
        [CHIP_SEVEN_LEAGUE_BOOTS, 8, 4, "slb"],
        [CHIP_LEATHER_BOOTS, 5, 3, "boots"],
        [CHIP_ADRENALINE, 3, 1, "adren"]
    ]
    castBuffsOnSolver(myID, buffs)
    puzzleSustainSolver(myID)
    // Leash only during the delivery window — armoring/adren cooldowns expiring
    // mid-fight must NOT pull allies back into army range for a top-up
    puzzleSelfPreserve(myID, getTurn() <= 2)
    return true
}

// True while this ally still has an undelivered solver buff ready (self-cooldown
// checks only — cross-entity getCooldown is unreliable)
function hasPendingSolverHPBuff(myID) {
    var pending = [CHIP_ELEVATION, CHIP_ARMORING, CHIP_ADRENALINE]
    for (var chip in pending) {
        if (!allyHasChip(myID, chip)) continue
        var cd = getCooldown(chip, myID)
        if (cd != null && cd == 0) return true
    }
    return false
}

// The fennel army: alive enemies that are neither graal nor crystals. During
// PUZZLE they are invulnerable (Divine Protection) but attack freely — the
// only counterplay is sustain and spacing.
function puzzleArmyCells() {
    var cells = []
    var enemies = getAliveEnemies()
    for (var eid in enemies) {
        var n = getName(eid)
        if (n == "graal") continue
        if (indexOf(n, "crystal") != -1) continue
        push(cells, getCell(eid))
    }
    return cells
}

function nearestArmyDistFrom(cell, armyCells) {
    var best = 99
    for (var ac in armyCells) {
        var d = getCellDistance(cell, ac)
        if (d != null && d < best) best = d
    }
    return best
}

function entityHPPercent(eid) {
    var tot = getTotalLife(eid)
    if (tot == null || tot <= 0) { return 100 }
    return getLife(eid) * 100 / tot
}

// Rolling heal + shields on the solver — the actual answer to "solver doesn't
// tank". Every ally holds REGENERATION (wisdom-scaled ~2000 HP) + shields.
function puzzleSustainSolver(myID) {
    if (_puzzleSolverID == -1 || !isAlive(_puzzleSolverID)) { return }
    var dist = getCellDistance(getCell(), getCell(_puzzleSolverID))
    var sPct = entityHPPercent(_puzzleSolverID)

    // Emergency heal (once per fight per ally — only under real pressure)
    if (sPct < 55 && dist <= 3 && allyHasChip(myID, CHIP_REGENERATION)) {
        var cd = getCooldown(CHIP_REGENERATION, myID)
        if (cd != null && cd == 0 && getTP() >= 8) {
            if (useChip(CHIP_REGENERATION, _puzzleSolverID) >= 1) say("PZ HEAL regen -> solver")
        }
    }

    // Shields on cooldown while the army is shooting at the solver
    var shields = [
        [CHIP_FORTRESS, 3, 6, "fortress"],
        [CHIP_ARMOR, 4, 6, "armorshield"],
        [CHIP_RAMPART, 7, 5, "rampart"]
    ]
    for (var sh in shields) {
        var chip = sh[0]
        var rng = sh[1]
        var cost = sh[2]
        var label = sh[3]
        if (!allyHasChip(myID, chip)) continue
        if (chip == CHIP_RAMPART && dist < 2) continue
        var scd = getCooldown(chip, myID)
        if (scd != null && scd == 0 && getTP() >= cost && dist <= rng) {
            if (useChip(chip, _puzzleSolverID) >= 1) say("PZ SHIELD " + label + " -> solver")
        }
    }
}

// Escort no-go: cells that interfere with the puzzle — the chamber around the
// graal (walls the solver in; entrances are narrow), the four beam/push lanes,
// and cells adjacent to crystals (block slides and stands).
function isPuzzleWorkZone(cell) {
    if (_graalCell == -1) { return false }
    var dG = getCellDistance(cell, _graalCell)
    if (dG != null && dG <= 4) { return true }
    var cx = getCellX(cell)
    var cy = getCellY(cell)
    if ((cx == _graalX || cy == _graalY) && dG != null && dG <= 9) { return true }
    for (var eid in mapKeys(_crystalMap)) {
        var cc = getCell(eid)
        if (cc == null || cc < 0) continue
        var dC = getCellDistance(cell, cc)
        if (dC != null && dC <= 1) { return true }
    }
    return false
}

// Ally end-of-turn during PUZZLE: shield self with leftover TP, then reposition.
// While leashed (buff delivery window) stay in the 2-3 escort band; afterwards
// SCATTER — fight 52976969: the army deals ~2500/turn focused and killed the
// whole escort by T5. Allies can't out-sustain that (one regen each); they can
// out-RUN it (7-10 MP vs the army's less). Post-delivery the best help is
// staying alive, splitting the army's attention, far from the AoEs.
function puzzleSelfPreserve(myID, leashed) {
    var selfShields = [
        [CHIP_FORTRESS, 6],
        [CHIP_ARMOR, 6],
        [CHIP_WALL, 3]
    ]
    for (var sh in selfShields) {
        var chip = sh[0]
        var cost = sh[1]
        if (!allyHasChip(myID, chip)) continue
        if (getTP() < cost) continue
        var cd = getCooldown(chip, myID)
        if (cd != null && cd == 0) useChip(chip, myID)
    }
    if (entityHPPercent(myID) < 40 && allyHasChip(myID, CHIP_REGENERATION) && getTP() >= 8) {
        var rcd = getCooldown(CHIP_REGENERATION, myID)
        if (rcd != null && rcd == 0) useChip(CHIP_REGENERATION, myID)
    }

    var solverAlive = _puzzleSolverID != -1 && isAlive(_puzzleSolverID)
    var anchorCell = solverAlive ? getCell(_puzzleSolverID) : getCell()
    var distToSolver = getCellDistance(getCell(), anchorCell)

    // Follow the solver only while we still owe her buffs
    if (leashed && solverAlive && distToSolver > 8) {
        var tpCd = getCooldown(CHIP_TELEPORTATION, myID)
        if (tpCd != null && tpCd == 0 && getTP() >= 9) {
            var tc = findEmptyCellNear(anchorCell, getCell(), 12, 2)
            if (tc != -1 && !isPuzzleWorkZone(tc)) useChipOnCell(CHIP_TELEPORTATION, tc)
        }
        var followDist = getCellDistance(getCell(), anchorCell)
        if (followDist != null && followDist > 2) {
            moveTowardCell(anchorCell, min(getMP(), followDist - 2))
        }
        return
    }

    var best = choosePuzzleSustainCell(myID, anchorCell, leashed && solverAlive)
    if (best != -1 && best != getCell()) moveTowardCell(best)
}

function choosePuzzleSustainCell(myID, anchorCell, leashed) {
    return choosePuzzleSustainCellCapped(myID, anchorCell, leashed, 12)
}

// armyCap bounds the value of running: past that distance more space scores
// nothing. The poke carry caps at ~9 (venom range 10) so she orbits at cast
// range instead of fleeing to the horizon — fight 52977803: unbounded retreat
// meant every approach exceeded MP and phase 2 never fired a single poke.
function choosePuzzleSustainCellCapped(myID, anchorCell, leashed, armyCap) {
    var mp = getMP()
    if (mp <= 0) { return -1 }
    var myCell = getCell()
    var armyCells = puzzleArmyCells()
    var allies = getAliveAllies()
    var best = -1
    var bestScore = -99999
    for (var c = 0; c < 613; c++) {
        var dMe = getCellDistance(myCell, c)
        if (dMe == null || dMe > mp) continue
        if (c != myCell && (isObstacle(c) || isEntity(c))) continue
        if (c != myCell) {
            var pl = getPathLength(myCell, c)
            if (pl == null || pl > mp) continue
        }
        // Army distance dominates: fight 52977548 — ED never escaped the zone
        // and died T6 with ~4700 absorbed; every cell of distance matters
        var score = min(nearestArmyDistFrom(c, armyCells), armyCap) * 14
        if (isPuzzleWorkZone(c)) score -= 80
        if (leashed) {
            var dS = getCellDistance(c, anchorCell)
            // Escort band 2-3: inside range 3 for armoring/regen/fortress/adren,
            // never adjacent (blocks the solver's pathing around crystals)
            if (dS != null && dS > 3) score -= (dS - 3) * 12
            if (dS != null && dS < 2) score -= 40
        }
        for (var aid in allies) {
            if (aid == _puzzleSolverID) continue
            var dA = getCellDistance(c, getCell(aid))
            if (dA != null && dA < 2) score -= 25
        }
        if (score > bestScore) { bestScore = score; best = c }
    }
    return best
}

function executeSupportPuzzleTurn() {
    var myID = getEntity()

    // Phase-2 carries (high STR) are worth more alive than their buffs: ED ate
    // a ~2000 alpha at T2 during delivery in 6 of 8 fights. BUT fight 52978172
    // showed full withdrawal guts the solvers (KG entered at 3755 maxHP, dead
    // T5, puzzle failed). Compromise: on T1 cast the range-5 buffs from the
    // SPAWN — solvers are in range, zero movement, zero added exposure — then
    // scatter forever.
    if (getStrength() >= 300) {
        if (getTurn() == 1) {
            // Aim at the NEAREST solver — the paired one can be out of spawn
            // range (fight 52978352: ED->KG at dist 6, elevation range 5,
            // nothing landed and KG entered at 3787)
            var nearS = -1
            var nearD = 999
            var edAllies = getAliveAllies()
            for (var aid in edAllies) {
                if (!isNamedSolver(getName(aid))) continue
                var dd = getCellDistance(getCell(), getCell(aid))
                if (dd != null && dd < nearD) { nearD = dd; nearS = aid }
            }
            if (nearS != -1) {
                _puzzleSolverID = nearS
                var farBuffs = [
                    [CHIP_ELEVATION, 5, 6, "elev"],
                    [CHIP_LEATHER_BOOTS, 5, 3, "boots"]
                ]
                castBuffsOnSolver(myID, farBuffs)
            }
        }
        puzzleSelfPreserve(myID, false)
        return true
    }

    if (_puzzleSolverID == -1 || !isAlive(_puzzleSolverID)) {
        say("PZ SUPPORT: no solver")
        puzzleSelfPreserve(myID, false)
        return true
    }

    var solverCell = getCell(_puzzleSolverID)
    var dist = getCellDistance(getCell(), solverCell)

    // Support needs range 3 for ARMORING — close on the solver while it still
    // has undelivered HP buffs
    if (getTurn() <= 2 && dist > 3 && hasPendingSolverHPBuff(myID)) {
        puzzleGatherMove(myID, solverCell)
    }

    // Support casts ELEVATION and ARMORING only (no RAGE/SLB)
    var buffs = [
        [CHIP_ELEVATION, 5, 6, "elev"],
        [CHIP_ARMORING, 3, 5, "armor"],
        [CHIP_LEATHER_BOOTS, 5, 3, "boots"],
        [CHIP_ADRENALINE, 3, 1, "adren"]
    ]
    castBuffsOnSolver(myID, buffs)
    puzzleSustainSolver(myID)
    puzzleSelfPreserve(myID, getTurn() <= 2)
    return true
}

function executeSolverPuzzleTurn() {
    if (getTurn() == 1) {
        var allA = []
        push(allA, getEntity())
        var als = getAliveAllies()
        for (var a in als) push(allA, a)
        sort(allA)
        if (allA[0] == getEntity()) logMapLayout()
    }

    var myCell = getCell()
    var myID = getEntity()

    // Gather phase: hold position until allies' HP buffs stop flowing in.
    // Elevation/armoring are permanent effects (turns=0) invisible to getEffects,
    // so detect them via max-life growth between our turns. Snapshot is taken
    // AFTER self-buffs, so growth seen next turn can only come from ally casts.
    var maxLifeNow = getTotalLife(myID)
    var lifeGain = _pzSolverMaxLifeSnapshot == -1 ? maxLifeNow : maxLifeNow - _pzSolverMaxLifeSnapshot
    // Wait T1-2 (bulk of the buffs), extend to T3 only for a SUBSTANTIAL gain
    // still flowing. Fight 52977149: +534/+113 trickles extended the wait to T4
    // and the two lost tempo turns cost the fight — the army clock (~2500/turn)
    // outprices any marginal buff.
    if (!_pzGatherDone && (getTurn() <= 2 || (getTurn() <= 3 && lifeGain >= 400))) {
        say("PZ SOLVER: waiting for ally buffs (turn " + getTurn() + ", maxHP " + maxLifeNow + ")")
        solverSelfBuff(myID)
        // Don't idle on spawn while the army closes — drift away a few cells,
        // but only under actual pressure (drifting without an army nearby just
        // adds crystal travel)
        var waitArmy = puzzleArmyCells()
        if (count(waitArmy) > 0 && nearestArmyDistFrom(getCell(), waitArmy) <= 12) {
            var waitKite = choosePuzzleSustainCellCapped(myID, getCell(), false, 12)
            if (waitKite != -1 && waitKite != getCell()) moveTowardCell(waitKite, min(getMP(), 3))
        }
        _pzSolverMaxLifeSnapshot = getTotalLife(myID)
        return true
    }
    // One-way gate: a late buff landing mid-solve must not pull us back into waiting
    _pzGatherDone = true

    // Under fire from the invulnerable army: shield/heal before spending TP on pushes
    solverSurvival(myID)

    // Pick first crystal target for teleportation
    var firstEID = pickFocusCrystal(myCell)
    if (firstEID == null) {
        say("PZ SOLVER: all done")
        solverSelfBuff(myID)
        return true
    }

    // Sync globals for teleportation target
    _bossTargetEID = firstEID
    syncCrystalScalars(_crystalMap[firstEID])
    var firstDest = computeCrystalFinalDest()

    // Teleportation to get near first crystal
    var crystalCell0 = getCell(firstEID)
    if (crystalCell0 != null && crystalCell0 >= 0) {
        var tpCd = getCooldown(CHIP_TELEPORTATION, myID)
        if (tpCd != null && tpCd == 0 && getTP() >= 12 && firstDest != null) {
            var tpDone = false
            // Teleport straight onto the BFS route's stand when one exists
            var preMove = planCrystalRoute(crystalCell0, _myCrystalGoalAxis, myCell, false)
            if (preMove == null) {
                preMove = findBestChipMove(crystalCell0, firstDest, myCell, 0, 0, 0)
            }
            if (preMove != null) {
                var preStand = preMove['stand']
                var dToStand = getCellDistance(myCell, preStand)
                if (dToStand >= 1 && dToStand <= 12) {
                    if (useChipOnCell(CHIP_TELEPORTATION, preStand) == 1) {
                        myCell = getCell()
                        tpDone = true
                    }
                }
            }
            if (!tpDone) {
                var tpTarget = findTeleportTarget(crystalCell0, myCell)
                if (tpTarget != -1) {
                    if (useChipOnCell(CHIP_TELEPORTATION, tpTarget) == 1) {
                        myCell = getCell()
                        tpDone = true
                    }
                }
            }
            if (!tpDone) {
                var nearest = findNearestEnclaveCell(myCell)
                if (nearest != -1) {
                    moveTowardCell(nearest)
                    myCell = getCell()
                    var tpTarget2 = findTeleportTarget(crystalCell0, myCell)
                    if (tpTarget2 != -1) {
                        if (useChipOnCell(CHIP_TELEPORTATION, tpTarget2) == 1) {
                            myCell = getCell()
                        }
                    }
                }
                solverSelfBuff(myID)
                return true
            }
        } else if (tpCd != null && tpCd > 0) {
            var dToCrystal = getCellDistance(myCell, crystalCell0)
            if (dToCrystal > 10) {
                // Teleport down and crystal far: WALK toward it. Never stand
                // still — that stranded the solver to death in fight 52975331.
                say("PZ SOLVER: closing on c=" + firstEID + " d=" + dToCrystal)
                moveTowardCell(crystalCell0)
                solverSelfBuff(myID)
                return true
            }
        }
    }

    // Self leather_boots for extra MP (only if allies haven't cast it on us)
    var bootsCd = getCooldown(CHIP_LEATHER_BOOTS, myID)
    if (bootsCd != null && bootsCd == 0 && getTP() >= 4) {
        useChip(CHIP_LEATHER_BOOTS, myID)
    }

    // Self adrenaline for extra TP (only if allies haven't cast it on us)
    var adrenCd = getCooldown(CHIP_ADRENALINE, myID)
    if (adrenCd != null && adrenCd == 0 && getTP() >= 1) {
        useChip(CHIP_ADRENALINE, myID)
    }

    // Multi-crystal solving loop
    var totalChipsFired = 0
    var crystalsSolved = 0

    while (getTP() >= 3) {
        myCell = getCell()
        var nextEID = pickFocusCrystal(myCell)
        if (nextEID == null) {
            say("PZ SOLVER: ALL DONE (" + crystalsSolved + " this turn)")
            break
        }

        // Sync globals for this crystal
        _bossTargetEID = nextEID
        _myAssignedCrystal = _crystalMap[nextEID]
        syncCrystalScalars(_crystalMap[nextEID])

        var finalDest = computeCrystalFinalDest()
        if (finalDest == null) {
            say("PZ: no dest for " + nextEID)
            moveTowardCell(_crystalMap[nextEID]['cell'])
            return true
        }

        // Solve via BFS route (handles walls + inversion), greedy as fallback
        var grapUsed = 0
        var boxUsed = 0
        var chipsFired = 0
        var lockedStep = 0
        var detourCount = 0

        while (chipsFired < 8) {
            var crystalCell = getCell(_bossTargetEID)
            if (crystalCell == null || crystalCell < 0) break

            if (isCellSolvedForAxis(crystalCell, _myCrystalGoalAxis)) break

            if (getTP() < 3) break

            myCell = getCell()

            var invCd = getCooldown(CHIP_INVERSION, myID)
            var invReady = allyHasChip(myID, CHIP_INVERSION) && invCd != null && invCd == 0 && getTP() >= 4

            // Reuse the committed edge if still valid (same crystal, unmoved,
            // stand free, chip still castable)
            var move = null
            if (_pzRouteEID == _bossTargetEID && _pzRouteCrystalCell == crystalCell && _pzRouteStand != -1) {
                var standFree = _pzRouteStand == myCell || (!isObstacle(_pzRouteStand) && !isEntity(_pzRouteStand))
                var chipOk = _pzRouteChip != CHIP_INVERSION || invReady
                if (standFree && chipOk) {
                    move = ['stand': _pzRouteStand, 'chip': _pzRouteChip, 'target': _pzRouteTarget]
                }
            }
            if (move == null) {
                move = planCrystalRoute(crystalCell, _myCrystalGoalAxis, myCell, invReady)
            }
            if (move == null) {
                move = findBestChipMove(crystalCell, finalDest, myCell, grapUsed, boxUsed, lockedStep)
            }
            if (move == null) {
                if (detourCount < 4) {
                    move = findDetourMove(crystalCell, finalDest, myCell, grapUsed, boxUsed, lockedStep)
                    if (move != null) detourCount++
                }
            }
            if (move == null) break

            // Commit this edge for cross-turn stability
            _pzRouteEID = _bossTargetEID
            _pzRouteCrystalCell = crystalCell
            _pzRouteStand = move['stand']
            _pzRouteChip = move['chip']
            _pzRouteTarget = move['target']

            var stand = move['stand']
            var chip = move['chip']
            var target = move['target']

            if (myCell != stand) {
                if (getMP() == 0) break
                var prevCell = myCell
                moveTowardCell(stand)
                myCell = getCell()
                if (myCell == prevCell) {
                    // Path fully blocked (fight 52978352: Ada pinned by army
                    // bodies for 3 turns) — teleport out if possible
                    var stallTpCd = getCooldown(CHIP_TELEPORTATION, getEntity())
                    if (stallTpCd != null && stallTpCd == 0 && getTP() >= 9 + 3) {
                        var tpDest = stand
                        if (isObstacle(tpDest) || (tpDest != myCell && isEntity(tpDest))) {
                            tpDest = findEmptyCellNear(stand, myCell, 12, 1)
                        }
                        if (tpDest != -1 && getCellDistance(myCell, tpDest) <= 12) {
                            if (useChipOnCell(CHIP_TELEPORTATION, tpDest) >= 1) {
                                myCell = getCell()
                                if (myCell == stand) continue
                            }
                        }
                    }
                    _pzRouteEID = null
                    break
                }
                // Not there yet: end the turn walking (commitment persists).
                // Replanning mid-turn flips between equivalent routes and
                // thrashes MP (f=0 turns).
                if (myCell != stand) break
            }

            if (chip == CHIP_INVERSION) {
                var invR = useChip(CHIP_INVERSION, _bossTargetEID)
                if (invR < 1) {
                    debug("PZDBG inv fail r=" + invR + " me=" + myCell + " cr=" + crystalCell)
                    _pzRouteEID = null
                    break
                }
                myCell = getCell()
                chipsFired++
                totalChipsFired++
                say("PZ INV c=" + _bossTargetEID)
                continue
            }

            // GRAPPLE/BOXING are FIRST_IN_LINE: whatever entity sits first on the
            // line gets moved. If the crystal isn't cleanly visible (a knight
            // stepped in since planning), abort — we'd drag the knight onto us.
            if (!lineOfSight(myCell, crystalCell)) {
                debug("PZDBG los-block me=" + myCell + " cr=" + crystalCell + " chip=" + chip + " tgt=" + target)
                _pzRouteEID = null
                break
            }

            var r = useChipOnCell(chip, target)
            if (r < 1) {
                debug("PZDBG cast fail r=" + r + " chip=" + chip + " me=" + myCell + " tgt=" + target + " cr=" + crystalCell)
                _pzRouteEID = null
                break
            }

            chipsFired++
            totalChipsFired++
            if (chip == CHIP_GRAPPLE) grapUsed++
            else boxUsed++

            if (lockedStep == 0 && mapContainsKey(move, 'score') && move['score'] > 0) {
                var firedStep = move['step']
                lockedStep = -firedStep
            }
        }

        // Check if this crystal is solved
        var crCell = getCell(_bossTargetEID)
        var solved = isCellSolvedForAxis(crCell, _myCrystalGoalAxis)

        if (solved) {
            crystalsSolved++
            say("PZ DONE c=" + _bossTargetEID + " f=" + chipsFired + " total=" + crystalsSolved)
            continue
        } else {
            say("PZ f=" + chipsFired + " cr=" + crCell + " dst=" + finalDest)
            // Move toward crystal for next turn
            if (chipsFired > 0 && crCell != null && crCell >= 0) {
                moveTowardCell(crCell)
            } else if (chipsFired == 0) {
                var crystalNow = getCell(_bossTargetEID)
                if (crystalNow != null && crystalNow >= 0 && getCellDistance(getCell(), crystalNow) <= 1) {
                    moveTowardCell(finalDest)
                } else if (crystalNow != null && crystalNow >= 0) {
                    moveTowardCell(crystalNow)
                }
            }
            break
        }
    }

    solverSelfBuff(myID)
    return true
}

function getBossPuzzleTarget(fieldMapObj) {
    if (_bossTargetEID == null) return null

    var enemySub = fieldMapObj.getEnemySubMap()
    if (mapContainsKey(enemySub, _bossTargetEID)) {
        return enemySub[_bossTargetEID]
    }
    if (mapContainsKey(fieldMapObj.entities, _bossTargetEID)) {
        return fieldMapObj.entities[_bossTargetEID]
    }
    if (_myCrystalCell != -1) {
        return new Enemy(_myCrystalCell)
    }
    return null
}
