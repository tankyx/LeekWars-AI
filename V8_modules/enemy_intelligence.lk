
global __enemyProfile = [:]
global __enemyObservations = [:]

function profileEnemy(enemy) {
    if (enemy == null) return null
    var eid = enemy._id
    if (mapContainsKey(__enemyProfile, eid)) return null

    var chips = enemy._chips
    var weapons = enemy._weapons
    var str = enemy._strength
    var mag = enemy._magic
    var agi = enemy._agility
    var sci = enemy._science
    var res = enemy._resistance
    var wis = enemy._wisdom

    var profile = [:]

    profile['buildType'] = detectEnemyBuildType(str, mag, agi, sci, res)

    var maxBurst = 0
    var bestRange = 0
    var bestRangeDmg = 0
    for (var weaponId in weapons) {
        var effects = getWeaponEffects(weaponId)
        var weaponDmg = 0
        for (var eff in effects) {
            if (eff[0] == EFFECT_DAMAGE) {
                var avgDmg = (eff[1] + eff[2]) / 2
                weaponDmg += avgDmg * (1 + str / 100)
            }
        }
        var cost = getWeaponCost(weaponId)
        if (cost != null && cost > 0) {
            var uses = floor(12 / cost)
            var totalDmg = weaponDmg * uses
            if (totalDmg > maxBurst) {
                maxBurst = totalDmg
            }
        }
        if (weaponDmg > bestRangeDmg) {
            bestRangeDmg = weaponDmg
            bestRange = getWeaponMaxRange(weaponId)
        }
    }
    for (var chipId in chips) {
        var effects = getChipEffects(chipId)
        if (effects == null) continue
        for (var eff in effects) {
            if (eff[0] == EFFECT_DAMAGE) {
                var avgDmg = (eff[1] + eff[2]) / 2
                maxBurst += avgDmg * (1 + mag / 100)
            }
        }
    }
    profile['maxBurstDamage'] = floor(maxBurst)
    profile['preferredRange'] = bestRange

    var hasShield = false
    var hasHeal = false
    var hasPoison = false
    var hasReflect = false
    var hasAntidote = false
    for (var cid in chips) {
        if (mapContainsKey(ROLE_SHIELD_RELATIVE, cid) || mapContainsKey(ROLE_SHIELD_ABSOLUTE, cid)) hasShield = true
        if (mapContainsKey(ROLE_HEALING, cid)) hasHeal = true
        if (mapContainsKey(ROLE_POISON, cid)) hasPoison = true
        if (mapContainsKey(ROLE_DAMAGE_RETURN, cid)) hasReflect = true
        if (cid == CHIP_ANTIDOTE) hasAntidote = true
    }
    if (!hasPoison) {
        for (var wid in weapons) {
            if (mapContainsKey(ROLE_POISON_WEAPON, wid)) { hasPoison = true; break }
        }
    }
    profile['hasShield'] = hasShield
    profile['hasHeal'] = hasHeal
    profile['hasPoison'] = hasPoison
    profile['hasReflect'] = hasReflect
    profile['hasAntidote'] = hasAntidote
    profile['isTank'] = (profile['buildType'] == BUILD_TANK_SCI || res >= 300)
    profile['isBurstBuild'] = (str >= 400 && !profile['isTank'])
    // AGI kiters keep existing detection. Magic-poison kiters (e.g. koe2:
    // mag 500 / str 60 / agi 180, Venom+Toxin+Antidote) are also kiters in
    // practice — they sit at dist 9-18 spamming poisons without closing.
    // The old AGI-only check missed them entirely, so vs_kiter_* counter
    // weights and downstream herding logic never activated. Magic-kiter
    // signature: meaningful MAG, has poison, low STR (so not a melee threat),
    // not an explicit HYBRID (mixed-range, doesn't want max distance).
    var isAgiKiter = (profile['buildType'] == BUILD_AGILITY || agi >= 400)
    var isMagicKiter = (mag >= 300 && hasPoison && str < 250
                        && profile['buildType'] != BUILD_HYBRID)
    profile['isKiter'] = isAgiKiter || isMagicKiter
    profile['kiterFlavor'] = isMagicKiter ? 'magic_poison' : (isAgiKiter ? 'agi' : 'none')

    // Lifesteal threat: AGI build (or AGI >= 300) carrying a close-range
    // weapon with non-trivial WIS. AGI's crit + WIS lifesteal at point-blank
    // is devastating — enemy heals 80-110/shot while dealing 300-500. F52593779
    // LR vs cLEEKici (str 390, agi 390, wis ~250, unstable_destroyer range 7):
    // T2 LR closed to dist 5, ate 1025 dmg + enemy healed 331, died T3. The
    // counter is range discipline — stay at max weapon range and use LR's
    // 7-MP mobility advantage to kite. Detection thresholds chosen so a
    // typical AGI-poison kiter (low WIS) doesn't trigger this (those need
    // antidote logic, not range), while AGI bruisers with sustain do.
    var hasLifestealThreat = false
    if (wis >= 80 && bestRange > 0 && bestRange <= 8) {
        if (profile['buildType'] == BUILD_AGILITY || profile['buildType'] == BUILD_BRUISER_REFLECT || agi >= 300) {
            hasLifestealThreat = true
        }
    }
    profile['hasLifestealThreat'] = hasLifestealThreat

    // Calculated sustain: amortized heal and shield per turn
    var healPerTurn = 0
    var shieldPerTurn = 0
    var hasLiberation = false
    var hasTeleport = false
    var wisScale = 1 + wis / 100
    for (var cid in chips) {
        // Heal estimation
        if (mapContainsKey(ROLE_HEALING, cid)) {
            var effs = getChipEffects(cid)
            if (effs != null) {
                for (var eff in effs) {
                    if (eff[0] == EFFECT_HEAL) {
                        var avgHeal = (eff[1] + eff[2]) / 2 * wisScale
                        // HoT: multiply by duration
                        if (eff[3] != null && eff[3] > 0) avgHeal *= eff[3]
                        var cd = getChipCooldown(cid)
                        if (cd == null || cd <= 0) cd = 5  // once-per-fight → amortize over 5
                        healPerTurn += avgHeal / cd
                    }
                }
            }
        }
        // Shield estimation
        if (mapContainsKey(ROLE_SHIELD_ABSOLUTE, cid) || mapContainsKey(ROLE_SHIELD_RELATIVE, cid)) {
            var effs = getChipEffects(cid)
            if (effs != null) {
                for (var eff in effs) {
                    if (eff[0] == EFFECT_ABSOLUTE_SHIELD || eff[0] == EFFECT_RELATIVE_SHIELD) {
                        var avgShield = (eff[1] + eff[2]) / 2
                        if (eff[0] == EFFECT_RELATIVE_SHIELD) avgShield *= 30
                        if (eff[3] != null && eff[3] > 0) avgShield *= eff[3]
                        var cd = getChipCooldown(cid)
                        if (cd == null || cd <= 0) cd = 5
                        shieldPerTurn += avgShield / cd
                    }
                }
            }
        }
        if (cid == CHIP_LIBERATION) hasLiberation = true
        if (cid == CHIP_TELEPORTATION || cid == CHIP_JUMP || cid == CHIP_INVERSION) hasTeleport = true
    }
    profile['healPerTurn'] = floor(healPerTurn)
    profile['shieldPerTurn'] = floor(shieldPerTurn)
    profile['hasLiberation'] = hasLiberation
    profile['hasTeleport'] = hasTeleport
    profile['mobilityMP'] = enemy._currMp != null ? enemy._currMp : 3

    __enemyProfile[eid] = profile

}

function detectEnemyBuildType(str, mag, agi, sci, res) {
    if (res >= 300 && sci >= 300) return BUILD_TANK_SCI
    if (str > 400 && agi > 400) return BUILD_BRUISER_REFLECT
    if (str >= mag && str >= agi && sci >= 200) return BUILD_STRENGTH_SCIENCE
    if (mag > str + 100) return BUILD_MAGIC
    if (abs(str - mag) < 100 && mag >= 100 && str >= 100) return BUILD_HYBRID
    if (agi >= str && agi >= mag) return BUILD_AGILITY
    if (mag >= str) return BUILD_MAGIC
    return BUILD_STRENGTH
}

function getEnemyProfile(enemyId) {
    if (mapContainsKey(__enemyProfile, enemyId)) {
        return __enemyProfile[enemyId]
    }
    return null
}

function profileAllEnemies(fieldMap) {
    var enemies = fieldMap.getEnemySubMap()
    for (var eid in mapKeys(enemies)) {
        if (!isDead(eid)) {
            profileEnemy(enemies[eid])
        }
    }
}

function predictEnemyCanAttackWithin(playerPos, enemy, turnsWindow) {
    if (enemy == null) return true
    var dist = getCellDistance(playerPos, enemy._cellPos)
    if (dist == null) return true

    var maxRange = 8
    var profile = getEnemyProfile(enemy._id)
    if (profile != null && profile['preferredRange'] != null && profile['preferredRange'] > 0) {
        maxRange = profile['preferredRange']
    } else {
        var weapons = getWeapons(enemy._id)
        if (weapons != null) {
            for (var wid in weapons) {
                var wr = getWeaponMaxRange(wid)
                if (wr != null && wr > maxRange) maxRange = wr
            }
        }
    }

    var enemyMP = enemy._currMp
    if (enemyMP == null || enemyMP <= 0) enemyMP = 7

    var gapToClose = max(0, dist - maxRange)
    return gapToClose <= (enemyMP * turnsWindow)
}

function observeEnemyBehavior(fieldMap) {
    var currentTurn = getTurn()
    var enemies = fieldMap.getEnemySubMap()

    for (var eid in mapKeys(enemies)) {
        if (isDead(eid)) continue
        var enemy = enemies[eid]

        if (!mapContainsKey(__enemyObservations, eid)) {
            __enemyObservations[eid] = [
                'turnsObserved': 0,
                'timesShielded': 0,
                'lastHP': enemy._currHealth,
                'hpTrend': 0
            ]
        }

        var obs = __enemyObservations[eid]
        obs['turnsObserved'] = obs['turnsObserved'] + 1

        var hpChange = enemy._currHealth - obs['lastHP']
        obs['hpTrend'] = obs['hpTrend'] * 0.7 + hpChange * 0.3
        obs['lastHP'] = enemy._currHealth

        if (enemy.hasEffect(EFFECT_RELATIVE_SHIELD) || enemy.hasEffect(EFFECT_ABSOLUTE_SHIELD)) {
            obs['timesShielded'] = obs['timesShielded'] + 1
        }

        __enemyObservations[eid] = obs

        // Phase 3.4: Update enemy profile every 5 turns based on observed behavior
        if (obs['turnsObserved'] % 5 == 0 && mapContainsKey(__enemyProfile, eid)) {
            updateEnemyProfile(eid, obs, enemy)
        }
    }
}

function updateEnemyProfile(eid, obs, enemy) {
    var profile = __enemyProfile[eid]
    var turnsObs = obs['turnsObserved']

    // If enemy shields frequently but wasn't flagged as tank, update.
    // Frequency threshold lowered from 0.4 → 0.33 so a tank shielding on
    // turns 2,5,8 (33%) is caught earlier; also triggers on just 2 shields
    // if resistance/sci stats are high (hard-evidence tank profile).
    if (!profile['isTank']) {
        if (obs['timesShielded'] >= 3 && obs['timesShielded'] * 1.0 / turnsObs > 0.33) {
            profile['isTank'] = true
            profile['isBurstBuild'] = false
        } else if (obs['timesShielded'] >= 2 && enemy != null) {
            var eResistance = enemy._resistance != null ? enemy._resistance : 0
            var eScience = enemy._science != null ? enemy._science : 0
            if (eResistance >= 300 && eScience >= 200) {
                profile['isTank'] = true
                profile['isBurstBuild'] = false
            }
        }
    }

    // If enemy HP trend is consistently positive, they have strong healing
    if (obs['hpTrend'] > 20 && turnsObs >= 5) {
        profile['hasHeal'] = true
    }

    // Update max burst estimate from observed HP drops we dealt
    // (negative hpTrend on our side means enemy is doing damage)
    // Track if enemy does more damage than initially estimated
    var currentHP = enemy._currHealth
    var maxHP = enemy._maxHealth
    if (maxHP != null && maxHP > 0 && currentHP != null) {
        var hpPercent = currentHP * 100 / maxHP
        // If enemy is at high HP after many turns, they're sustaining well
        if (turnsObs >= 10 && hpPercent > 70) {
            profile['isTank'] = true
        }
    }

    __enemyProfile[eid] = profile
}

function getEnemyObservation(enemyId) {
    if (mapContainsKey(__enemyObservations, enemyId)) {
        return __enemyObservations[enemyId]
    }
    return null
}
