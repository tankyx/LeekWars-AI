// ============================================================
// LeekWars Community Challenge: Reachability Benchmark (LS4)
// 4 pathfinding functions using precomputed adjacency + BFS
// Seed 1 required for reference validation
// ============================================================

// --- Performance globals ---
global CUMUL_COUT_TOTAL = 0
global CUMUL_COUT_CE_TOUR
CUMUL_COUT_CE_TOUR = 0
global SUMMARY = ""
global run12, run5, run0, jump12, jump5, jump0, tp12, tp5, tp0, jumpTp12, jumpTp5, jumpTp0

// --- Precomputed data (built once on turn 1, persists via globals) ---
global ADJ = null       // ADJ[cell] = array of walkable neighbor cells
global NON_OBS = null   // Array of all non-obstacle cell IDs
global CQ = null        // Cube Q coordinate per cell (map, null = obstacle)
global CR = null        // Cube R coordinate per cell

// Chip ranges (CHIP_JUMP: 1-3, CHIP_TELEPORTATION: 1-12, both through obstacles)
global J_MIN = 1
global J_MAX = 3
global T_MIN = 1
global T_MAX = 12

// ============================================================
// INITIALIZATION (turn 1 only, ~70K ops)
// ============================================================

function buildAll() {
    if (ADJ != null) return null

    var deltas = [1, -1, 17, -17, 18, -18]
    ADJ = [:]
    NON_OBS = []
    CQ = [:]
    CR = [:]

    // Pass 1: Coordinates for all non-obstacle cells
    for (var cell = 0; cell < 613; cell++) {
        if (isObstacle(cell)) continue
        push(NON_OBS, cell)
        var cx = getCellX(cell)
        var cy = getCellY(cell)
        // Offset -> cube conversion (odd-r pointy-top hex)
        CQ[cell] = cx - (cy - (cy % 2)) / 2
        CR[cell] = cy
    }

    // Pass 2: Adjacency (validate hex distance = 1)
    for (var cell in NON_OBS) {
        var neighbors = []
        for (var d in deltas) {
            var nb = cell + d
            if (nb >= 0 && nb < 613 && CQ[nb] != null) {
                if (hexD(cell, nb) == 1) {
                    push(neighbors, nb)
                }
            }
        }
        ADJ[cell] = neighbors
    }

    return null
}

// Cube-coordinate hex distance — O(1), no API calls
function hexD(c1, c2) {
    var dq = CQ[c2] - CQ[c1]
    var dr = CR[c2] - CR[c1]
    var ds = -dq - dr
    if (dq < 0) dq = -dq
    if (dr < 0) dr = -dr
    if (ds < 0) ds = -ds
    if (dq >= dr && dq >= ds) return dq
    if (dr >= ds) return dr
    return ds
}

// ============================================================
// Jump expansion: per-cell bounded search (cell +/- 54)
// Checks ~108 cells, finds ~30 in range. Fast for small range.
// ============================================================

function doJump(cell, visT, R, frT) {
    var lo = cell - 54
    if (lo < 0) lo = 0
    var hi = cell + 54
    if (hi > 612) hi = 612
    for (var t = lo; t <= hi; t++) {
        if (CQ[t] == null) continue
        if (visT[t] != null) continue
        var d = hexD(cell, t)
        if (d >= J_MIN && d <= J_MAX) {
            visT[t] = true
            R[t] = t
            push(frT, t)
        }
    }
}

// ============================================================
// TP expansion: batched — iterate NON_OBS once, early break
// For range 12 (~entire map), most cells match immediately.
// Returns array of newly added cells.
// ============================================================

function doTPBatch(sources, visT, R, frT) {
    var added = []
    if (count(sources) == 0) return added
    for (var t in NON_OBS) {
        if (visT[t] != null) continue
        for (var src in sources) {
            var d = hexD(src, t)
            if (d >= T_MIN && d <= T_MAX) {
                visT[t] = true
                R[t] = t
                push(frT, t)
                push(added, t)
                break
            }
        }
    }
    return added
}

// ============================================================
// FUNCTION 1: runOnlyCells — Pure walking BFS
// ============================================================

function runOnlyCells(fromCell, MP) {
    var R = [fromCell: fromCell]
    if (MP <= 0) return R
    var fr = [fromCell]
    var vis = [fromCell: true]
    for (var d = 1; d <= MP; d++) {
        var nf = []
        for (var c in fr) {
            var nb = ADJ[c]
            if (nb == null) continue
            for (var n in nb) {
                if (vis[n] == null) {
                    vis[n] = true
                    R[n] = n
                    push(nf, n)
                }
            }
        }
        fr = nf
    }
    return R
}

// ============================================================
// FUNCTION 2: runJumpCells — Walking + single Jump chip use
// 2-state BFS: v1 = jump available, v0 = jump used
// ============================================================

function runJumpCells(fromCell, MP) {
    var R = [fromCell: fromCell]
    var v0 = [:]
    var v1 = [:]
    v1[fromCell] = true
    var f0 = []
    var f1 = [fromCell]

    // Jump at distance 0
    doJump(fromCell, v0, R, f0)

    for (var d = 1; d <= MP; d++) {
        var n0 = []
        var n1 = []

        // Walk from jump-available frontier
        for (var c in f1) {
            var nb = ADJ[c]
            if (nb == null) continue
            for (var n in nb) {
                if (v1[n] == null) {
                    v1[n] = true
                    R[n] = n
                    push(n1, n)
                }
            }
        }

        // Walk from jump-used frontier
        for (var c in f0) {
            var nb = ADJ[c]
            if (nb == null) continue
            for (var n in nb) {
                if (v0[n] == null) {
                    v0[n] = true
                    R[n] = n
                    push(n0, n)
                }
            }
        }

        // Jump from newly walked jump-available cells
        for (var c in n1) {
            doJump(c, v0, R, n0)
        }

        f0 = n0
        f1 = n1
    }

    return R
}

// ============================================================
// FUNCTION 3: runTeleportationCells — Walking + single TP use
// 2-state BFS: v1 = tp available, v0 = tp used
// ============================================================

function runTeleportationCells(fromCell, MP) {
    var R = [fromCell: fromCell]
    var v0 = [:]
    var v1 = [:]
    v1[fromCell] = true
    var f0 = []
    var f1 = [fromCell]

    // TP at distance 0
    doTPBatch([fromCell], v0, R, f0)

    for (var d = 1; d <= MP; d++) {
        var n0 = []
        var n1 = []

        // Walk from tp-available frontier
        for (var c in f1) {
            var nb = ADJ[c]
            if (nb == null) continue
            for (var n in nb) {
                if (v1[n] == null) {
                    v1[n] = true
                    R[n] = n
                    push(n1, n)
                }
            }
        }

        // Walk from tp-used frontier
        for (var c in f0) {
            var nb = ADJ[c]
            if (nb == null) continue
            for (var n in nb) {
                if (v0[n] == null) {
                    v0[n] = true
                    R[n] = n
                    push(n0, n)
                }
            }
        }

        // TP from newly walked tp-available cells (batched)
        doTPBatch(n1, v0, R, n0)

        f0 = n0
        f1 = n1
    }

    return R
}

// ============================================================
// FUNCTION 4: runJumpTeleportationCells — Walking + Jump + TP
// 4-state BFS: bit0=jump, bit1=tp
// s=0: none, s=1: jump only, s=2: tp only, s=3: both
// ============================================================

function runJumpTeleportationCells(fromCell, MP) {
    var R = [fromCell: fromCell]

    // 4 visited maps
    var v = []
    push(v, [:])
    push(v, [:])
    push(v, [:])
    push(v, [:])
    v[3][fromCell] = true

    // 4 frontiers
    var fr = []
    push(fr, [])
    push(fr, [])
    push(fr, [])
    push(fr, [fromCell])

    // Distance 0: chip expansion
    chipExpand(fr, v, R)

    for (var d = 1; d <= MP; d++) {
        var nf = []
        push(nf, [])
        push(nf, [])
        push(nf, [])
        push(nf, [])

        // Walk from each state's frontier
        for (var s = 0; s < 4; s++) {
            for (var c in fr[s]) {
                var nb = ADJ[c]
                if (nb == null) continue
                for (var n in nb) {
                    if (v[s][n] == null) {
                        v[s][n] = true
                        R[n] = n
                        push(nf[s], n)
                    }
                }
            }
        }

        // Chip expansion from newly walked cells
        chipExpand(nf, v, R)

        fr = nf
    }

    return R
}

// Chip expansion with 2-round cascade for combined Jump+TP
// Handles: Jump(3->2), Jump(1->0), TP(3->1), TP(2->0),
//          then cascade: Jump(new1->0), TP(new2->0)
function chipExpand(nf, v, R) {
    // Round 1a: Jump from state 3 -> state 2
    for (var c in nf[3]) {
        doJump(c, v[2], R, nf[2])
    }
    // Round 1b: Jump from state 1 -> state 0
    for (var c in nf[1]) {
        doJump(c, v[0], R, nf[0])
    }

    // Round 2a: TP from state 3 -> state 1 (returns newly added state-1 cells)
    var newS1 = doTPBatch(nf[3], v[1], R, nf[1])
    // Round 2b: TP from state 2 -> state 0 (nf[2] includes jump-added cells from 1a)
    doTPBatch(nf[2], v[0], R, nf[0])

    // Round 3: Cascade — Jump from TP-added state-1 cells -> state 0
    for (var c in newS1) {
        doJump(c, v[0], R, nf[0])
    }
    // Note: Jump-added state-2 cells were already TP-expanded in Round 2b
    // (they're in nf[2] which was used as source). No further cascade needed.
}

// ============================================================
// MAIN EXECUTION
// ============================================================

buildAll()

saveOpe("Initialisation tour " + getTurn(), getOperations())
if(getTurn()==1){
    initReferences()
    bench('Cases accessibles depuis la cellule 457 avec 12 MP', runOnlyCells, 457, 12, run12)
    bench('Cases accessibles depuis la cellule 457 avec 5 MP', runOnlyCells, 457, 5, run5)
    bench('Cases accessibles depuis la cellule 457 avec 0 MP', runOnlyCells, 457, 0, run0)
}
if(getTurn()==2){
    bench('Cases accessibles depuis la cellule 439 avec 12 MP + Saut', runJumpCells, 439, 12, jump12)
    bench('Cases accessibles depuis la cellule 439 avec 5 MP + Saut', runJumpCells, 439, 5, jump5)
    bench('Cases accessibles depuis la cellule 439 avec 0 MP + Saut', runJumpCells, 439, 0, jump0)
}
if(getTurn()==3){
    bench('Cases accessibles depuis la cellule 421 avec 12 MP + Teleportation', runTeleportationCells, 421, 12, tp12)
    bench('Cases accessibles depuis la cellule 421 avec 5 MP + Teleportation', runTeleportationCells, 421, 5, tp5)
    bench('Cases accessibles depuis la cellule 421 avec 0 MP + Teleportation', runTeleportationCells, 421, 0, tp0)
}
if(getTurn()==4){
    bench('Cases accessibles depuis la cellule 403 avec 12 MP + Saut + Teleportation', runJumpTeleportationCells, 403, 12, jumpTp12)
    bench('Cases accessibles depuis la cellule 403 avec 5 MP + Saut + Teleportation', runJumpTeleportationCells, 403, 5, jumpTp5)
    bench('Cases accessibles depuis la cellule 403 avec 0 MP + Saut + Teleportation', runJumpTeleportationCells, 403, 0, jumpTp0)
}

say("Operations cumulated this turn: " + CUMUL_COUT_CE_TOUR)
SUMMARY += "Operation tour " + getTurn() + " : " + CUMUL_COUT_CE_TOUR + "\n"
say("Operations cumulated total: " + CUMUL_COUT_TOTAL)
if (getTurn() == 4) {
    SUMMARY += "Operations totales : " + CUMUL_COUT_TOTAL
    debug(SUMMARY)
    pause()
}

// ============================================================
// SCAFFOLD (provided by benchmark — do not modify)
// ============================================================

function initReferences(){
    run12 = binToCells([0,0,0,279223176896970752,8070586872142759808,16888628525916163,918742501634343146,-1152820349033763968,71776391793205249,133693948])
    run5 = binToCells([0,0,0,0,0,1125899906842624,54043676568453130,-1152890718046387328,32212377600,0])
    run0 = binToCells([0,0,0,0,0,0,0,512,0,0])
    jump12 = binToCells([0,0,17873661021126656,3449766041984696444,8072557209864636288,142990380168634399,2071672802501986282,-1148879684327347328,143834260711137305,536348668])
    jump5 = binToCells([0,0,0,0,8070586871689773056,16888559806439425,918738103587831914,-1152820349033772160,17733058824757249,252])
    jump0 = binToCells([0,0,0,0,0,0,54043676568453130,30786560459648,0,0])
    tp12 = binToCells([-5304695447839031489,-540442881932724095,2305711056074305783,-1161365818354417796,8088319997539452807,2304734694006055039,2072657966531117034,-1090332631471527033,4467305296258654521,8589441020])
    tp5 = binToCells([0,-576460752303423488,143975538292158487,8061513633264568188,8074809009678387072,287105568244490271,2071672802501986282,-1148879667147478144,143834260711137337,536348668])
    tp0 = binToCells([0,0,0,1143923032771002368,8070868347119470464,34903164474875911,2071672802367767018,-1152257396932842624,71776391793205249,133693948])
    jumpTp12 = binToCells([-5304695445691531457,-504414084912711547,4611562861448131063,-1160802864106012804,8088319997540501391,4610595295472902271,2073783870732959722,-1090332356591522929,9079008907006305081,17179408380])
    jumpTp5 = binToCells([3918131675812331520,-571968113684187008,288091825883836471,-1161788034577592452,8079312626485757824,575337043916218431,2071672803038859242,-1144376033160238207,432066835894493241,1073223676])
    jumpTp0 = binToCells([0,0,71916982178410496,3449774838144827772,8071431301367859072,70932236372795407,2071672802367767530,-1151131492731032704,143834260711137289,267912188])
}

function binToCells(d){
    var i=0
    var j=0
    var m=[:]
    for (var c=0; c<613; c++){
        if (d[i] & 1<<j) m[c] = c
        j++
        if (j>63) {j=0;i++;}
    }
    return m
}

function saveOpe(label, newOpe){
    var str = label + " -> operations : " + newOpe
    debug(str)
    SUMMARY += str + "\n"
    CUMUL_COUT_CE_TOUR += newOpe
    CUMUL_COUT_TOTAL += newOpe
}

function checkResult(resultList, referenceList){
    clearMarks()
    mark(mapKeys(referenceList), getColor(255, 255, 0))
    for (var cell in resultList){
        if (referenceList[cell] != null) mark(cell, COLOR_GREEN)
        else mark(cell, COLOR_RED)
    }
}

function bench(label, pathFunc, startCell, mp, reference){
    var opeBefore = getOperations()
    var cellList = pathFunc(startCell, mp)
    var newOpe = getOperations() - opeBefore
    if (typeOf(cellList) == TYPE_MAP) cellList = mapKeys(cellList)
    checkResult(cellList, reference)
    saveOpe(label, newOpe)
    pause()
}
