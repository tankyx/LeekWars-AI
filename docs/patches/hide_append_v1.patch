+    // simulator uses to accept a move). Lowest adversarial threat first,
+    // then farthest from the enemy, then shortest path. Returns -1 when no
+    // such cell exists or every candidate is rated MORE dangerous than
+    // staying put (the cache knows about enemy MP; current LoS does not).
+    findLosBreakCell(origin, mpBound, enemyCell) {
+        if (origin == -1 || mpBound <= 0 || enemyCell == null || enemyCell == -1) return -1
+        var acc = this.getAccessibleCells(player)
+        var best = -1
+        var bestThreat = 999999999
+        var bestDist = -1
+        var bestLen = 999
+        var originThreat = getAdversarialThreat(origin)
+        for (var i = 0; i < count(acc); i++) {
+            var c = acc[i]
+            if (c == origin) continue
+            var d = getCellDistance(origin, c)
+            if (d == null || d > mpBound) continue
+            if (getCachedLineOfSight(c, enemyCell)) continue
+            var len = getCachedPathLength(origin, c)
+            if (len == null || len <= 0 || len > mpBound) continue
+            var th = getAdversarialThreat(c)
+            var ed = getCellDistance(c, enemyCell)
+            if (ed == null) ed = 0
+            if (th < bestThreat || (th == bestThreat && ed > bestDist) || (th == bestThreat && ed == bestDist && len < bestLen)) {
+                best = c
+                bestThreat = th
+                bestDist = ed
+                bestLen = len
+            }
+        }
+        if (best != -1 && bestThreat > originThreat) return -1
+        return best
+    }
