+    generateMoveCellDescriptors(scenario) {
+        var descriptors = []
+        var moveIdx = -1
+        for (var i = 0; i < count(scenario); i++) {
+            var a = scenario[i]
+            if (a.type == Action.MOVEMENT_OFFENSIVE || a.type == Action.MOVEMENT_APPROACH) { moveIdx = i; break }
