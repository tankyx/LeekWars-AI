@@ -987,6 +987,25 @@ class FieldMap extends FieldMapPatterns {
         return best
     }
 
+    // Multi-cell variants (2026-09-22): the top-k firing cells by the same
+    // base score as findBestTacticalCell, so the mutation planner can offer
+    // "the same plan, fired from the runner-up cell" as a full candidate.
+    findTopTacticalCells(maxMP, threatWeight, k) {
+        var playerPos = player._cellPos
+        var scored = []
+        for (var cellId in mapKeys(this.damageMap)) {
+            var cell = this.damageMap[cellId]
+            var pathLen = getCachedPathLength(playerPos, cell._id)
+            if (pathLen == null || pathLen > maxMP) continue
+            var score = cell._totalDamage - (this.getThreatAtCell(cell._id) * threatWeight) + this.calculateMultiTargetBonus(cell._id) - pathLen * 2.0
+            push(scored, [score, cell._id])
+        }
+        arraySort(scored, function(a, b) { return b[0] - a[0] })
+        var out = []
+        for (var i = 0; i < count(scored) && i < k; i++) push(out, scored[i][1])
+        return out
+    }
+
     calculateMultiTargetBonus(cellId) {
         var enemies = this.getEnemySubMap()
         if (count(mapKeys(enemies)) <= 1) return 0
