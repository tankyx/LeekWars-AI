// Prod value model runtime (2026-09-28): P(win | state at the start of my
// turn), trained on 15.7k real solo fights with sign constraints (see
// tools/value_train_mono.py). Weights + feature layout live in the generated
// value_net_data.lk (tools/value_export_lk.py); the feature order here must
// match tools/value_dataset.py NAMES:
//   turn, dist, los, then per side (me, op):
//   hp, hpfrac, maxhp, level, tp, mp, str, mag, agi, res, wis, sci,
//   20 effect groups (sorted names), poison_future, summons
// Stats are the fight-start (unbuffed) stats the model was trained on:
// current value minus live buffs plus live shackles.

global _vnDebug = false
global __vnMu = null
global __vnSd = null
global __vnSign = null
global __vnW1 = null
global __vnB1 = null
global __vnW2 = null
global __vnB2 = null
global __vnW3 = null
global __vnB3 = null

function vnParseVec(s) {
    var out = []
    for (var tok in split(s, ';')) push(out, number(tok))
    return out
}

function vnParseMat(s) {
    var out = []
    for (var row in split(s, '|')) push(out, vnParseVec(row))
    return out
}

function vnInit() {
    if (__vnW1 == null) {
        __vnMu = vnParseVec(__vnS_Mu); __vnSd = vnParseVec(__vnS_Sd); __vnSign = vnParseVec(__vnS_Sign)
        __vnW1 = vnParseMat(__vnS_W1); __vnB1 = vnParseVec(__vnS_B1)
        __vnW2 = vnParseMat(__vnS_W2); __vnB2 = vnParseVec(__vnS_B2)
        __vnW3 = vnParseMat(__vnS_W3); __vnB3 = vnParseVec(__vnS_B3)
    }
}

function vnTanh(x) {
    if (x > 15) return 1.0
    if (x < -15) return -1.0
    var e = exp(2 * x)
    return (e - 1) / (e + 1)
}

function vnSoftplus(x) {
    if (x > 20) return x
    return log(1 + exp(x))
}

// Per-group sums of live effects on `e`, plus poison value x turns left.
// Returns [groups(array), poisonFuture].
function vnEffects(e) {
    var g = []
    for (var i = 0; i < __vnNGroups; i++) push(g, 0)
    var pf = 0
    var effs = getEffects(e)
    if (effs != null) {
        for (var ef in effs) {
            var t = ef[0]
            if (!mapContainsKey(__vnGroupOf, t)) continue
            g[__vnGroupOf[t]] += ef[1]
            if (t == EFFECT_POISON) pf += ef[1] * max(1, ef[3])
        }
    }
    return [g, pf]
}

function vnSumTypes(e, types) {
    var s = 0
    var effs = getEffects(e)
    if (effs == null) return 0
    for (var ef in effs) {
        if (inArray(types, ef[0])) s += ef[1]
    }
    return s
}

// v2 features (2026-09-28): max HP burned since first seen (nova/erosion:
// every decrease of max life between our observations; increases are
// vitality), kit potential (best single weapon/damage chip per turn at full
// TP: direct / nova / poison) and reach (dist <= MP + max range).
global __vnLastMax = [:]
global __vnBurn = [:]
global __vnKit = [:]

function vnTrackBurn(e) {
    var cur = getTotalLife(e)
    if (mapContainsKey(__vnLastMax, e)) {
        var dl = cur - __vnLastMax[e]
        if (dl < 0) {
            __vnBurn[e] = (mapContainsKey(__vnBurn, e) ? __vnBurn[e] : 0) - dl
        }
    }
    __vnLastMax[e] = cur
}

function vnBurned(e) {
    return mapContainsKey(__vnBurn, e) ? __vnBurn[e] : 0
}

function vnItemKit(effs, cost, uses, tp, stre, mag, sci) {
    if (effs == null || cost == null || cost < 1) return [0, 0, 0]
    var u = floor(tp / cost)
    if (uses != null && uses > 0 && uses < u) u = uses
    var dm = 0; var nv = 0; var ps = 0
    for (var ef in effs) {
        var avg = (ef[1] + ef[2]) / 2
        if (ef[0] == EFFECT_DAMAGE) dm += avg * (1 + stre / 100.0)
        else if (ef[0] == EFFECT_NOVA_DAMAGE) nv += avg * (1 + sci / 100.0)
        else if (ef[0] == EFFECT_POISON) ps += avg * max(1, ef[3]) * (1 + mag / 100.0)
    }
    return [dm * u, nv * u, ps * u]
}

// [maxRange, kdmg, knova, kpois] from equipped weapons + damage chips, with
// the unbuffed stats / TP the model was trained on; cached per entity.
function vnKitOf(e, tp, stre, mag, sci) {
    if (mapContainsKey(__vnKit, e)) return __vnKit[e]
    var rng = 0; var kd = 0; var kn = 0; var kp = 0
    var ws = getWeapons(e)
    if (ws != null) {
        for (var w in ws) {
            var r = vnItemKit(getWeaponEffects(w), getWeaponCost(w), getWeaponMaxUses(w), tp, stre, mag, sci)
            if (r[0] + r[1] + r[2] <= 0) continue
            var mr = getWeaponMaxRange(w)
            if (mr != null && mr > rng) rng = mr
            kd = max(kd, r[0]); kn = max(kn, r[1]); kp = max(kp, r[2])
        }
    }
    var cs = getChips(e)
    if (cs != null) {
        for (var c in cs) {
            var r2 = vnItemKit(getChipEffects(c), getChipCost(c), getChipMaxUses(c), tp, stre, mag, sci)
            if (r2[0] + r2[1] + r2[2] <= 0) continue
            var mr2 = getChipMaxRange(c)
            if (mr2 != null && mr2 > rng) rng = mr2
            kd = max(kd, r2[0]); kn = max(kn, r2[1]); kp = max(kp, r2[2])
        }
    }
    __vnKit[e] = [rng, kd, kn, kp]
    return __vnKit[e]
}

// Side block (me or op). hp / addG / addPf let search evaluate a
// hypothetical state (null / [] / 0 = current).
function vnSide(f, e, hp, addG, addPf, dist) {
    var mx = max(1, getTotalLife(e))
    var h = (hp == null) ? getLife(e) : hp
    h = max(0, min(mx, h))
    var burn = vnBurned(e)
    push(f, h / 3000.0); push(f, h / max(1, mx + burn)); push(f, mx / 3000.0); push(f, getLevel(e) / 301.0)
    var tp = getTotalTP(e) - vnSumTypes(e, [8, 32]) + vnSumTypes(e, [18])
    var mp = getTotalMP(e) - vnSumTypes(e, [7, 31]) + vnSumTypes(e, [17])
    push(f, tp / 30.0); push(f, mp / 8.0)
    push(f, (getStrength(e) - vnSumTypes(e, [3, 38]) + vnSumTypes(e, [19])) / 600.0)
    var bStr = getStrength(e) - vnSumTypes(e, [3, 38]) + vnSumTypes(e, [19])
    var bMag = getMagic(e) - vnSumTypes(e, [39]) + vnSumTypes(e, [24])
    var bSci = getScience(e) - vnSumTypes(e, [40])
    push(f, (getMagic(e) - vnSumTypes(e, [39]) + vnSumTypes(e, [24])) / 600.0)
    push(f, (getAgility(e) - vnSumTypes(e, [4, 41]) + vnSumTypes(e, [47])) / 600.0)
    push(f, (getResistance(e) - vnSumTypes(e, [21, 42])) / 600.0)
    push(f, (getWisdom(e) - vnSumTypes(e, [22, 44]) + vnSumTypes(e, [48])) / 600.0)
    push(f, (getScience(e) - vnSumTypes(e, [40])) / 600.0)
    var eg = vnEffects(e)
    var g = eg[0]
    for (var i = 0; i < __vnNGroups; i++) {
        var v = g[i]
        if (addG != null && count(addG) > i) v += addG[i]
        push(f, v / __vnGScale[i])
    }
    push(f, (eg[1] + addPf) / 1000.0)
    var team = (e == getEntity()) ? getAliveAllies() : ((isAlly(e)) ? getAliveAllies() : getAliveEnemies())
    var sm = 0
    for (var o in team) {
        if (isSummon(o)) sm++
    }
    push(f, sm / 2.0)
    var kit = vnKitOf(e, tp, max(0, bStr), max(0, bMag), max(0, bSci))
    push(f, burn / 3000.0)
    push(f, kit[0] / 10.0); push(f, kit[1] / 1000.0); push(f, kit[2] / 1000.0); push(f, kit[3] / 1000.0)
    push(f, (dist <= mp + kit[0]) ? 1.0 : 0.0)
}

// Feature vector for (me, op). Cells / HP / adds may describe a simulated
// state; pass null / null / [] / 0 for the current one.
function vnFeatures(me, op, meCell, opCell, meHp, opHp, meAddG, opAddG, mePf, opPf) {
    var cm = (meCell == null) ? getCell(me) : meCell
    var co = (opCell == null) ? getCell(op) : opCell
    var f = [getTurn() / 30.0]
    var d = getCellDistance(cm, co)
    if (d == null) d = 10
    push(f, d / 20.0)
    push(f, lineOfSight(cm, co, [me, op]) ? 1.0 : 0.0)
    vnTrackBurn(me)
    vnTrackBurn(op)
    vnSide(f, me, meHp, meAddG, mePf, d)
    vnSide(f, op, opHp, opAddG, opPf, d)
    return f
}

// Win probability for the side whose features come first.
function vnValue(f) {
    vnInit()
    var z = []
    for (var i = 0; i < __vnNFeat; i++) {
        var v = (f[i] - __vnMu[i]) / __vnSd[i]
        if (v > __vnClip) v = __vnClip
        if (v < -__vnClip) v = -__vnClip
        push(z, v)
    }
    var nC = count(__vnCtxIdx)
    var h1 = []
    for (var j = 0; j < count(__vnB1); j++) {
        var s = __vnB1[j]
        for (var k = 0; k < nC; k++) s += z[__vnCtxIdx[k]] * __vnW1[k][j]
        push(h1, vnTanh(s))
    }
    var h2 = []
    for (var j2 = 0; j2 < count(__vnB2); j2++) {
        var s2 = __vnB2[j2]
        for (var k2 = 0; k2 < count(h1); k2++) s2 += h1[k2] * __vnW2[k2][j2]
        push(h2, vnTanh(s2))
    }
    var nO = count(__vnB3)
    var logit = 0
    for (var o = 0; o < nO; o++) {
        var s3 = __vnB3[o]
        for (var k3 = 0; k3 < count(h2); k3++) s3 += h2[k3] * __vnW3[k3][o]
        if (o == 0) {
            logit += s3
        } else {
            logit += __vnSign[o - 1] * vnSoftplus(s3) * z[__vnMonoIdx[o - 1]]
        }
    }
    return 1.0 / (1.0 + exp(-logit))
}

// The enemy main leek (1v1): first alive non-summon enemy.
function vnMainEnemy() {
    for (var e in getAliveEnemies()) {
        if (!isSummon(e)) return e
    }
    return null
}

// Debug: features + value for the current state, logged once per turn.
function vnLogTurn(enemyId) {
    if (!_vnDebug || enemyId == null) { return }
    var ops0 = getOperations()
    var f = vnFeatures(getEntity(), enemyId, null, null, null, null, [], [], 0, 0)
    var p = vnValue(f)
    var s = ""
    for (var i = 0; i < count(f); i++) {
        s += (i > 0 ? "," : "") + round(f[i] * 10000) / 10000
    }
    debugW("VNF_T" + getTurn() + "|" + s + "|" + round(p * 10000) / 10000 + "|ops" + (getOperations() - ops0))
}

// ---------------------------------------------------------------------------
// Scenario evaluation (scorer hook). The model predicts for the side ABOUT TO
// ACT; the end of our turn is the start of the opponent's, so a plan's value
// is 1 - P(opponent wins | end state seen from the opponent). The turn's base
// features are built once; per plan only the changed ones are rewritten and
// the context net (depends on distance / LoS here) is cached per (dist, los).
// _v9VnMode: 0 off, 1 add (priced at the model's exchange rate), 2 replace
// (rank by value, old score breaks ties).
global _v9VnMode = 0
global _v9VnScale = 1.0
global __vnTurnKey = -1
global __vnBase = null
global __vnCtxCache = [:]

function vnPrepareTurn(me, op) {
    var key = getTurn() * 100000 + op
    if (key == __vnTurnKey && __vnBase != null) { return }
    __vnTurnKey = key
    vnInit()
    __vnBase = vnFeatures(op, me, null, null, null, null, [], [], 0, 0)
    __vnCtxCache = [:]
}

// Context net output: [base, slope_1..slope_K] (slopes already softplus'd).
function vnCtxOut(z) {
    var nC = count(__vnCtxIdx)
    var h1 = []
    for (var j = 0; j < count(__vnB1); j++) {
        var s = __vnB1[j]
        for (var k = 0; k < nC; k++) s += z[__vnCtxIdx[k]] * __vnW1[k][j]
        push(h1, vnTanh(s))
    }
    var h2 = []
    for (var j2 = 0; j2 < count(__vnB2); j2++) {
        var s2 = __vnB2[j2]
        for (var k2 = 0; k2 < count(h1); k2++) s2 += h1[k2] * __vnW2[k2][j2]
        push(h2, vnTanh(s2))
    }
    var out = []
    for (var o = 0; o < count(__vnB3); o++) {
        var s3 = __vnB3[o]
        for (var k3 = 0; k3 < count(h2); k3++) s3 += h2[k3] * __vnW3[k3][o]
        push(out, (o == 0) ? s3 : vnSoftplus(s3))
    }
    return out
}

function vnAdd(f, name, v) {
    f[__vnIdx[name]] += v
}

function vnScenarioValue(me, op, sim) {
    vnPrepareTurn(me, op)
    var opMax = max(1, getTotalLife(op))
    var opHp = getLife(op) - sim.damageDealt
    if (opHp <= 0) return 1.0
    var myMax = max(1, getTotalLife(me))
    var myHp = min(myMax, getLife(me) + sim.hpGained - sim.reflectTaken)
    if (myHp <= 0) return 0.0
    var f = []
    for (var v in __vnBase) push(f, v)
    var G = __vnGroupNames
    // nova damage burns the opponent's MAX life (current capped to it); the
    // burn is attrition the model prices on its own (me_burned)
    var opBurn = vnBurned(op)
    if (sim.novaDamageQueued > 0) {
        opMax = max(1, opMax - sim.novaDamageQueued)
        opHp = min(opHp, opMax)
        opBurn += sim.novaDamageQueued
    }
    // opponent = "me_" block (it acts next)
    f[__vnIdx["me_hp"]] = opHp / 3000.0
    f[__vnIdx["me_hpfrac"]] = opHp / max(1, opMax + opBurn)
    f[__vnIdx["me_maxhp"]] = opMax / 3000.0
    f[__vnIdx["me_burned"]] = opBurn / 3000.0
    if (sim.poisonSourcesUsed > 0 && sim.poisonTurnsQueued > 0 && sim.dotDamageQueued > 0) {
        var avgDur = sim.poisonTurnsQueued / sim.poisonSourcesUsed
        vnAdd(f, "me_eff_poison", (sim.dotDamageQueued / max(1, avgDur)) / __vnGScale[__vnGPoison])
        vnAdd(f, "me_poison_future", sim.dotDamageQueued / 1000.0)
    }
    if (sim.strShackleNow > 0) vnAdd(f, "me_eff_shk_str", sim.strShackleNow / __vnGScale[16])
    if (sim.magShackleNow > 0) vnAdd(f, "me_eff_shk_mag", sim.magShackleNow / __vnGScale[14])
    if (sim.tpShackleNow > 0) vnAdd(f, "me_eff_shk_tp", sim.tpShackleNow / __vnGScale[17])
    if (sim.mpShackleNow > 0) vnAdd(f, "me_eff_shk_mp", sim.mpShackleNow / __vnGScale[15])
    if (sim.vulnerabilityApplied > 0) vnAdd(f, "me_eff_vuln", sim.vulnerabilityApplied / __vnGScale[18])
    // us = "op_" block
    f[__vnIdx["op_hp"]] = myHp / 3000.0
    f[__vnIdx["op_hpfrac"]] = myHp / max(1, myMax + vnBurned(me))
    // our own buffs (steroid, rage, motivation, elevation, ...): chip effect
    // amounts into our groups; shields/heals come from the simulator fields
    if (sim.buffsApplied != null && arsenal != null) {
        for (var bc in sim.buffsApplied) {
            if (!mapContainsKey(arsenal.playerEquippedChips, bc)) continue
            var bEff = arsenal.playerEquippedChips[bc]._effects
            for (var et in mapKeys(bEff)) {
                var ba = (bEff[et]._minEffectAmount + bEff[et]._maxEffectAmount) / 2
                if (et == 12) {
                    // vitality: +max and +current life (wisdom-scaled)
                    var vit = ba * (1 + max(0, getWisdom(me)) / 100.0)
                    myMax += vit
                    myHp += vit
                    continue
                }
                if (!mapContainsKey(__vnGroupOf, et)) continue
                // non-raw stat buffs scale with the caster's science (raw ones don't);
                // training features carry the engine's scaled values
                if (et == 3 || et == 4 || et == 7 || et == 8 || et == 21 || et == 22) {
                    ba = ba * (1 + max(0, getScience(me)) / 100.0)
                }
                var gi = __vnGroupOf[et]
                var gn = __vnGroupNames[gi]
                if (gn == "abs_shield" || gn == "rel_shield" || gn == "heal_ot") continue
                f[__vnIdx["op_eff_" + gn]] += ba / __vnGScale[gi]
            }
        }
        f[__vnIdx["op_maxhp"]] = myMax / 3000.0
    }
    if (sim.shieldsGained > 0) vnAdd(f, "op_eff_abs_shield", sim.shieldsGained / __vnGScale[0])
    if (sim.relativeShieldGained > 0) vnAdd(f, "op_eff_rel_shield", sim.relativeShieldGained / __vnGScale[12])
    // position
    var fc = (sim.finalPosition != -1) ? sim.finalPosition : getCell(me)
    var oc = getCell(op)
    var d = getCellDistance(fc, oc)
    if (d == null) d = 10
    var los = lineOfSight(fc, oc, [me, op]) ? 1 : 0
    f[__vnIdx["dist"]] = d / 20.0
    f[__vnIdx["los"]] = los
    f[__vnIdx["op_hp"]] = myHp / 3000.0
    f[__vnIdx["op_hpfrac"]] = myHp / max(1, myMax + vnBurned(me))
    // reach from the final cell: can the opponent (acting next) reach us, can we reach it
    f[__vnIdx["me_reach"]] = (d <= f[__vnIdx["me_mp"]] * 8.0 + f[__vnIdx["me_wrange"]] * 10.0) ? 1.0 : 0.0
    f[__vnIdx["op_reach"]] = (d <= f[__vnIdx["op_mp"]] * 8.0 + f[__vnIdx["op_wrange"]] * 10.0) ? 1.0 : 0.0
    var z = []
    for (var i = 0; i < __vnNFeat; i++) {
        var zz = (f[i] - __vnMu[i]) / __vnSd[i]
        if (zz > __vnClip) zz = __vnClip
        if (zz < -__vnClip) zz = -__vnClip
        push(z, zz)
    }
    var ck = d * 2 + los
    if (!mapContainsKey(__vnCtxCache, ck)) __vnCtxCache[ck] = vnCtxOut(z)
    var out = __vnCtxCache[ck]
    var logit = out[0]
    for (var m = 0; m < count(__vnMonoIdx); m++) {
        logit += __vnSign[m] * out[m + 1] * z[__vnMonoIdx[m]]
    }
    return 1.0 - 1.0 / (1.0 + exp(-logit))
}
