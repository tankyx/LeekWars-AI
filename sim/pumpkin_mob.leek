// Local Pumpkin simulator: the AI of the Evil Pumpkin and its brothers (hubbard, turban, warty, offspring).
// Not the official AI (server-side, unpublished): a reconstruction from 708 real Pumpkin fights
// (tools/pumpkin_fights.py, pumpkin_study.py).
//
// Riddle (exact on the logs):
//   - the mobs speak in cycles of K 3-digit Glagolitic numbers, K = min(3, alive mobs) at the cycle's start;
//   - the mob whose turn comes once K numbers are out holds the slot: a dead brother exists -> the cell is
//     the riddle of the K numbers; taken -> "kopile!!" + exasperation on itself (its Divine Protection drops);
//     free -> "privet brat!" + awakening there on a random dead brother; nobody dead -> "umri!";
//   - the cycle's first number is said with a probability that depends on the alive leeks and mobs
//     (PSTART); the 2nd and 3rd are always said; target cells are random free cells.
// Combat (fitted on the same logs, tools/pumpkin_calibrate.py): attack what can be reached this turn, else
// drift a little; steroid and jump whenever ready, adrenaline only to afford one more shot, liberation on
// shielded targets, antidote when poisoned, hubbard's inversion on the nearest enemy, the pumpkin's scythe
// (walk, jump or teleport next to the nearest reachable enemy).

include('pumpkin_riddle.leek')

global KOPILE = 'ⰽⱁⱂⰻⰾⰵ!!'
global PRIVET = 'ⱂⱃⰻⰲⰵⱅ ⰱⱃⰰⱅ!'
global UMRI = 'ⱆⰿⱃⰻ!'

// item ids (generator data/chips.json, weapons.json)
global C_LIGHTNING = 33
global C_FLASH = 6
global C_JUMP = 144
global C_THUNDER = 416
global C_PLASMA = 143
global C_LIBERATION = 34
global C_STEROID = 25
global C_EXASPERATION = 425
global C_TELEPORT = 59
global C_DP = 419
global C_ADRENALINE = 16
global C_ANTIDOTE = 110
global C_VENOM = 97
global C_TOXIN = 98
global C_PLAGUE = 99
global C_INVERSION = 68
global W_SCYTHE = 410

global ME = getEntity()
global NAME = getName()
global CYCLE = []
global KCYC = 3
global SAID = 0
global LAST_TURN = -1
// decoded once from the compact strings of pumpkin_riddle.leek
global R3 = []
global R2 = []
global S3 = []
global S2 = []
global S1 = []
global NUMSTR = []
global NUMOF = [:]
global READY = false
global PLAGUE_OK = true
global ADRENALINE_OK = true

function bestDiv(n) {
	for (var c = 612; c > 0; c--) {
		if (n % c == 0) {
			return c
		}
	}
	return 0
}

function initTables() {
	for (var c = 0; c < 613; c++) {
		push(S3, [])
		push(S2, [])
		push(S1, [])
	}
	for (var n = 0; n < 1000; n++) {
		var a = number(substring(R3S, n * 9, 3))
		var b = number(substring(R3S, n * 9 + 3, 3))
		var c3 = number(substring(R3S, n * 9 + 6, 3))
		if (c3 > 0) {
			push(R3, [a, b, c3])
			push(S3[c3], n)
		} else {
			push(R3, null)
		}
		var a2 = number(substring(R2S, n * 6, 3))
		var c2 = number(substring(R2S, n * 6 + 3, 3))
		if (c2 > 0) {
			push(R2, [a2, c2])
			push(S2[c2], n)
		} else {
			push(R2, null)
		}
		if (n >= 100) {
			var s = GH[floor(n / 100)] + GT[floor(n / 10) % 10] + GU[n % 10]
			push(NUMSTR, s)
			NUMOF[s] = n
			push(S1[bestDiv(n)], n)
		} else {
			push(NUMSTR, null)
		}
	}
	READY = true
}
if (!READY) {
	initTables()
}

// ---- helpers ----
function aliveMobs() {
	var out = []
	for (var a in getAliveAllies()) {
		if (!isSummon(a)) {
			push(out, a)
		}
	}
	return out
}

function deadBrothers() {
	var out = []
	for (var a in getDeadAllies()) {
		if (!isSummon(a)) {
			push(out, a)
		}
	}
	return out
}

function aliveLeeks() {
	var out = []
	for (var e in getAliveEnemies()) {
		if (!isSummon(e)) {
			push(out, e)
		}
	}
	return out
}

function riddleCell(nums) {
	var k = count(nums)
	if (k == 1) {
		return bestDiv(nums[0])
	}
	if (k == 2) {
		return max(bestDiv(nums[0] * 1000 + nums[1]), bestDiv(nums[1] * 1000 + nums[0]))
	}
	var a = nums[0], b = nums[1], c = nums[2]
	var best = 0
	for (var p in [[a, b, c], [a, c, b], [b, a, c], [b, c, a], [c, a, b], [c, b, a]]) {
		best = max(best, bestDiv(p[0] * 1000000 + p[1] * 1000 + p[2]))
	}
	return best
}

function speak(msg) {
	if (SAID < 2) {
		say(msg)
		SAID++
	}
}

// ---- the riddle ----
function hear(msg) {
	if (msg == KOPILE || msg == PRIVET || msg == UMRI) {
		CYCLE = []
		KCYC = min(3, count(aliveMobs()))
		return null
	}
	var n = NUMOF[msg]
	if (n != null) {
		push(CYCLE, n)
	}
}

function sayNumber(n) {
	speak(NUMSTR[n])
	push(CYCLE, n)
}

function maybeStart() {
	var L = count(aliveLeeks())
	var M = count(aliveMobs())
	if (L == 0 || M == 0) {
		return null
	}
	var p = PSTART[min(L, 8) - 1][min(M, 8) - 1]
	if (rand() >= p) {
		return null
	}
	var table = KCYC >= 3 ? S3 : (KCYC == 2 ? S2 : S1)
	for (var t = 0; t < 60; t++) {
		var c = randInt(1, 613)
		if (isObstacle(c) || !isEmptyCell(c)) {
			continue
		}
		// real target cells avoid the edge: 15+ from the centre (306) 0.6-0.72x as often as random free cells
		if (getCellDistance(c, 306) >= 15 && rand() > 0.65) {
			continue
		}
		var firsts = table[c]
		if (firsts == null || count(firsts) == 0) {
			continue
		}
		sayNumber(firsts[randInt(0, count(firsts))])
		return null
	}
}

function riddleTurn() {
	var k = count(CYCLE)
	if (k >= KCYC && k > 0) {
		var dead = deadBrothers()
		if (count(dead) > 0) {
			var cell = riddleCell(CYCLE)
			if (getEntityOnCell(cell) != null && getEntityOnCell(cell) != -1) {
				speak(KOPILE)
				useChip(C_EXASPERATION, ME)
			} else {
				speak(PRIVET)
				resurrect(dead[randInt(0, count(dead))], cell)
			}
		} else {
			speak(UMRI)
		}
		CYCLE = []
		KCYC = min(3, count(aliveMobs()))
		maybeStart()
	} else if (k == 0) {
		maybeStart()
	} else {
		var n1 = CYCLE[0]
		if (KCYC == 3) {
			var r = R3[n1]
			if (r != null) {
				sayNumber(r[k - 1])
			}
		} else if (KCYC == 2) {
			var r2 = R2[n1]
			if (r2 != null) {
				sayNumber(r2[0])
			}
		}
	}
}

// ---- combat ----
function hasChip(c) {
	return inArray(getChips(), c)
}

function ready(c) {
	return hasChip(c) && getCooldown(c) == 0
}

// 2026-11-01 calibration: the real mobs hit the leeks whose shields let the most damage through (live, 14% of
// the pumpkin / hubbard hits on shielded leeks land on 75%+ relative shields, the shield-blind sim 27%) -
// with shield-aware targets the sim needs no STR fudge
function shieldFactor(e) {
	return max(0, 1 - min(100, getRelativeShield(e)) / 100)
}

function effLife(e) {
	return getLife(e) / max(0.05, shieldFactor(e)) + getAbsoluteShield(e)
}

function enemiesByDistance() {
	var me = getCell()
	var arr = []
	for (var e in getAliveEnemies()) {
		var c = getCell(e)
		if (c == null || c < 0) {
			continue
		}
		var d = getPathLength(me, c)
		if (d == null) {
			d = getCellDistance(me, c) + 6
		}
		// the mobs hit leeks rather than bulbs (80-94% of their targets) and lean toward hurt ones (the top
		// target of a round is the lowest-life leek 27% of the time)
		var hp = getLife(e) / max(1, getTotalLife(e))
		push(arr, [d + (isSummon(e) ? 4 : 0) + 4 * hp + 12 * (1 - shieldFactor(e)), e])
	}
	arr = arraySort(arr, function(x, y) {
		return x[0] - y[0]
	})
	var out = []
	for (var x in arr) {
		push(out, x[1])
	}
	return out
}

// attack chips in priority order (fitted on the real chip counts per turn)
function attackChips() {
	if (NAME == 'evil_pumpkin') {
		return [C_THUNDER, C_PLASMA, C_LIGHTNING, C_FLASH]
	}
	if (NAME == 'hubbard') {
		return [C_LIGHTNING, C_PLASMA, C_FLASH]
	}
	if (NAME == 'turban') {
		return [C_LIGHTNING, C_FLASH]
	}
	if (NAME == 'warty') {
		return [C_VENOM, C_TOXIN, C_PLAGUE]
	}
	return [C_FLASH]
}

// the glowing saber (newer generators, LW_GEN=/home/ubuntu/lwg-new): state 13 = amputated, the weapon is dropped
// until the end of the pumpkin's next turn - no scythe, so no walk / teleport to scythe (59 = EFFECT_ADD_STATE;
// read through the effects so the older generator, without the state, still compiles)
function amputated() {
	for (var eff in getEffects(ME)) {
		if (eff[0] == 59 && eff[1] == 13) {
			return true
		}
	}
	return false
}

function hasPoison(e) {
	for (var eff in getEffects(e)) {
		if (eff[0] == EFFECT_POISON) {
			return true
		}
	}
	return false
}

// jump (1-3 cells, no line of sight) onto the cell of `cells` nearest to `goal`
function jumpToward(goal) {
	if (!ready(C_JUMP) || getTP() < getChipCost(C_JUMP)) {
		return false
	}
	var me = getCell()
	var best = null
	var bd = getCellDistance(me, goal)
	for (var c = 0; c < 613; c++) {
		var d = getCellDistance(me, c)
		if (d < 1 || d > 3 || isObstacle(c) || !isEmptyCell(c)) {
			continue
		}
		var g = getCellDistance(c, goal)
		if (g < bd) {
			bd = g
			best = c
		}
	}
	if (best != null && canUseChipOnCell(C_JUMP, best)) {
		return useChipOnCell(C_JUMP, best) > 0
	}
	return false
}

// ---- AoE-aware aiming (real: the pumpkin opens on empty cells to splash two leeks, hubbard hits the
// lowest-life leek it can reach 83-88% of the time on T1). Area damage = 1 - 0.2 x distance to the aimed cell.
function foeWeights() {
	var out = []
	for (var e in getAliveEnemies()) {
		var c = getCell(e)
		if (c == null || c < 0) {
			continue
		}
		push(out, [e, c, (isSummon(e) ? 0.25 : 1.0) * shieldFactor(e) * shieldFactor(e) + 0.02])
	}
	return out
}

function areaRadius(chip) {
	if (chip == C_FLASH) {
		return 1
	}
	if (chip == C_PLAGUE) {
		return 3
	}
	if (chip == C_VENOM) {
		return 0
	}
	return 2   // lightning, thunder, toxin (circle 2), plasma (plus 2)
}

function areaDist(chip, aim, c) {
	var d = getCellDistance(aim, c)
	if (d > areaRadius(chip)) {
		return -1
	}
	if (chip == C_PLASMA && d > 0 && !isOnSameLine(aim, c)) {
		return -1
	}
	return d
}

function aimScore(chip, aim, F, primary) {
	var s = 0
	for (var f in F) {
		var d = areaDist(chip, aim, f[1])
		if (d >= 0) {
			s += f[2] * (f[0] == primary ? 3 : 1) * (1 - 0.2 * d)
		}
	}
	return s
}

function cellsAround(c, lo, hi) {
	var out = []
	var x = getCellX(c)
	var y = getCellY(c)
	for (var dx = -hi; dx <= hi; dx++) {
		for (var dy = abs(dx) - hi; dy <= hi - abs(dx); dy++) {
			if (abs(dx) + abs(dy) < lo) {
				continue
			}
			var n = getCellFromXY(x + dx, y + dy)
			if (n != null && n >= 0) {
				push(out, n)
			}
		}
	}
	return out
}

// where I can stand this turn: cell -> [cost, jump?, walk cell] (walk within MP; with jump ready, any free cell
// 1-3 from a walk cell - the jump crosses obstacles, which is how the real pumpkin reaches 408 on T1)
function reachMap(chipCost) {
	var me = getCell()
	var mp = getMP()
	var R = [:]
	R[me] = [0, 0, me]
	for (var c in cellsAround(me, 1, mp)) {
		if (isObstacle(c) || !isEmptyCell(c)) {
			continue
		}
		var d = getPathLength(me, c)
		if (d != null && d <= mp) {
			R[c] = [d, 0, c]
		}
	}
	if (ready(C_JUMP) && getTP() >= getChipCost(C_JUMP) + chipCost) {
		for (var w in mapKeys(R)) {
			if (R[w][1] != 0) {
				continue
			}
			for (var c in cellsAround(w, 1, 3)) {
				if (R[c] != null || isObstacle(c) || !isEmptyCell(c)) {
					continue
				}
				R[c] = [R[w][0] + 0.5, 1, w]
			}
		}
	}
	return R
}

// [aim cell, cell to shoot from, [cost, jump?, walk cell]] for the best splash on target `e` I can reach
function bestShotOn(chip, e, F, R) {
	var me = getCell()
	var tc = getCell(e)
	var lo = getChipMinRange(chip)
	var hi = getChipMaxRange(chip)
	var los = chipNeedLos(chip)
	var inl = isInlineChip(chip)
	var r = areaRadius(chip)
	var cands = []
	for (var a in cellsAround(tc, 0, r)) {
		if (isObstacle(a) || areaDist(chip, a, tc) < 0) {
			continue
		}
		push(cands, [aimScore(chip, a, F, e), a])
	}
	cands = arraySort(cands, function(x, y) {
		return y[0] - x[0]
	})
	for (var k = 0; k < min(5, count(cands)); k++) {
		var aim = cands[k][1]
		var best = null
		var bc = 999
		for (var c in mapKeys(R)) {
			var d = getCellDistance(c, aim)
			if (d < lo || d > hi || R[c][0] >= bc || (inl && !isOnSameLine(c, aim))) {
				continue
			}
			if (los && !lineOfSight(c, aim, ME)) {
				continue
			}
			best = c
			bc = R[c][0]
		}
		if (best != null) {
			return [aim, best, R[best]]
		}
	}
	return null
}

// target order (real T1s, identical in all 20 v17 fights): the pumpkin and hubbard go for the lowest-life leek
// they can reach (GTGabi 2481, Kirby 2924), turban, warty and offspring for the nearest
function targetOrder() {
	var near = enemiesByDistance()
	if (NAME == 'warty') {
		// warty poisons clusters (real T1: Kirby + ProdigalSon together, not the nearer lone DuskHope)
		var cl = []
		for (var e in near) {
			var n = 0
			for (var o in near) {
				if (o != e && !isSummon(o) && getCellDistance(getCell(e), getCell(o)) <= 3) {
					n++
				}
			}
			var hurt = 1 - getLife(e) / max(1, getTotalLife(e))
			push(cl, [-(n + hurt + (isSummon(e) ? -2 : 0)), getCellDistance(getCell(), getCell(e)), e])
		}
		cl = arraySort(cl, function(x, y) {
			return x[0] != y[0] ? x[0] - y[0] : x[1] - y[1]
		})
		var out = []
		for (var x in cl) {
			push(out, x[2])
		}
		return out
	}
	if (NAME != 'evil_pumpkin' && NAME != 'hubbard') {
		return near
	}
	var me = getCell()
	var reach = getMP() + 8 + (ready(C_JUMP) ? 3 : 0)
	var weak = []
	for (var e in near) {
		// grid distance: the jump (1-3, no line of sight) crosses obstacles a walking path goes around
		if (!isSummon(e) && getCellDistance(me, getCell(e)) <= reach) {
			push(weak, [effLife(e), e])
		}
	}
	weak = arraySort(weak, function(x, y) {
		return x[0] - y[0]
	})
	var out = []
	for (var x in weak) {
		push(out, x[1])
	}
	for (var e in near) {
		if (!inArray(out, e)) {
			push(out, e)
		}
	}
	return out
}

// one attack: the first target (mob's order) and chip (priority order) with a shot in reach
function attackOnce(foes, chips) {
	var F = foeWeights()
	for (var e in targetOrder()) {
		for (var chip in chips) {
			if (getCooldown(chip) > 0 || (chip == C_PLAGUE && !PLAGUE_OK)) {
				continue
			}
			if (getTP() < getChipCost(chip)) {
				// adrenaline (+5 TP this turn) when it buys one more shot (real: ~0.05 casts a turn)
				if (ADRENALINE_OK && ready(C_ADRENALINE) && getTP() + 5 - 1 >= getChipCost(chip) && getTP() >= 1) {
					useChip(C_ADRENALINE, ME)
				}
				if (getTP() < getChipCost(chip)) {
					continue
				}
			}
			var shot = bestShotOn(chip, e, F, reachMap(getChipCost(chip)))
			if (shot == null) {
				continue
			}
			if (shot[1] != getCell()) {
				if (shot[2][1] == 0) {
					moveTowardCell(shot[1])
				} else {
					if (shot[2][2] != getCell()) {
						moveTowardCell(shot[2][2])
					}
					if (canUseChipOnCell(C_JUMP, shot[1])) {
						useChipOnCell(C_JUMP, shot[1])
					}
				}
			}
			if (canUseChipOnCell(chip, shot[0]) && useChipOnCell(chip, shot[0]) > 0) {
				return true
			}
		}
	}
	return false
}

// leeks sorted by current life (the pumpkin's teleport + scythe goes for the weakest it can reach)
function weakestFirst(foes) {
	var arr = []
	for (var e in foes) {
		push(arr, [getLife(e) + (isSummon(e) ? 100000 : 0), e])
	}
	arr = arraySort(arr, function(x, y) {
		return x[0] - y[0]
	})
	var out = []
	for (var x in arr) {
		push(out, x[1])
	}
	return out
}

function scythe(e) {
	if (getWeapon() != W_SCYTHE) {
		setWeapon(W_SCYTHE)
	}
	return canUseWeapon(W_SCYTHE, e) && useWeapon(e) > 0
}

// the pumpkin's scythe (300-350 x STR 1000): teleport next to the nearest enemy within 13 whenever teleport is
// ready (real: on every cooldown), otherwise only with the TP the chips left, walking to an adjacent cell
function pumpkinTeleport(foes) {
	if (!ready(C_TELEPORT) || getTP() < 9 + 16) {
		return false
	}
	for (var e in weakestFirst(foes)) {
		var ce = getCell(e)
		if (getCellDistance(getCell(), ce) > 13) {
			continue
		}
		for (var n in [ce + 17, ce - 17, ce + 18, ce - 18]) {
			if (n < 0 || n > 612 || isObstacle(n) || !isEmptyCell(n) || getCellDistance(n, ce) != 1) {
				continue
			}
			if (canUseChipOnCell(C_TELEPORT, n)) {
				useChipOnCell(C_TELEPORT, n)
				scythe(e)
				return true
			}
		}
	}
	return false
}

function pumpkinScythe(foes) {
	if (getTP() < 15 + (getWeapon() != W_SCYTHE ? 1 : 0)) {
		return false
	}
	for (var e in foes) {
		if (canUseWeapon(W_SCYTHE, e)) {
			return scythe(e)
		}
		var cell = getCellToUseWeapon(W_SCYTHE, e)
		if (cell == null || cell < 0) {
			continue
		}
		var d = getPathLength(getCell(), cell)
		if (d != null && d <= getMP()) {
			moveTowardCell(cell)
			return scythe(e)
		}
	}
	return false
}

function holdBand(target) {
	var me = getCell()
	var mp = getMP()
	var best = me
	var bs = abs(getCellDistance(me, target) - 4) * 10
	for (var c = 0; c < 613; c++) {
		var dm = getCellDistance(me, c)
		if (dm < 1 || dm > mp || isObstacle(c) || !isEmptyCell(c)) {
			continue
		}
		var sc = abs(getCellDistance(c, target) - 4) * 10 + dm
		if (sc < bs) {
			var pl = getPathLength(me, c)
			if (pl != null && pl <= mp) {
				bs = sc
				best = c
			}
		}
	}
	if (best != me) {
		moveTowardCell(best)
	}
}

function jumpAway(from) {
	if (!ready(C_JUMP) || getTP() < getChipCost(C_JUMP)) {
		return false
	}
	var me = getCell()
	var best = null
	var bd = getCellDistance(me, from)
	for (var c = 0; c < 613; c++) {
		var d = getCellDistance(me, c)
		if (d < 1 || d > 3 || isObstacle(c) || !isEmptyCell(c)) {
			continue
		}
		var g = getCellDistance(c, from)
		if (g > bd) {
			bd = g
			best = c
		}
	}
	if (best != null && canUseChipOnCell(C_JUMP, best)) {
		return useChipOnCell(C_JUMP, best) > 0
	}
	return false
}

function combat() {
	var foes = enemiesByDistance()
	if (count(foes) == 0) {
		return null
	}
	var near = getPathLength(getCell(), getCell(foes[0]))
	if (near == null) {
		near = 30
	}
	var chips = attackChips()
	// self buffs whenever they are ready (real: steroid ~0.2 casts a turn = every cooldown, engaged or not)
	if (hasPoison(ME) && ready(C_ANTIDOTE)) {
		useChip(C_ANTIDOTE, ME)
	}
	// steroid: up front only when nothing is in reach (real: never on the pumpkin's T1 opening), else with
	// the TP the attacks leave
	var steroidLater = ready(C_STEROID) && rand() < 0.5
	if (steroidLater && near > getMP() + 9) {
		useChip(C_STEROID, ME)
		steroidLater = false
	}
	// hubbard swaps with the nearest enemy it can whenever inversion is ready (149/192 real inversions on the nearest)
	if (NAME == 'hubbard' && ready(C_INVERSION)) {
		for (var e in foes) {
			if (canUseChip(C_INVERSION, e)) {
				useChip(C_INVERSION, e)
				break
			}
		}
		foes = enemiesByDistance()
	}
	if (NAME == 'evil_pumpkin' && !amputated()) {
		if (!pumpkinScythe(foes)) {
			pumpkinTeleport(foes)
		}
		foes = enemiesByDistance()
	}
	var hits = 0
	for (var k = 0; k < 8; k++) {
		foes = enemiesByDistance()
		if (count(foes) == 0) {
			break
		}
		if (!attackOnce(foes, chips)) {
			break
		}
		hits++
	}
	// liberation on a shielded enemy in range, with the TP the attacks left (recalibrated 2026-10-28 on the
	// 60-fight squad-play batch: before the attacks it ate the pumpkin's lightning / thunder - sim R2-8 pumpkin
	// 1.69k a turn vs 2.45k live)
	if (ready(C_LIBERATION)) {
		for (var e in enemiesByDistance()) {
			if ((getAbsoluteShield(e) > 0 || getRelativeShield(e) > 0) && canUseChip(C_LIBERATION, e)) {
				useChip(C_LIBERATION, e)
				break
			}
		}
	}
	if (steroidLater && ready(C_STEROID) && getTP() >= getChipCost(C_STEROID)) {
		useChip(C_STEROID, ME)
	}
	foes = enemiesByDistance()
	if (count(foes) == 0) {
		return null
	}
	// after attacking, the rest of the MP goes to holding 3-5 cells from the nearest enemy (real: adjacent mobs
	// back off 1.5 cells, mobs 6-11 away close 2-3; turban / hubbard / warty use 5.4 / 4.5 / 3.2 MP a turn)
	if (hits > 0 && getMP() > 0 && NAME != 'offspring') {
		holdBand(getCell(foes[0]))
	}
	if (hits == 0 && getMP() > 0) {
		// nothing in reach: close in (engaged range), else drift a little
		moveToward(foes[0], near <= 15 ? getMP() : min(getMP(), 1 + randInt(0, 2)))
	}
	// jump whenever it is ready (real: pumpkin, turban and offspring jump on ~every cooldown): toward the
	// nearest enemy, the offspring away from it after a hit
	if (ready(C_JUMP) && getTP() >= getChipCost(C_JUMP)) {
		if (NAME == 'offspring' && hits > 0) {
			jumpAway(getCell(foes[0]))
		} else {
			jumpToward(getCell(foes[0]))
		}
	}
	if (NAME == 'offspring' && getMP() > 0) {
		moveAwayFrom(foes[0], getMP())
	}
}

// ---- the turn ----
SAID = 0
PLAGUE_OK = rand() < 0.45
ADRENALINE_OK = rand() < 0.3
// back from the dead (or first turn): what was said meanwhile was not heard - start from a clean cycle
if (LAST_TURN >= 0 && getTurn() - LAST_TURN > 1) {
	{
}
	CYCLE = []
	KCYC = min(3, count(aliveMobs()))
}
LAST_TURN = getTurn()
for (var h in listen()) {
	hear(h[1])
}
if (getTurn() == 1 && NAME == 'evil_pumpkin') {
	useChipOnCell(C_DP, getCell())
}
riddleTurn()
combat()
