+package com.leekwars.generator.mob;
+
+import com.leekwars.generator.leek.Leek;
+import com.leekwars.generator.state.Entity;
+
+/**
+ * Mob de boss pour les scénarios locaux (Potiron et ses frères) : un poireau dont le type est
+ * TYPE_MOB, pour que getType()/getMobType() et les messages se comportent comme en ligne.
+ */
+public class Mob extends Leek {
+
+	public Mob() {}
+
+	@Override
+	public int getType() {
+		return Entity.TYPE_MOB;
+	}
+}
