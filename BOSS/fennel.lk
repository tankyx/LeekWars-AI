// Fennel King boss AI — kill+resurrect doctrine copied from the 4-leek squads
// that clear the boss (farmer 33552, graal down on turn 4-5, data/boss_fights).
//
// PUZZLE (graal alive, army under Divine Protection):
//   T1     self-stack: rage, seven league boots, fortress, wall, armor,
//          solidification, knowledge (teleport is on its initial cooldown).
//   T2+    every leek that still holds resurrection solves ONE crystal in one
//          turn: [adrenaline] -> spark the crystal (range 10, no LoS) ->
//          teleport (or walk) next to a cell on the crystal's graal axis ->
//          resurrect the crystal on that cell. Any crystal found dead at the
//          start of a turn is revived first (the graal casts Apocalypse on a
//          dead crystal at its turn).
//   Never damages the army (invulnerable) and never touches solved crystals.
// COMBAT (graal dead): shields/heals, then focus the weakest reachable army
//   unit (scribe first on ties) with weapons and damage chips; crystals last.

global AXIS = ['red_crystal': 'south', 'blue_crystal': 'east', 'yellow_crystal': 'west', 'green_crystal': 'north']
global _graal = -1
global _gx = 0
global _gy = 0
global _graalCell = -1
global _crystals = [:]       // crystal id -> axis (dead crystals leave getAliveEnemies)
global _combat = false
global _usedRegen = false
global _log = []

function me() { return getEntity() }
function has(chip) { return inArray(getChips(), chip) }
function ready(chip) { return has(chip) && getCooldown(chip) == 0 }
function ok(r) { return r == USE_SUCCESS || r == USE_CRITICAL }
function note(s) { push(_log, s) }

function isCrystal(e) { return AXIS[getName(e)] != null }
function isArmy(e) {
    var n = getName(e)
    if (n == 'graal' || AXIS[n] != null) { return false }
    if (indexOf(n, 'chest') != -1) { return false }
    return true
}
function army() {
    var out = []
    for (var e in getAliveEnemies()) { if (isArmy(e)) { push(out, e) } }
    return out
}
function aliveIds() {
    var ids = []
    for (var e in getAliveEnemies()) { push(ids, e) }
    for (var a in getAliveAllies()) { push(ids, a) }
    return ids
}

function scan() {
    for (var e in getEnemies()) {
        var n = getName(e)
        if (n == 'graal') { _graal = e }
        if (AXIS[n] != null) { _crystals[e] = AXIS[n] }
    }
    _graalCell = -1
    if (_graal != -1 && isAlive(_graal)) {
        var c = getCell(_graal)
        if (c != null && c >= 0 && getLife(_graal) > 0) {
            _graalCell = c; _gx = getCellX(c); _gy = getCellY(c)
        }
    }
    if (_graalCell == -1) { _combat = true }   // graal dead (or a fight without one)
    if (!_combat && getTurn() > 1 && !armyProtected()) { _combat = true }
}

function armyProtected() {
    var seen = false
    for (var e in army()) {
        seen = true
        var effs = getEffects(e)
        if (effs != null) {
            for (var f in effs) { if (f[0] == 59) { return true } }
        }
    }
    return !seen
}

function onAxis(cell, axis) {
    var x = getCellX(cell); var y = getCellY(cell)
    if (axis == 'north') { return x == _gx && y < _gy }
    if (axis == 'south') { return x == _gx && y > _gy }
    if (axis == 'east') { return y == _gy && x > _gx }
    if (axis == 'west') { return y == _gy && x < _gx }
    return false
}

function solved(c) {
    if (!isAlive(c)) { return false }
    var cell = getCell(c)
    if (cell == null || cell < 0) { return false }
    return onAxis(cell, _crystals[c]) && lineOfSight(cell, _graalCell, aliveIds())
}

// Empty cells on the axis, nearest the graal first; the ray stops at the first obstacle.
function goalCells(axis) {
    var out = []
    for (var d = 1; d <= 20; d++) {
        var x = _gx; var y = _gy
        if (axis == 'north') { y = _gy - d }
        if (axis == 'south') { y = _gy + d }
        if (axis == 'east') { x = _gx + d }
        if (axis == 'west') { x = _gx - d }
        var c = getCellFromXY(x, y)
        if (c == null) { break }
        if (isObstacle(c)) { break }
        if (isEmptyCell(c)) { push(out, c) }
    }
    return out
}

// Army pressure on a cell: units within their walk + weapon reach (~11), closer counts more.
function threatAt(cell) {
    var n = 0
    for (var e in army()) {
        var d = getCellDistance(cell, getCell(e))
        if (d <= 11) { n += (12 - d) / 6 }
    }
    return n
}

// Cells t (1-2 from g, resurrection range) I can stand on to revive onto g.
function standCells(g) {
    var out = []
    var gx = getCellX(g); var gy = getCellY(g)
    for (var dx = -2; dx <= 2; dx++) {
        for (var dy = -2; dy <= 2; dy++) {
            var t = getCellFromXY(gx + dx, gy + dy)
            if (t == null || t == g || isObstacle(t)) { continue }
            var d = getCellDistance(t, g)
            if (d < 1 || d > 2) { continue }
            if (t != getCell() && !isEmptyCell(t)) { continue }
            if (!lineOfSight(t, g, me())) { continue }
            push(out, t)
        }
    }
    return out
}

// First cell on my path from which spark reaches crystal cell cc (current cell if already in range).
function sparkCells(cc, rc) {
    var r = getChipMaxRange(CHIP_SPARK)
    var out = []
    for (var c : var st in rc) { if (getCellDistance(c, cc) <= r) { push(out, c) } }
    return out
}

// Cells I can walk to this turn: [cell: steps], BFS over empty cells.
function reachable() {
    var start = getCell(); var mp = getMP()
    var dist = [:]; dist[start] = 0
    var frontier = [start]
    for (var step = 1; step <= mp; step++) {
        var next = []
        for (var c in frontier) {
            var x = getCellX(c); var y = getCellY(c)
            for (var d in [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
                var n = getCellFromXY(x + d[0], y + d[1])
                if (n == null || dist[n] != null || isObstacle(n) || !isEmptyCell(n)) { continue }
                dist[n] = step; push(next, n)
            }
        }
        frontier = next
    }
    return dist
}

function freeNeighbours(cc) {
    var out = []
    var x = getCellX(cc); var y = getCellY(cc)
    for (var d in [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
        var n = getCellFromXY(x + d[0], y + d[1])
        if (n != null && !isObstacle(n) && (isEmptyCell(n) || n == getCell())) { push(out, n) }
    }
    return out
}

// Best way to put crystal c back on its axis this turn: [stand, goal, teleport?] or null.
global _why = [:]
function revivePlan(c, tpBudget, fromCell, usedSteps) {
    _why = ['stand': 0, 'nopath': 0, 'teleCd': 0, 'teleRange': 0, 'tp': 0]
    var best = null; var bestScore = 999999999
    for (var g in goalCells(_crystals[c])) {
        var stands = standCells(g)
        _why['stand'] += count(stands)
        for (var t in stands) {
            var walk = (t == fromCell) ? 0 : getPathLength(fromCell, t)
            var used = usedSteps
            var tele = false
            if (walk == null || walk + used > getMP()) {
                if (!ready(CHIP_TELEPORTATION)) { _why['teleCd']++; continue }
                var td = getCellDistance(fromCell, t)
                if (td < 1 || td > 12 || t == fromCell) { _why['teleRange']++; continue }
                tele = true
            }
            var cost = getChipCost(CHIP_RESURRECTION) + (tele ? getChipCost(CHIP_TELEPORTATION) : 0)
            if (cost > tpBudget) { _why['tp']++; continue }
            var score = threatAt(t) * 10 + (tele ? 5 : 0) + getCellDistance(g, _graalCell) * 0.1
            if (score < bestScore) { bestScore = score; best = [t, g, tele] }
        }
    }
    return best
}

function execRevive(c, plan) {
    var t = plan[0]; var g = plan[1]; var tele = plan[2]
    if (tele) {
        if (!ok(useChipOnCell(CHIP_TELEPORTATION, t))) { note('tele fail ' + t); }
    } else if (t != getCell()) {
        moveTowardCell(t)
    }
    var r = resurrect(c, g)
    if (ok(r) && isAlive(c)) { note('revived ' + getName(c) + '@' + g); return true }
    // fallback: any goal cell I can reach from where I ended
    for (var g2 in goalCells(_crystals[c])) {
        if (getCellDistance(getCell(), g2) <= 2 && lineOfSight(getCell(), g2, me())) {
            if (ok(resurrect(c, g2)) && isAlive(c)) { note('revived2 ' + getName(c) + '@' + g2); return true }
        }
    }
    note('revive FAILED ' + getName(c))
    return false
}

// Revive crystals that died before our turn (Apocalypse guard).
function saveDeadCrystals() {
    if (!ready(CHIP_RESURRECTION)) { return }
    for (var c : var axis in _crystals) {
        if (isAlive(c)) { continue }
        var tp = getTP() + (ready(CHIP_ADRENALINE) ? 4 : 0)
        var plan = revivePlan(c, tp, getCell(), 0)
        if (plan == null) { continue }
        if (getTP() < getChipCost(CHIP_RESURRECTION) + (plan[2] ? getChipCost(CHIP_TELEPORTATION) : 0)) {
            useChip(CHIP_ADRENALINE, me())
        }
        execRevive(c, plan)
        return
    }
}

function trySolveOne() {
    if (!ready(CHIP_RESURRECTION) || !has(CHIP_SPARK)) { return false }
    var tpAvail = getTP() + (ready(CHIP_ADRENALINE) ? 4 : 0)
    var budget = tpAvail - getChipCost(CHIP_SPARK)
    var rc = reachable()
    var best = null; var bestScore = 999999999
    for (var c : var axis in _crystals) {
        if (!isAlive(c) || solved(c)) { continue }
        var cc = getCell(c)
        if (getLife(c) > 8 || getAbsoluteShield(c) > 0) { note(getName(c) + ' tough ' + getLife(c)); continue }
        var froms = sparkCells(cc, rc)
        if (count(froms) == 0) { continue }
        // try the from-cells closest to the crystal's axis first (teleport reach), at most 10
        var goals = goalCells(axis)
        if (count(goals) == 0) { continue }
        var g0 = goals[0]
        var keyed = []
        for (var f in froms) { push(keyed, [getCellDistance(f, g0) * 10 + rc[f], f]) }
        keyed = arraySort(keyed, function(a, b) { return a[0] - b[0] })
        var tries = 0
        for (var kf in keyed) {
            if (tries++ >= 10) { break }
            var from = kf[1]
            var plan = revivePlan(c, budget, from, rc[from])
            if (plan == null) { continue }
            var score = threatAt(plan[0]) * 10 + (plan[2] ? 5 : 0) + rc[from] * 0.2
            if (score < bestScore) { bestScore = score; best = [c, plan, from] }
            break
        }
    }
    if (best == null) { return teleFirst(tpAvail) }
    var c = best[0]; var plan = best[1]; var from = best[2]
    var need = getChipCost(CHIP_SPARK) + getChipCost(CHIP_RESURRECTION) + (plan[2] ? getChipCost(CHIP_TELEPORTATION) : 0)
    if (getTP() < need && ready(CHIP_ADRENALINE)) { useChip(CHIP_ADRENALINE, me()) }
    if (getTP() < need) { return false }
    if (from != getCell()) { moveTowardCell(from) }
    if (getCellDistance(getCell(), getCell(c)) > getChipMaxRange(CHIP_SPARK)) { note('could not reach spark range'); return false }
    if (!plan[2] && plan[0] != getCell()) {
        var pl = getPathLength(getCell(), plan[0])
        if (pl == null || pl > getMP()) { note('walk plan broke'); return false }
    }
    var r = useChip(CHIP_SPARK, c)
    if (isAlive(c)) { note('spark did not kill ' + getName(c) + ' r=' + r); return false }
    note('KR ' + getName(c) + ' from ' + from + (plan[2] ? ' tele ' : ' walk ') + plan[0] + ' -> ' + plan[1])
    execRevive(c, plan)
    return true
}

// Teleport to F, spark the crystal from F, walk F -> t, resurrect onto g (farmer 68355's
// turn-2 sequence). F = t when no walk is needed. Reaches crystals no path leads to.
function teleWalkOptions(c, mp) {
    var out = []
    var cc = getCell(c)
    var sr = getChipMaxRange(CHIP_SPARK); var tr = getChipMaxRange(CHIP_TELEPORTATION)
    for (var g in goalCells(_crystals[c])) {
        for (var t in standCells(g)) {
            var tx = getCellX(t); var ty = getCellY(t)
            var bestF = null; var bd = 999
            for (var dx = -mp; dx <= mp; dx++) {
                for (var dy = -mp + abs(dx); dy <= mp - abs(dx); dy++) {
                    var f = getCellFromXY(tx + dx, ty + dy)
                    if (f == null || f == getCell() || isObstacle(f) || !isEmptyCell(f)) { continue }
                    var dm = getCellDistance(getCell(), f)
                    if (dm < 1 || dm > tr || getCellDistance(f, cc) > sr) { continue }
                    var dt = getCellDistance(f, t)
                    if (dt < bd) { bd = dt; bestF = f }
                }
            }
            if (bestF != null) { push(out, [bestF, t, g, bd]) }
        }
    }
    return out
}

function teleFirst(tpAvail) {
    if (!ready(CHIP_TELEPORTATION)) { return false }
    var need = getChipCost(CHIP_TELEPORTATION) + getChipCost(CHIP_SPARK) + getChipCost(CHIP_RESURRECTION)
    if (tpAvail < need) { return false }
    var cands = []
    for (var c : var axis in _crystals) {
        if (!isAlive(c) || solved(c) || getLife(c) > 8 || getAbsoluteShield(c) > 0) { continue }
        for (var o in teleWalkOptions(c, getMP())) {
            push(cands, [threatAt(o[1]) * 10 + o[3] * 0.5 + getCellDistance(o[2], _graalCell) * 0.1, c, o])
        }
    }
    cands = arraySort(cands, function(a, b) { return a[0] - b[0] })
    var tries = 0
    for (var k in cands) {
        if (tries++ >= 6) { break }
        var c = k[1]; var f = k[2][0]; var t = k[2][1]; var g = k[2][2]
        if (f != t) {
            var pl = getPathLength(f, t)
            if (pl == null || pl > getMP()) { continue }
        }
        if (getTP() < need && ready(CHIP_ADRENALINE)) { useChip(CHIP_ADRENALINE, me()) }
        if (getTP() < need) { return false }
        if (!ok(useChipOnCell(CHIP_TELEPORTATION, f)) || getCell() != f) { note('tele failed ' + f); return false }
        var r = useChip(CHIP_SPARK, c)
        if (isAlive(c)) { note('tele-walk spark did not kill ' + getName(c) + ' r=' + r); return false }
        note('KR-TW ' + getName(c) + ' tele ' + f + ' walk ' + t + ' -> ' + g)
        execRevive(c, [t, g, false])
        return true
    }
    return false
}

// Nearest (by straight distance) revive cell for crystal c, for staging.
function nearestStand(c) {
    var best = null; var bd = 999
    for (var g in goalCells(_crystals[c])) {
        for (var t in standCells(g)) {
            var d = getCellDistance(getCell(), t)
            if (d < bd) { bd = d; best = t }
        }
    }
    return best
}

function castSelf(chip) {
    if (ready(chip) && getTP() >= getChipCost(chip)) { return ok(useChip(chip, me())) }
    return false
}

function selfStack() {
    castSelf(CHIP_RAGE)
    castSelf(CHIP_SEVEN_LEAGUE_BOOTS)
    castSelf(CHIP_FORTRESS)
    castSelf(CHIP_WALL)
    castSelf(CHIP_ARMOR)
    castSelf(CHIP_SOLIDIFICATION)
    castSelf(CHIP_KNOWLEDGE)
}

function sustain() {
    var life = getLife(); var total = getTotalLife()
    if (life < total * 0.5 && !_usedRegen && castSelf(CHIP_REGENERATION)) { _usedRegen = true }
    if (life < total * 0.6) { castSelf(CHIP_ELEVATION) }
    if (total - getLife() > 250) { castSelf(CHIP_REMISSION) }
    var near = 0
    for (var e in army()) { if (getCellDistance(getCell(), getCell(e)) <= 10) { near++ } }
    if (near > 0) {
        castSelf(CHIP_FORTRESS); castSelf(CHIP_WALL); castSelf(CHIP_ARMOR); castSelf(CHIP_SOLIDIFICATION)
        if (has(CHIP_RAMPART) && getCooldown(CHIP_RAMPART) == 0 && getTP() >= getChipCost(CHIP_RAMPART)) {
            // rampart min range 2: give it to the most hurt ally in range
            var tgt = null; var worst = 1.0
            for (var a in getAliveAllies()) {
                if (a == me() || isSummon(a)) { continue }
                var f = getLife(a) / getTotalLife(a)
                if (f < worst && canUseChip(CHIP_RAMPART, a)) { worst = f; tgt = a }
            }
            if (tgt != null) { useChip(CHIP_RAMPART, tgt) }
        }
    }
    if (total - getLife() > 400) { castSelf(CHIP_SERUM) }
}

// ---------------- COMBAT ----------------
function areaHitsAlly(cells) {
    if (cells == null) { return false }
    for (var c in cells) {
        var e = getEntityOnCell(c)
        if (e != null && e != -1 && isAlly(e)) { return true }
    }
    return false
}

function offensive(effects) {
    for (var f in effects) {
        if (f[0] == EFFECT_DAMAGE || f[0] == EFFECT_POISON || f[0] == EFFECT_NOVA_DAMAGE) { return true }
    }
    return false
}

// Shortest walk to a cell from which some weapon hits the target, or null.
function weaponReach(target) {
    var best = null
    for (var w in getWeapons()) {
        var cells = getCellsToUseWeapon(w, target)
        if (cells == null) { continue }
        for (var c in cells) {
            if (c != getCell() && getCellDistance(getCell(), c) > getMP()) { continue }
            var d = (c == getCell()) ? 0 : getPathLength(getCell(), c)
            if (d == null || d > getMP()) { continue }
            if (best == null || d < best[1]) { best = [c, d, w] }
        }
    }
    return best
}

// Squad focus (same for every leek): squires -> knights -> scribe -> king, lowest HP+shield first
// within a class (the kill order of the squads that win). Crystals once the army is dead.
function classOf(e) {
    var n = getName(e)
    if (n == 'fennel_squire') { return 0 }
    if (n == 'fennel_knight') { return 1 }
    if (n == 'fennel_scribe') { return 2 }
    if (n == 'fennel_king') { return 3 }
    return 4
}

function focusOrder() {
    var cands = army()
    if (count(cands) == 0) {
        for (var e in getAliveEnemies()) { if (isCrystal(e)) { push(cands, e) } }
    }
    var keyed = []
    for (var e in cands) { push(keyed, [classOf(e) * 100000 + getLife(e) + getAbsoluteShield(e), e]) }
    keyed = arraySort(keyed, function(a, b) { return a[0] - b[0] })
    var out = []
    for (var k in keyed) { push(out, k[1]) }
    return out
}

function pickTarget() {
    var order = focusOrder()
    if (count(order) == 0) { return null }
    // the squad focus if I can hit it this turn, else the first one in focus order I can hit
    var n = 0
    for (var e in order) {
        if (n++ >= 3) { break }
        if (getCellDistance(getCell(), getCell(e)) > getMP() + 12) { continue }
        if (weaponReach(e) != null) { return e }
    }
    return order[0]
}

function attack(target) {
    castSelf(CHIP_STEROID); castSelf(CHIP_PROTEIN)
    if ((getAbsoluteShield(target) > 100 || getRelativeShield(target) > 15) && ready(CHIP_LIBERATION) && canUseChip(CHIP_LIBERATION, target)) {
        useChip(CHIP_LIBERATION, target)
    }
    var r = weaponReach(target)
    if (r == null) {
        moveToward(target)
        // liberation may be in range after the move
        if ((getAbsoluteShield(target) > 100 || getRelativeShield(target) > 15) && ready(CHIP_LIBERATION) && canUseChip(CHIP_LIBERATION, target)) {
            useChip(CHIP_LIBERATION, target)
        }
    } else {
        if (r[0] != getCell()) { moveTowardCell(r[0]) }
        var w = r[2]
        if (getWeapon() != w) { setWeapon(w) }
        for (var i = 0; i < 8; i++) {
            if (!canUseWeapon(w, target)) { break }
            if (areaHitsAlly(getWeaponEffectiveArea(w, getCell(target)))) { break }
            if (!ok(useWeapon(target)) || !isAlive(target)) { break }
        }
    }
    // other weapons that still reach without moving
    for (var w2 in getWeapons()) {
        if (!isAlive(target)) { break }
        if (getWeaponCost(w2) + (getWeapon() == w2 ? 0 : 1) > getTP()) { continue }
        if (!canUseWeapon(w2, target)) { continue }
        if (areaHitsAlly(getWeaponEffectiveArea(w2, getCell(target)))) { continue }
        if (getWeapon() != w2) { setWeapon(w2) }
        for (var j = 0; j < 8; j++) {
            if (!canUseWeapon(w2, target) || !ok(useWeapon(target)) || !isAlive(target)) { break }
        }
    }
    for (var ch in getChips()) {
        if (!isAlive(target)) { break }
        if (ch == CHIP_SPARK) { continue }
        if (!offensive(getChipEffects(ch))) { continue }
        if (!canUseChip(ch, target)) { continue }
        if (areaHitsAlly(getChipEffectiveArea(ch, getCell(target)))) { continue }
        useChip(ch, target)
    }
}

function combatTurn() {
    sustain()
    var t = pickTarget()
    if (t != null) { attack(t) }
    sustain()
}

// Crystal assignment shared by every leek: greedy on the globally closest
// (leek, crystal) pairs among leeks whose resurrection is ready; a leek already
// within spark range of a crystal keeps it (distance counted as 0).
function myCrystal() {
    var leeks = []
    for (var a in getAliveAllies()) {
        if (isSummon(a)) { continue }
        var cs = getChips(a)
        if (cs == null || !inArray(cs, CHIP_RESURRECTION)) { continue }
        if (getCooldown(CHIP_RESURRECTION, a) > 0) { continue }
        push(leeks, a)
    }
    var pairs = []
    for (var l in leeks) {
        for (var c : var axis in _crystals) {
            if (!isAlive(c) || solved(c)) { continue }
            var d = getCellDistance(getCell(l), getCell(c))
            push(pairs, [d <= 10 ? 0 : d, l, c])
        }
    }
    pairs = arraySort(pairs, function(a, b) { return a[0] != b[0] ? a[0] - b[0] : (a[1] != b[1] ? a[1] - b[1] : a[2] - b[2]) })
    var usedL = [:]; var usedC = [:]
    for (var p in pairs) {
        if (usedL[p[1]] != null || usedC[p[2]] != null) { continue }
        usedL[p[1]] = p[2]; usedC[p[2]] = p[1]
    }
    return usedL[me()]
}

// Stage for next turn's solve: get within teleport + walk reach of a revive cell of my
// crystal (walk, then jump closer), else the old spark-range staging.
function approach() {
    var c = myCrystal()
    if (c == null) { return }
    var t = nearestStand(c)
    if (t != null) {
        if (count(teleWalkOptions(c, getTotalMP())) > 0) { note('in reach ' + getName(c)); return }
        // crystal far from its axis: stage within spark range of the crystal instead
        var cc = getCell(c)
        var dest = (getCellDistance(getCell(), cc) > 9) ? cc : t
        var mp0 = getMP()
        if (dest == cc) { moveToward(c) } else { moveTowardCell(dest) }
        if (getMP() == mp0 && mp0 > 0) {
            // no path (walled area): walk to the reachable cell closest to it in straight line
            var rc = reachable(); var bc = getCell(); var bcd = getCellDistance(getCell(), dest)
            for (var cell : var st in rc) { var dd = getCellDistance(cell, dest); if (dd < bcd || (dd == bcd && st < rc[bc])) { bcd = dd; bc = cell } }
            if (bc != getCell()) { moveTowardCell(bc) }
        }
        if (has(CHIP_JUMP) && getCooldown(CHIP_JUMP) == 0 && getTP() >= getChipCost(CHIP_JUMP)) {
            var bj = null; var bjd = getCellDistance(getCell(), dest)
            var x = getCellX(getCell()); var y = getCellY(getCell())
            for (var dx = -3; dx <= 3; dx++) {
                for (var dy = -3 + abs(dx); dy <= 3 - abs(dx); dy++) {
                    var j = getCellFromXY(x + dx, y + dy)
                    if (j == null || isObstacle(j) || !isEmptyCell(j)) { continue }
                    var d = getCellDistance(j, dest)
                    if (d < bjd && canUseChipOnCell(CHIP_JUMP, j)) { bjd = d; bj = j }
                }
            }
            if (bj != null) { useChipOnCell(CHIP_JUMP, bj) }
        }
        note('stage ' + getName(c) + ' toward ' + (dest == cc ? 'crystal ' : 'stand ') + dest + ' now d=' + getCellDistance(getCell(), dest) + ' (walked ' + (mp0 - getMP()) + ')')
        return
    }
    note('no revive cell for ' + getName(c))
}

function puzzleTurn() {
    if (getTurn() <= 2) { note('tp=' + getTP() + ' res=' + has(CHIP_RESURRECTION) + '/' + getCooldown(CHIP_RESURRECTION) + ' tele=' + has(CHIP_TELEPORTATION) + ' spark=' + has(CHIP_SPARK) + ' tp=' + getTP() + ' mp=' + getMP() + ' at ' + getCell() + ' mine=' + myCrystal()) }
    saveDeadCrystals()
    if (getTurn() == 1) {
        castSelf(CHIP_MOTIVATION)
        castSelf(CHIP_LEATHER_BOOTS)
        if (!trySolveOne()) {
            castSelf(CHIP_ARMOR); castSelf(CHIP_WALL); castSelf(CHIP_SHIELD)
            approach()
        }
        selfStack()
        return
    }
    var solvedNow = trySolveOne()
    if (!solvedNow && ready(CHIP_RESURRECTION)) { approach() }
    sustain()
    // after my solve (or without one to do), stay out of the army's reach
    if (!ready(CHIP_RESURRECTION)) {
        var a = army()
        if (count(a) > 0 && getMP() > 0) { moveAwayFromEntities(a) }
    }
}

scan()
if (_combat) { combatTurn() } else { puzzleTurn() }
if (count(_log) > 0) { debug('BOSS T' + getTurn() + ' ' + getName(me()) + ': ' + join(_log, ' | ')) }
_log = []
